+
+STATIC_INLINE void
+h48_observe_survivor(dfsarg_solve_h48_t arg[NON_NULL], uint8_t remaining)
+{
+	/* Above base+3 the pipeline skipped its H48 lookups entirely. */
+	if (arg->survivor_observer == NULL || remaining < 10 || remaining > 12 ||
+	    remaining > arg->base + 3 || arg->lb_normal > remaining ||
+	    arg->lb_inverse > remaining || equal(arg->cube, SOLVED_CUBE) ||
+	    arg->solution_list->nsols >= arg->solution_settings->maxsolutions)
+		return;
+
+	arg->survivor_observer(arg->cube, remaining, arg->lb_normal,
+	    arg->lb_inverse, arg->survivor_observer_data);
 }
 
