 STATIC_INLINE void
+h48_face_cut(
+	dfsarg_solve_h48_t arg[NON_NULL],
+	h48_prune_t prune[SIZE(NMOVES)],
+	uint8_t bound,
+	uint8_t target,
+	uint8_t witness
+)
+{
+	uint8_t first, m;
+
+	/* The three children reached by turning one face are pairwise one
+	 * HTM move apart. A fresh bound >= target + 2 excludes that face.
+	 * The caller checks the stronger whole-parent BPMX cut first. */
+	if (!arg->bpmx_enabled || bound < (unsigned)target + 2U)
+		return;
+
+	arg->face_cuts++;
+	first = witness - witness % 3;
+	for (m = first; m < first + 3; m++)
+		prune[m].stop = 1;
+}
+
+STATIC_INLINE bool
+h48_bpmx_cut(
+	dfsarg_solve_h48_t arg[NON_NULL],
+	h48_prune_t prune[SIZE(NMOVES)],
+	uint8_t bound,
+	uint8_t target,
+	uint8_t witness
+)
+{
+	uint8_t m;
+
+	/* Parent remaining budget is target + 1.  One-step reverse
+	 * propagation gives parent lower bound >= bound - 1. */
+	if (!arg->bpmx_enabled || bound <= (unsigned)target + 2U)
+		return false;
+
+	arg->bpmx_cuts++;
+	prune[witness].stop = 1;
+	for (m = 0; m < NMOVES; m++)
+		if (!prune[m].stop)
+			arg->bpmx_skipped++;
+	return true;
+}
