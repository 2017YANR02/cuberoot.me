+STATIC_INLINE bool
+h48_prune_corners(dfsarg_solve_h48_t arg[NON_NULL], uint8_t remaining)
+{
+	uint64_t coord;
+	uint8_t bound;
+
+	if (arg->corners == NULL || remaining >= 11)
+		return false;
+
+	arg->corner_lookups++;
+	coord = coordinate_corners_coord(arg->cube, arg->corners->coord_data);
+	bound = get_coord_pval(&coordinate_corners, arg->corners->ptable, coord);
+	if (bound <= remaining)
+		return false;
+
+	arg->corner_prunes++;
+	return true;
