+/// Small immutable arithmetic lookup, compiled into the experimental binary.
+/// Valid states have four edges in each slice: 495 * 70 entries among 3^12.
+/// The packed value is (eslot << 7) | msplit; the h10 pruning table is unchanged.
+#[cfg(all(backend = "neon", target_feature = "dotprod"))]
+static EDGE_CLASS_COORDS: [u16; 531_441] = {
+    let mut result = [0; 531_441];
+    let mut e_mask = 0u32;
+    while e_mask < 4096 {
+        if e_mask.count_ones() == 4 {
+            let mut s_compact = 0u32;
+            while s_compact < 256 {
+                if s_compact.count_ones() == 4 {
+                    let (mut digit, mut weight, mut key, mut non_e_position) = (0, 1, 0, 0);
+                    while digit < 12 {
+                        let class = if e_mask >> digit & 1 != 0 { 2 } else {
+                            let value = s_compact >> non_e_position & 1;
+                            non_e_position += 1;
+                            value
+                        };
+                        key += class * weight;
+                        weight *= 3;
+                        digit += 1;
+                    }
+                    result[key as usize] = (crate::coord::ESLOT_CONST[e_mask as usize] << 7)
+                        | crate::coord::RANK8_CONST[s_compact as usize] as u16;
+                }
+                s_compact += 1;
+            }
+        }
+        e_mask += 1;
+    }
+    result
+};
