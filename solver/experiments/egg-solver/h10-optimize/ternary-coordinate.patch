+#[cfg(all(test, backend = "neon", target_feature = "dotprod"))]
+mod ternary_tests {
+    use super::*;
+    use crate::cubie::{CubieCube, Rng};
+
+    #[test]
+    fn every_slice_partition_matches_original_coordinate() {
+        let mut checked = 0;
+        for e in 0..4096u32 {
+            if e.count_ones() != 4 { continue; }
+            for s in 0..256u32 {
+                if s.count_ones() != 4 { continue; }
+                let mut bytes = [0u8; 16];
+                let mut p = 0;
+                for (i, byte) in bytes.iter_mut().take(12).enumerate() {
+                    let class = if e >> i & 1 != 0 { 2 } else { let v = s >> p & 1; p += 1; v };
+                    *byte = ((class << 6) | ((i as u32 & 1) << 4)) as u8;
+                }
+                let vector = V16::load(&bytes);
+                let packed = EDGE_CLASS_COORDS[vector.edge_class_key()];
+                assert_eq!((u64::from(packed & 127), (vector.bit_mask::<4>() & 0xFFF) << 16, u64::from(packed >> 7)), parts_from_masks(vector));
+                checked += 1;
+            }
+        }
+        assert_eq!(checked, 34_650);
+    }
+
+    #[test]
+    fn conjugated_random_cubes_match_original_coordinate() {
+        let mut rng = Rng(20261112);
+        for _ in 0..200 {
+            let cube = Cube::from_cubie(&CubieCube::random(&mut rng));
+            for sym in 0..48 {
+                let line = &HOT_TABLES.sym_edges[sym];
+                let classes = V16::load(&line.classes.0).lookup(pieces(cube.edges))
+                    .xor(cube.edges.xor(V16::load(&line.source_flips.0)));
+                let conj = classes.lookup(V16::load(&line.positions.0));
+                assert_eq!(edge_parts_sym_raw(cube, sym), parts_from_masks(conj));
+            }
+        }
+    }
+}
