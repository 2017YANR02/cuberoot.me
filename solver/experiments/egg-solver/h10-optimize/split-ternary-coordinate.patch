 use super::{pieces, Cube, HOT_TABLES, V16};
 
+/// Small immutable arithmetic lookup, compiled into the experimental binary.
+/// Six ternary digits become the E mask, compact S mask and non-E count.
+/// Only 1,458 bytes; the h10 pruning table is unchanged.
+#[cfg(all(backend = "neon", target_feature = "dotprod"))]
+static EDGE_CLASS_HALVES: [u16; 729] = {
+    let mut result = [0; 729];
+    let mut key = 0;
+    while key < 729 {
+        let (mut digits, mut i, mut e, mut s, mut non_e) = (key, 0, 0, 0, 0);
+        while i < 6 {
+            let class = digits % 3;
+            if class == 2 { e |= 1 << i; }
+            else { s |= class << non_e; non_e += 1; }
+            digits /= 3;
+            i += 1;
+        }
+        result[key] = (e | (s << 6) | (non_e << 12)) as u16;
+        key += 1;
+    }
+    result
+};
+
+#[cfg(all(backend = "neon", target_feature = "dotprod"))]
+#[inline(always)]
+fn parts_from_halves(conj: V16) -> (u64, u32, u64) {
+    let (low_key, high_key) = conj.edge_class_keys();
+    // SAFETY: six digits in 0..3 produce a key below 729. A legal cube has
+    // eight non-E edges in total, so the combined S mask is below 256.
+    unsafe {
+        let low = u32::from(*EDGE_CLASS_HALVES.get_unchecked(low_key));
+        let high = u32::from(*EDGE_CLASS_HALVES.get_unchecked(high_key));
+        let e = (low & 63) | ((high & 63) << 6);
+        let s = ((low >> 6) & 63) | (((high >> 6) & 63) << (low >> 12));
+        (u64::from(*HOT_TABLES.rank8.get_unchecked(s as usize)),
+            (conj.bit_mask::<4>() & 0xFFF) << 16,
+            u64::from(*HOT_TABLES.eslot_complement.get_unchecked((!e & 0xFFF) as usize)))
+    }
+}
