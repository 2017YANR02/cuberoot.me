+test("opening grip replays the entered scramble in every displayed basis", () => {
+  const scramble = "U2 F R' D B U R D' B2 D2 F2 U F2 R2 L D R2 D";
+  const original = stateAtFrame(buildColorTimeline(scramble, []), 0, true)!;
+  for (let basis = 0; basis < 24; basis++) {
