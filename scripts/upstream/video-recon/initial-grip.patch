+    if (basis === orientations.identity_index) assert.deepEqual(grip, []);
+  }
+  const view = rotateCubeView(CAMERA_ORIENTATION, camera, "x");
+  const grip = initialGripMoves([{ frame: 0, pose: pose() }], view);
+  assert.deepEqual(grip, ["x"]);
+  const moves = "D L' U2 x D2 U' L U' R2 L' R2 U' y R U' R' B S L U' L' S' U' B' U2 L' U' L U' L U2 L' U' L U L2 U' L U' L' U2 L U2 U".split(" ");
+  const solvedColors = initial.colors;
+  const replay = (prefix: readonly string[]) => [...prefix, ...moves].reduce((s, m) => applyCubeMove(s, m, []), original);
+  const isSolved = (state: CubeStateSnapshot) => solvedColors.every((color, i) =>
+    state.colors[i] === state.colors[solvedColors.indexOf(color)]);
+  assert.equal(isSolved(replay([])), false);
+  assert.equal(isSolved(replay(grip)), true);
+});
