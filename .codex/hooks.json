{
  "description": "Repository enforcement hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.claude/hooks/block-component-reimplementation.ps1\"",
            "commandWindows": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.claude/hooks/block-component-reimplementation.ps1\"",
            "timeout": 15,
            "statusMessage": "Checking shared component reuse"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.claude/hooks/recon-ground-truth-gate.ps1\"",
            "commandWindows": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.claude/hooks/recon-ground-truth-gate.ps1\"",
            "timeout": 15,
            "statusMessage": "Checking reconstruction ground truth"
          }
        ]
      }
    ]
  }
}
