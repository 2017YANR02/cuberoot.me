{
  "name": "cuberoot-toolkit",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "recon:capture": "tsx scripts/recon-capture.mts",
    "recon:capture:dev": "tsx scripts/recon-capture-dev.mts",
    "recon:intake": "tsx scripts/recon-intake.mts",
    "recon:intake:dev": "tsx apps/api/scripts/dev-recon-intake.ts",
    "prepare": "node scripts/recon-ground-truth-gate.mjs install",
    "setup:local": "pnpm --filter @cuberoot/client build:deps && node scripts/setup-local.ts",
    "audit:boundaries": "node scripts/check-architecture-boundaries.mjs",
    "solver:build-wasm": "tsx ../solver/scripts/build_wasm.mts",
    "solver:verify": "tsx ../solver/scripts/verify.mts",
    "solver:first-layer": "tsx ../solver/scripts/run_first_layer_gods_number.mts",
    "solver:lsll": "tsx ../solver/lsll/run_lsll.mts",
    "solver:lsll:update": "tsx ../solver/lsll/update_lsll.mts",
    "space:batch": "tsx ../design/space/scripts/batch.mts",
    "sor:update": "tsx apps/api/scripts/update_sor.mts",
    "upstream:sync": "tsx ../sync_upstream.ts",
    "music:prepare": "tsx ../scripts/music/prepare-music.ts",
    "music:publish": "tsx ../scripts/music/publish-music.ts",
    "stats:progress:sq1": "tsx ../scripts/progress/sq1-exact.ts",
    "stats:scramble": "tsx ../scripts/stats/update-published.ts --publish",
    "stats:scramble:local": "tsx ../scripts/stats/update-local.ts",
    "stats:scramble:publish": "tsx ../scripts/stats/update-published.ts",
    "build:cubing-worker": "node scripts/build-cubing-worker.mjs packages/client/public/cubing-chunks",
    "dev:next": "pnpm --filter @cuberoot/client dev",
    "dev:server": "turbo dev --filter=@cuberoot/server",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "android:release": "node scripts/android-release/release.ts",
    "android:release:test": "node --test scripts/android-release/*.test.ts",
    "stats:hydrate": "node ../scripts/wca-data/snapshot-cli.ts hydrate ../stats",
    "stats:publish": "node ../scripts/wca-data/snapshot-cli.ts submit"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "knip": "^6.21.0",
    "sharp": "0.35.5",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7"
  }
}
