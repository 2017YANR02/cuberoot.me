{
  "name": "cuberoot-toolkit",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "audit:boundaries": "node scripts/check-architecture-boundaries.mjs",
    "build:cubing-worker": "node scripts/build-cubing-worker.mjs packages/client/public/cubing-chunks",
    "dev:next": "turbo dev --filter=@cuberoot/client",
    "dev:server": "turbo dev --filter=@cuberoot/server",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "esbuild": "0.27.4",
    "knip": "^6.21.0",
    "sharp": "0.34.5",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0"
  }
}
