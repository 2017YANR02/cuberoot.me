# Server only. Copy to .env.apns.local (ignored), never to the mobile app.
# Checks are offline even when both gates are 1; they never start the API/worker.
RECORD_PUSH_ENABLED=0
APNS_ENABLED=0
APNS_TEAM_ID=
APNS_KEY_ID=
# Prefer an absolute path to an unencrypted APNs .p8, readable only by its owner.
# Relative paths resolve from the API working directory, not this env file.
APNS_PRIVATE_KEY_PATH=
