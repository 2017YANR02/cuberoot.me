{
  "name": "@cuberoot/miniprogram",
  "version": "0.1.0",
  "private": true,
  "cuberoot": {
    "kind": "app"
  },
  "type": "module",
  "dependencies": {
    "@cuberoot/shared": "workspace:*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:douyin": "node scripts/build.mjs --target=douyin",
    "check": "pnpm verify && node scripts/build.mjs",
    "check:all": "pnpm verify && node scripts/build.mjs && node scripts/build.mjs --target=douyin",
    "check:douyin": "pnpm verify && node scripts/build.mjs --target=douyin",
    "dev": "node scripts/build.mjs --watch",
    "dev:douyin": "node scripts/build.mjs --target=douyin --watch",
    "release:check": "pnpm verify && node scripts/build.mjs && node scripts/release-check.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.4",
    "lucide-static": "1.8.0",
    "miniprogram-api-typings": "^5.2.3",
    "sharp": "0.34.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.6",
    "wx-to-tt": "0.3.0-beta.3"
  }
}
