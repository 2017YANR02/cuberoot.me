.smart-cube-page {
  padding-top: 52rpx;
}

.smart-cube-page .page-title {
  margin-top: 0;
}

.connection-status {
  border-bottom: 1rpx solid var(--cr-line);
  margin-top: 72rpx;
  padding-bottom: 36rpx;
}

.connection-note,
.connection-detail {
  color: var(--cr-muted);
  display: block;
  font-size: 24rpx;
}

.connection-value {
  display: block;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.4;
  margin-top: 10rpx;
  overflow-wrap: anywhere;
}

.connection-value--ready {
  color: var(--cr-ready);
}

.connection-value--error {
  color: var(--cr-danger);
}

.connection-detail {
  white-space: nowrap;
}

.connection-note {
  margin-top: 16rpx;
}

.device-picker {
  margin-top: 32rpx;
}

.device-picker .section-title {
  color: var(--cr-muted);
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.device-option {
  align-items: center;
  background: var(--cr-surface);
  border: 1rpx solid var(--cr-line);
  border-radius: 16rpx;
  box-sizing: border-box;
  color: var(--cr-text);
  display: flex;
  gap: 24rpx;
  justify-content: space-between;
  line-height: 1.4;
  margin-top: 12rpx;
  min-height: 112rpx;
  padding: 24rpx;
  text-align: left;
  width: 100%;
}

.device-option-main {
  flex: 1;
  min-width: 0;
}

.device-name,
.device-driver {
  display: block;
}

.device-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.device-driver {
  color: var(--cr-muted);
  font-size: 24rpx;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.device-option-chevron {
  border-right: 3rpx solid var(--cr-muted);
  border-top: 3rpx solid var(--cr-muted);
  flex: none;
  height: 12rpx;
  margin-right: 4rpx;
  transform: rotate(45deg);
  width: 12rpx;
}

.connection-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 28rpx;
  margin-top: 18rpx;
}

.simulator-panel,
.connected-actions,
.retry-action {
  margin-top: 44rpx;
}

.section-title {
  display: block;
  font-weight: 650;
}

.move-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 20rpx;
}

.move-button {
  border: 1rpx solid var(--cr-line);
  border-radius: 18rpx;
  font-family: ui-monospace, "SFMono-Regular", monospace;
  min-height: 72rpx;
}

.connected-actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 28rpx;
}
