.smart-cube-page {
  padding-top: 52rpx;
}

.connection-status {
  border-bottom: 1rpx solid var(--cr-line);
  margin-top: 72rpx;
  padding-bottom: 36rpx;
}

.connection-note,
.connection-detail {
  color: var(--cr-muted);
  display: block;
  font-size: 24rpx;
}

.connection-value {
  display: block;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.4;
  margin-top: 10rpx;
  overflow-wrap: anywhere;
}

.connection-value--ready {
  color: var(--cr-ready);
}

.connection-value--error {
  color: var(--cr-danger);
}

.connection-detail {
  white-space: nowrap;
}

.connection-note {
  margin-top: 16rpx;
}

.connection-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 28rpx;
  margin-top: 18rpx;
}

.simulator-panel,
.connected-actions,
.retry-action {
  margin-top: 44rpx;
}

.section-title {
  display: block;
  font-weight: 650;
}

.move-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 20rpx;
}

.move-button {
  border: 1rpx solid var(--cr-line);
  border-radius: 18rpx;
  font-family: ui-monospace, "SFMono-Regular", monospace;
  min-height: 72rpx;
}

.connected-actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 28rpx;
}
