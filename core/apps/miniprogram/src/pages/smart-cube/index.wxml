<view class="page smart-cube-page">
  <text class="eyebrow">{{copy.eyebrow}}</text>
  <text class="page-title">{{copy.title}}</text>

  <view class="connection-status">
    <text wx:if="{{phase === 'idle'}}" class="connection-value">{{copy.preparing}}</text>
    <text wx:elif="{{phase === 'scanning'}}" class="connection-value">{{copy.searching}}</text>
    <text wx:elif="{{phase === 'connecting'}}" class="connection-value">{{copy.connecting}} {{deviceName || copy.smartCube}}…</text>
    <text wx:elif="{{phase === 'connected'}}" class="connection-value connection-value--ready">{{copy.connected}} {{deviceName}}</text>
    <text wx:elif="{{phase === 'disconnected'}}" class="connection-value">{{deviceName || copy.disconnected}}</text>
    <text wx:else class="connection-value connection-value--error">{{error || copy.failed}}</text>
    <text wx:if="{{phase === 'scanning'}}" class="connection-note">{{copy.wakeCube}}</text>
    <view wx:if="{{phase === 'connected'}}" class="connection-metrics">
      <text wx:if="{{battery !== null}}" class="connection-detail">{{copy.battery}} {{battery}}%</text>
      <text wx:if="{{lastMove}}" class="connection-detail">{{copy.latestMove}} {{lastMove}}</text>
    </view>
  </view>

  <view wx:if="{{phase === 'error' || phase === 'disconnected'}}" class="retry-action">
    <button class="primary-button" hover-class="press-feedback" bindtap="retryConnection">{{copy.retry}}</button>
  </view>

  <view wx:if="{{phase === 'connected' && brand === 'simulator'}}" class="simulator-panel">
    <text class="section-title">{{copy.simulatorMoves}}</text>
    <view class="move-grid">
      <button wx:for="{{simulatorMoves}}" wx:key="*this" class="move-button" hover-class="press-feedback" data-move="{{item}}" bindtap="simulateMove">{{item}}</button>
    </view>
  </view>

  <view wx:if="{{phase === 'connected'}}" class="connected-actions">
    <button class="primary-button" hover-class="press-feedback" bindtap="returnToTimer">{{copy.returnToTimer}}</button>
    <button class="text-button" hover-class="press-feedback" bindtap="disconnectCube">{{copy.disconnect}}</button>
  </view>

</view>
