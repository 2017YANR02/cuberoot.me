.link-page { background: var(--cr-bg); color: var(--cr-text); }
.link-note { display: block; margin: 24rpx 0; line-height: 1.6; color: var(--cr-muted); }
.link-input { border-bottom: 1rpx solid var(--cr-line); min-height: 88rpx; margin: 24rpx 0; }
.link-action { margin: 24rpx 0; text-align: left; }
.link-code { display: block; font-size: 64rpx; font-variant-numeric: tabular-nums; letter-spacing: .15em; margin: 32rpx 0; }
.link-error { display: block; color: var(--cr-danger); margin-top: 24rpx; }
