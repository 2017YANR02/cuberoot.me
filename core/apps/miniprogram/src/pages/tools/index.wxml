<view class="page tools-page">
  <text class="eyebrow">CUBEROOT</text>
  <text class="page-title">魔方工具</text>
  <text class="page-intro">网站首页的公开入口都收在这里。常用能力优先使用小程序原生页面，其余内容直接打开 CubeRoot 网站。</text>

  <view class="tool-search">
    <input
      class="tool-search-input"
      value="{{query}}"
      placeholder="搜索工具、内容或路径"
      confirm-type="search"
      bindinput="handleSearchInput"
      aria-label="搜索魔方工具"
    />
    <button
      class="tool-search-clear"
      wx:if="{{query}}"
      bindtap="clearSearch"
      hover-class="press-feedback"
      aria-label="清空搜索"
    >清除</button>
  </view>

  <text class="tool-count" wx:if="{{query}}">找到 {{resultCount}} 项</text>
  <text class="tool-count" wx:else>共 {{totalCount}} 项，与网站首页共用同一份目录</text>

  <view
    class="tool-group"
    wx:for="{{groups}}"
    wx:for-item="group"
    wx:key="id"
  >
    <text class="tool-group-eyebrow">{{group.eyebrow}}</text>
    <text class="tool-group-title">{{group.title}}</text>
    <text class="tool-group-description">{{group.description}}</text>

    <view class="tool-list">
      <button
        class="tool-row"
        wx:for="{{group.tools}}"
        wx:for-item="tool"
        wx:key="id"
        data-id="{{tool.id}}"
        bindtap="openTool"
        disabled="{{tool.disabled}}"
        hover-class="press-feedback"
        aria-label="{{tool.title}}，{{tool.actionLabel}}"
      >
        <view class="tool-copy">
          <text class="tool-name">{{tool.title}}</text>
          <text class="tool-name-en">{{tool.titleEn}}</text>
        </view>
        <text class="tool-action">{{tool.actionLabel}}</text>
        <text class="tool-arrow" wx:if="{{!tool.disabled &amp;&amp; tool.action !== 'copy'}}" aria-hidden="true">›</text>
      </button>
    </view>
  </view>

  <view class="tool-empty" wx:if="{{query &amp;&amp; resultCount === 0}}">
    <text class="tool-empty-title">没有找到匹配内容</text>
    <text class="tool-empty-copy">可以换一个名称、英文词或网址路径试试。</text>
  </view>

  <text
    class="status-text tools-status {{statusTone === 'error' ? 'status-text--error' : 'tools-status--ready'}}"
    wx:if="{{status}}"
    aria-role="status"
    aria-live="polite"
    aria-atomic="true"
  >{{status}}</text>
</view>
