.delete-page { color: var(--cr-text); background: var(--cr-bg); }
.delete-copy { display: block; margin-bottom: 24rpx; line-height: 1.65; }
.delete-handle { display: block; overflow-wrap: anywhere; }
.delete-input-row { display: flex; align-items: center; gap: 16rpx; border-bottom: 1rpx solid var(--cr-line); margin: 24rpx 0; }
.delete-input-row input { flex: 1; min-width: 0; min-height: 88rpx; }
.delete-submit { margin-top: 32rpx; }
.delete-error { display: block; margin-top: 24rpx; color: var(--cr-danger); }
