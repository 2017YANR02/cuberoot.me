@import "../../templates/native-contact.wxss";
/* Native scroll-view owns scrolling; the outer page is disabled in index.json. */
.account-scroll {
  height: 100vh;
  width: 100%;
  position: relative;
  z-index: 1;
}

.account-login-page,
.account-user-page {
  padding-top: 72rpx;
}

.account-entry-page {
  align-items: center;
  display: flex;
  justify-content: center;
}

.account-entry-copy,
.account-note,
.account-user-meta {
  color: var(--cr-muted);
  display: block;
  overflow-wrap: anywhere;
}

.account-entry-copy {
  font-size: 28rpx;
  line-height: 1.65;
  text-align: center;
}

.account-primary-button {
  margin-top: 64rpx;
  box-sizing: border-box;
  width: 100%;
}

.account-name-edit { margin-top: 24rpx; }
.account-identities { margin-top: 24rpx; display: flex; flex-direction: column; gap: 20rpx; }
.account-identity { display: flex; flex-direction: column; gap: 8rpx; overflow-wrap: anywhere; }
.account-name-actions { display: flex; justify-content: flex-end; gap: 24rpx; margin-top: 24rpx; }
.account-name-actions button { margin: 0; }

.account-link-actions {
  display: flex;
  flex-direction: column;
}

.account-create-button {
  margin-top: 24rpx;
}

.account-link-code-row {
  align-items: center;
  border-bottom: 1px solid var(--cr-line);
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  padding: 20rpx 0;
}

.account-link-website-button {
  margin-top: 40rpx;
}

.account-link-code-prompt {
  color: var(--cr-muted);
  display: block;
  font-size: 25rpx;
  line-height: 1.5;
  margin-top: 40rpx;
}

.account-link-continue-button {
  margin-top: 32rpx;
}

.account-link-code-input {
  flex: 1;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  min-width: 0;
}

.account-policy {
  margin-top: 24rpx;
}

.account-policy-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.account-policy-link {
  flex: none;
}

.account-consent-toggle {
  margin-top: 8rpx;
}

.account-note {
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 28rpx;
}

.account-user-meta {
  font-size: 28rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}

.account-release {
  margin-top: 64rpx;
}

.account-release-version {
  align-items: baseline;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.account-release-label,
.account-release-channel {
  color: var(--cr-muted);
  font-size: 23rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.account-release-value {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 25rpx;
  font-weight: 680;
  line-height: 1.4;
  white-space: nowrap;
}

.account-release-channel {
  color: var(--cr-faint);
}

.account-release-title {
  display: block;
  font-size: 32rpx;
  font-weight: 680;
  line-height: 1.35;
  margin-top: 30rpx;
}

.account-release-notes {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.account-release-note {
  align-items: flex-start;
  color: var(--cr-muted);
  display: flex;
  font-size: 25rpx;
  gap: 16rpx;
  line-height: 1.55;
}

.account-release-dot {
  background: var(--cr-accent);
  border-radius: 50%;
  flex: none;
  height: 7rpx;
  margin-top: 0.62em;
  width: 7rpx;
}

.account-native .page {
  margin: 0 auto;
  max-width: 512px;
  padding: 18px 16px calc(24px + env(safe-area-inset-bottom));
}

.account-native .page-title {
  font-size: 42rpx;
  margin-top: 0;
  overflow-wrap: anywhere;
}

.account-native .account-login-page > .account-primary-button,
.account-native .account-link-actions > .account-primary-button {
  border-radius: 20rpx;
  margin-top: 32rpx;
}

.account-native .account-policy-links .account-policy-link,
.account-native .account-consent-toggle {
  padding-inline: 0;
}

.account-profile {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 0 18px;
}

.account-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: var(--cr-surface);
  color: var(--cr-muted);
  font-size: 19px;
  font-weight: 650;
}

.account-profile-details { min-width: 0; overflow-wrap: anywhere; }
.account-profile-name { font-size: 16px; font-weight: 650; }

.account-home-row,
.account-language {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 48px;
  padding: 8px 4px;
  border-bottom: 1px solid var(--cr-line);
  color: var(--cr-text);
  font-size: 16px;
  text-align: left;
}

.account-home-row > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.account-home-row[disabled] { opacity: 0.55; }
.account-icon { flex: none; width: 19px; height: 19px; }
.account-home-row > .account-icon:last-child { width: 16px; height: 16px; opacity: 0.7; }
.account-guest-actions { margin-top: 14px; }
.account-detail-header { display: flex; align-items: center; gap: 8px; margin-bottom: 18px; }
.account-detail-header > .page-title { font-size: 21px; }
.account-back { display: flex; align-items: center; justify-content: center; flex: 0 0 44px; height: 44px; margin-left: -8px; }
.account-language { justify-content: space-between; }
.account-language > text:last-child { color: var(--cr-muted); }

.account-native .account-user-meta {
  font-size: 25rpx;
  margin-top: 8rpx;
}

.account-native .account-security {
  display: flex;
  flex-direction: column;
}

.account-native .account-security-row {
  border-bottom: 1px solid var(--cr-line);
  color: var(--cr-text);
  font-size: 28rpx;
  justify-content: flex-start;
  margin: 0;
  min-height: 92rpx;
  padding: 0;
  text-align: left;
  width: 100%;
}

.account-native .account-security-row--danger { color: var(--cr-danger); }

.account-native .account-identities {
  background: var(--cr-surface);
  border-radius: 16rpx;
  margin: 12rpx 0;
  padding: 16rpx 24rpx;
}

.account-native .account-release { margin-top: 40rpx; }

.account-native .account-choice-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.account-native .account-choice-actions > .account-primary-button { grid-column: 1 / -1; }
.account-native .account-choice-actions > .account-create-button {
  margin: 0;
  padding: 12rpx 8rpx;
  line-height: 1.35;
}
