.account-page {
  padding-top: 48rpx;
}

.account-intro {
  max-width: 620rpx;
}

.login-button {
  display: inline-flex;
  margin-top: 58rpx;
  min-width: 260rpx;
}

.union-note {
  color: var(--cr-muted);
  display: block;
  font-size: 23rpx;
  line-height: 1.65;
  margin-top: 28rpx;
  max-width: 620rpx;
  overflow-wrap: anywhere;
}

.identity {
  align-items: center;
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.identity-copy {
  min-width: 0;
}

.identity-mark {
  align-items: center;
  background: var(--cr-accent-soft);
  border-radius: 50%;
  color: var(--cr-accent);
  display: flex;
  flex: none;
  font-size: 36rpx;
  font-weight: 720;
  height: 92rpx;
  justify-content: center;
  width: 92rpx;
}

.identity-name,
.identity-wca {
  display: block;
}

.identity-name {
  font-size: 36rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.identity-wca {
  color: var(--cr-muted);
  font-size: 24rpx;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
}

.account-link {
  align-items: center;
  border-bottom: 1rpx solid var(--cr-line);
  display: flex;
  gap: 16rpx;
  margin-top: 44rpx;
  min-height: 92rpx;
  text-align: left;
  width: 100%;
}

.account-link-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.4;
  min-width: 0;
  overflow-wrap: anywhere;
}

.account-link-arrow {
  color: var(--cr-faint);
  flex: none;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.account-contact {
  margin-top: 42rpx;
}

.account-contact-title,
.account-contact-copy {
  display: block;
}

.account-contact-title {
  font-size: 30rpx;
  font-weight: 680;
}

.account-contact-copy {
  color: var(--cr-muted);
  font-size: 25rpx;
  line-height: 1.5;
  margin-top: 10rpx;
}

.account-contact-site {
  align-items: center;
  border-bottom: 1rpx solid var(--cr-line);
  display: flex;
  font-size: 27rpx;
  font-weight: 620;
  gap: 16rpx;
  margin-top: 14rpx;
  min-height: 88rpx;
  text-align: left;
  width: 100%;
}

.account-contact-site > text:first-child {
  flex: 1;
}

.account-contact-qr {
  display: block;
  margin-top: 28rpx;
  width: 460rpx;
}

.account-utility-row {
  align-items: center;
  display: grid;
  gap: 24rpx;
  grid-auto-columns: max-content;
  grid-auto-flow: column;
  justify-content: start;
  margin-top: 18rpx;
  overflow-x: auto;
}

.account-utility-action {
  margin: 0;
  min-height: 68rpx;
  padding: 0;
  white-space: nowrap;
  width: auto;
}

.account-utility-status {
  color: var(--cr-muted);
  font-size: 25rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.account-action-status {
  margin-top: 8rpx;
}

.sync-retry-button {
  margin-top: 4rpx;
}
