.account-login-page,
.account-user-page {
  padding-top: 72rpx;
}

.account-entry-page {
  align-items: center;
  display: flex;
  justify-content: center;
}

.account-entry-copy,
.account-note,
.account-user-meta {
  color: var(--cr-muted);
  display: block;
  overflow-wrap: anywhere;
}

.account-entry-copy {
  font-size: 28rpx;
  line-height: 1.65;
  text-align: center;
}

.account-primary-button {
  margin-top: 64rpx;
  width: 100%;
}

.account-link-actions {
  display: flex;
  flex-direction: column;
}

.account-create-button {
  margin-top: 24rpx;
}

.account-policy {
  margin-top: 24rpx;
}

.account-policy-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.account-policy-link {
  flex: none;
}

.account-consent-toggle {
  margin-top: 8rpx;
}

.account-note {
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 28rpx;
}

.account-user-meta {
  font-size: 28rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}

.account-release {
  margin-top: 64rpx;
}

.account-release-version {
  align-items: baseline;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.account-release-label,
.account-release-channel {
  color: var(--cr-muted);
  font-size: 23rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.account-release-value {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 25rpx;
  font-weight: 680;
  line-height: 1.4;
  white-space: nowrap;
}

.account-release-channel {
  color: var(--cr-faint);
}

.account-release-title {
  display: block;
  font-size: 32rpx;
  font-weight: 680;
  line-height: 1.35;
  margin-top: 30rpx;
}

.account-release-notes {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.account-release-note {
  align-items: flex-start;
  color: var(--cr-muted);
  display: flex;
  font-size: 25rpx;
  gap: 16rpx;
  line-height: 1.55;
}

.account-release-dot {
  background: var(--cr-accent);
  border-radius: 50%;
  flex: none;
  height: 7rpx;
  margin-top: 0.62em;
  width: 7rpx;
}

.account-contact {
  margin-top: 76rpx;
}

.account-contact-header {
  display: flex;
  flex-direction: column;
}

.account-contact-title {
  display: block;
  font-size: 44rpx;
  font-weight: 720;
  letter-spacing: -0.025em;
  line-height: 1.2;
  margin-top: 10rpx;
}

.contact-profile {
  align-items: center;
  display: flex;
  flex-direction: column;
  margin-top: 48rpx;
  text-align: center;
}

.contact-site-button {
  align-items: center;
  display: inline-flex;
  gap: 14rpx;
  width: auto;
}

.contact-site-label {
  color: var(--cr-muted);
  font-size: 24rpx;
}

.contact-site-value {
  color: var(--cr-accent);
  font-size: 27rpx;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.contact-details-columns {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 42rpx;
  text-align: left;
  width: 100%;
}

.contact-details {
  align-items: center;
  display: grid;
  font-size: 26rpx;
  gap: 14rpx 24rpx;
  grid-template-columns: max-content minmax(0, 1fr);
}

.contact-details-row {
  display: contents;
}

.contact-label-button,
.contact-row-label {
  align-items: center;
  color: var(--cr-muted);
  display: inline-flex;
  font-weight: 550;
  gap: 14rpx;
  line-height: 1.5;
  white-space: nowrap;
  width: max-content;
}

.contact-details-icon {
  flex: none;
  height: 32rpx;
  width: 32rpx;
}

.contact-row-value {
  align-items: center;
  display: inline-flex;
  gap: 12rpx;
  line-height: 1.5;
  min-width: 0;
  overflow-wrap: anywhere;
}

.contact-platform-value > text {
  flex: none;
  white-space: nowrap;
}

.contact-row-meta {
  color: var(--cr-faint);
  font-size: 22rpx;
  font-weight: 500;
}

.contact-detail-value {
  justify-self: start;
  word-break: break-all;
}

.contact-detail-section-start {
  margin-top: 39rpx;
}

.contact-value-button {
  flex: none;
  line-height: 1.5;
  max-width: 100%;
  overflow-wrap: anywhere;
  text-align: left;
  white-space: nowrap;
  width: auto;
}

.contact-qr-button {
  display: inline-flex;
  flex: none;
  width: auto;
}

.contact-join {
  border-left: 6rpx solid var(--cr-accent);
  margin-top: 72rpx;
  padding-left: 28rpx;
}

.contact-join-title {
  display: block;
  font-size: 24rpx;
  font-weight: 680;
  letter-spacing: 0.08em;
  line-height: 1.3;
}

.contact-join-copy {
  display: flex;
  flex-wrap: wrap;
  font-size: 32rpx;
  line-height: 1.65;
  margin-top: 12rpx;
  overflow-wrap: anywhere;
}

.contact-join-value {
  color: var(--cr-accent);
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.contact-directory {
  margin-top: 84rpx;
}

.contact-directory-section {
  border-top: 1rpx solid var(--cr-line);
  padding: 60rpx 0 68rpx;
}

.contact-directory-heading {
  align-items: flex-start;
  display: flex;
  gap: 20rpx;
}

.contact-directory-index {
  color: var(--cr-accent);
  flex: none;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  padding-top: 8rpx;
}

.contact-directory-heading-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.contact-directory-section-title {
  font-size: 40rpx;
  font-weight: 680;
  line-height: 1.2;
}

.contact-directory-description {
  color: var(--cr-muted);
  font-size: 27rpx;
  line-height: 1.65;
  margin-top: 18rpx;
  overflow-wrap: anywhere;
}

.contact-directory-block {
  margin-top: 52rpx;
}

.contact-directory-block-title {
  color: var(--cr-muted);
  display: block;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 0.06em;
  line-height: 1.4;
}

.contact-group-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 36rpx;
  margin-top: 26rpx;
}

.contact-group-item {
  align-items: flex-start;
  display: inline-flex;
  gap: 16rpx;
  max-width: 100%;
}

.contact-group-dot {
  background: var(--cr-accent);
  border-radius: 50%;
  flex: none;
  height: 8rpx;
  margin-top: 0.58em;
  width: 8rpx;
}

.contact-group-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.contact-group-name {
  font-size: 29rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.contact-group-secondary {
  color: var(--cr-faint);
  font-size: 22rpx;
  line-height: 1.45;
  white-space: nowrap;
}
