.account-login-page,
.account-user-page {
  padding-top: 72rpx;
}

.account-entry-page {
  align-items: center;
  display: flex;
  justify-content: center;
}

.account-entry-copy,
.account-note,
.account-user-meta {
  color: var(--cr-muted);
  display: block;
  overflow-wrap: anywhere;
}

.account-entry-copy {
  font-size: 28rpx;
  line-height: 1.65;
  text-align: center;
}

.account-primary-button {
  margin-top: 64rpx;
  width: 100%;
}

.account-policy {
  margin-top: 24rpx;
}

.account-policy-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.account-policy-link {
  flex: none;
}

.account-consent-toggle,
.account-logout-button {
  margin-top: 8rpx;
}

.account-note {
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 28rpx;
}

.account-user-meta {
  font-size: 28rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}
