@import "../../templates/native-contact.wxss";
/* Native scroll-view owns scrolling; the outer page is disabled in index.json. */
.account-scroll {
  height: 100vh;
  width: 100%;
  position: relative;
  z-index: 1;
}

.account-login-page,
.account-user-page {
  padding-top: 72rpx;
}

.account-entry-page {
  align-items: center;
  display: flex;
  justify-content: center;
}

.account-entry-copy,
.account-note,
.account-user-meta {
  color: var(--cr-muted);
  display: block;
  overflow-wrap: anywhere;
}

.account-entry-copy {
  font-size: 28rpx;
  line-height: 1.65;
  text-align: center;
}

.account-primary-button {
  margin-top: 64rpx;
  box-sizing: border-box;
  width: 100%;
}

.account-name-edit { margin-top: 24rpx; }
.account-identities { margin-top: 24rpx; display: flex; flex-direction: column; gap: 20rpx; }
.account-identity { display: flex; flex-direction: column; gap: 8rpx; overflow-wrap: anywhere; }
.account-name-actions { display: flex; justify-content: flex-end; gap: 24rpx; margin-top: 24rpx; }
.account-name-actions button { margin: 0; }

.account-link-actions {
  display: flex;
  flex-direction: column;
}

.account-create-button {
  margin-top: 24rpx;
}

.account-link-code-row {
  align-items: center;
  border-bottom: 1px solid var(--cr-line);
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  padding: 20rpx 0;
}

.account-link-website-button {
  margin-top: 40rpx;
}

.account-link-code-prompt {
  color: var(--cr-muted);
  display: block;
  font-size: 25rpx;
  line-height: 1.5;
  margin-top: 40rpx;
}

.account-link-continue-button {
  margin-top: 32rpx;
}

.account-link-code-input {
  flex: 1;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  min-width: 0;
}

.account-policy {
  margin-top: 24rpx;
}

.account-policy-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.account-policy-link {
  flex: none;
}

.account-consent-toggle {
  margin-top: 8rpx;
}

.account-note {
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 28rpx;
}

.account-user-meta {
  font-size: 28rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}

.account-release {
  margin-top: 64rpx;
}

.account-release-version {
  align-items: baseline;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.account-release-label,
.account-release-channel {
  color: var(--cr-muted);
  font-size: 23rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.account-release-value {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 25rpx;
  font-weight: 680;
  line-height: 1.4;
  white-space: nowrap;
}

.account-release-channel {
  color: var(--cr-faint);
}

.account-release-title {
  display: block;
  font-size: 32rpx;
  font-weight: 680;
  line-height: 1.35;
  margin-top: 30rpx;
}

.account-release-notes {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.account-release-note {
  align-items: flex-start;
  color: var(--cr-muted);
  display: flex;
  font-size: 25rpx;
  gap: 16rpx;
  line-height: 1.55;
}

.account-release-dot {
  background: var(--cr-accent);
  border-radius: 50%;
  flex: none;
  height: 7rpx;
  margin-top: 0.62em;
  width: 7rpx;
}

.account-native .page {
  margin: 0 auto;
  max-width: 640px;
  padding-top: 32rpx;
}

.account-native .page-title {
  font-size: 42rpx;
  margin-top: 0;
  overflow-wrap: anywhere;
}

.account-native .account-login-page > .account-primary-button,
.account-native .account-link-actions > .account-primary-button {
  border-radius: 20rpx;
  margin-top: 32rpx;
}

.account-native .account-policy-links .account-policy-link,
.account-native .account-consent-toggle {
  padding-inline: 0;
}

.account-section-tabs {
  background: var(--cr-surface);
  border: 1px solid var(--cr-line);
  border-radius: 24rpx;
  display: flex;
  gap: 8rpx;
  margin-bottom: 44rpx;
  padding: 8rpx;
}

.account-section-tab {
  border-radius: 16rpx;
  color: var(--cr-muted);
  flex: 1;
  font-size: 28rpx;
  min-height: 84rpx;
  min-width: 0;
  padding: 8rpx;
}

.account-section-tab--active {
  background: var(--cr-accent-soft);
  color: var(--cr-accent);
  font-weight: 650;
}

.account-native .account-profile {
  align-items: center;
  display: flex;
  gap: 24rpx;
}

.account-profile-initial {
  align-items: center;
  background: var(--cr-accent-soft);
  border-radius: 50%;
  color: var(--cr-accent);
  display: flex;
  flex: none;
  font-size: 38rpx;
  font-weight: 650;
  height: 104rpx;
  justify-content: center;
  width: 104rpx;
}

.account-profile-details { min-width: 0; }
.account-profile-wca { display: block; }

.account-native .account-user-meta {
  font-size: 25rpx;
  margin-top: 8rpx;
}

.account-native .account-security {
  display: flex;
  flex-direction: column;
}

.account-native .account-security-row {
  border-bottom: 1px solid var(--cr-line);
  color: var(--cr-text);
  font-size: 28rpx;
  justify-content: flex-start;
  margin: 0;
  min-height: 92rpx;
  padding: 0;
  text-align: left;
  width: 100%;
}

.account-native .account-security-row--danger { color: var(--cr-danger); }

.account-native .account-identities {
  background: var(--cr-surface);
  border-radius: 16rpx;
  margin: 12rpx 0;
  padding: 16rpx 24rpx;
}

.account-native .account-release { margin-top: 40rpx; }
