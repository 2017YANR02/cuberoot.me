<import src="../../templates/web-route-view.wxml" />
<view wx:if="{{loginRequired}}" class="page account-login-page">
  <text class="eyebrow">ACCOUNT</text>
  <text class="page-title">我的</text>
  <text class="page-intro">
    登录后使用与网站相同的 CubeRoot 账号。已在网站通过微信登录过时，会自动识别为同一账号。
  </text>
  <button
    wx:if="{{!loginStorageUnavailable}}"
    class="primary-button account-login-button"
    aria-busy="{{loginBusy}}"
    aria-label="{{loginBusy ? '微信登录处理中' : '微信登录'}}"
    disabled="{{loginBusy}}"
    hover-class="press-feedback"
    bindtap="loginWithWechat"
  >
    {{loginBusy ? '正在登录' : '微信登录'}}
  </button>
  <button
    wx:else
    class="primary-button account-login-button"
    aria-label="重新读取设备登录状态"
    hover-class="press-feedback"
    bindtap="retryMiniProgramSession"
  >
    重新读取
  </button>
  <text
    wx:if="{{loginError}}"
    class="status-text status-text--error"
    aria-role="status"
    aria-live="polite"
    aria-atomic="true"
  >{{loginError}}</text>
  <text class="account-login-note">
    不会读取微信昵称或手机号。无法获得 UnionID 时会停止登录，避免创建重复账号。
  </text>
</view>
<template
  wx:else
  is="web-route-view"
  data="{{src: src, viewAttempt: viewAttempt, loadingTitle: loadingTitle, errorTitle: errorTitle, errorMessage: errorMessage, canRetry: canRetry}}"
/>
