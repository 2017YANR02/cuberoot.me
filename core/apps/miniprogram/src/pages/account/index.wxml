<page-meta page-style="{{appearanceStyle}}" />
<import src="../../templates/native-appearance.wxml" />
<template is="native-scenery" wx:if="{{!isTimelineEntry}}" />
<scroll-view class="account-scroll" scroll-y="{{true}}" scroll-x="{{false}}" enhanced="{{true}}" show-scrollbar="{{false}}">
<view wx:if="{{isTimelineEntry}}" class="page account-entry-page">
  <text class="account-entry-copy" aria-role="status">{{copy.entryCopy}}</text>
</view>

<view wx:elif="{{loginRequired}}" class="page account-login-page">
  <text class="eyebrow">{{copy.accountEyebrow}}</text>
  <text class="page-title">{{wechatPhoneRequired ? copy.phoneTitle : accountLinkCodeMode ? copy.linkExistingAccountLabel : phoneAccountFound ? copy.phoneFoundTitle : accountLinkRequired ? copy.accountChoiceTitle : copy.pageTitle}}</text>
  <text class="page-intro">{{wechatPhoneRequired ? copy.phoneHint : accountLinkCodeMode ? copy.linkCodeHint : phoneAccountFound ? copy.phoneFoundHint : accountLinkRequired ? copy.accountChoiceNote : loginIntro}}</text>
  <view wx:if="{{requiresAgreement}}" class="account-policy">
    <view class="account-policy-links">
      <button
        class="text-button account-policy-link"
        hover-class="press-feedback"
        bindtap="openPolicy"
      >{{copy.userAgreementLabel}}</button>
      <button
        class="text-button account-policy-link"
        hover-class="press-feedback"
        bindtap="openPolicy"
      >{{copy.privacyLabel}}</button>
    </view>
    <button
      class="text-button account-consent-toggle"
      aria-label="{{copy.agreementLabel}}"
      aria-pressed="{{agreementAccepted}}"
      hover-class="press-feedback"
      bindtap="toggleAgreement"
    >{{agreementAccepted ? '✓' : '○'}} {{copy.agreementLabel}}</button>
  </view>
  <view wx:if="{{wechatPhoneRequired && !loginStorageUnavailable}}" class="account-link-actions">
    <button wx:if="{{wechatPhoneSupported}}" class="primary-button account-primary-button" open-type="getRealtimePhoneNumber" bindtap="beginPhoneAuthorization" bindgetrealtimephonenumber="authorizePhone" disabled="{{loginBusy}}" aria-busy="{{loginBusy}}" hover-class="press-feedback">{{loginBusy ? copy.signingInLabel : copy.phoneAuthorize}}</button>
    <button class="text-button account-create-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="linkExistingAccount">{{copy.phoneOtherLogin}}</button>
    <button class="text-button account-create-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="openPolicy">{{copy.privacyLabel}}</button>
    <button class="text-button account-create-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="cancelIdentityChoice">{{copy.cancelLabel}}</button>
  </view>
  <button
    wx:elif="{{!loginStorageUnavailable && !accountLinkRequired}}"
    class="primary-button account-primary-button"
    aria-busy="{{loginBusy}}"
    aria-label="{{loginBusy ? loginButtonBusyLabel : loginButtonLabel}}"
    disabled="{{loginBusy || (requiresAgreement && !agreementAccepted)}}"
    hover-class="press-feedback"
    bindtap="loginWithMiniProgram"
  >
    {{loginBusy ? copy.signingInLabel : loginButtonLabel}}
  </button>
  <view wx:elif="{{accountLinkRequired && !loginStorageUnavailable}}" class="account-link-actions">
    <block wx:if="{{phoneAccountFound && !accountLinkCodeMode}}">
      <text class="account-user-meta">{{accountLinkTargetName}} · CubeRoot ID {{accountLinkTargetId}}</text>
      <button class="primary-button account-primary-button" disabled="{{loginBusy}}" aria-busy="{{loginBusy}}" hover-class="press-feedback" bindtap="confirmPhoneAccount">{{loginBusy ? copy.signingInLabel : copy.confirmLinkCodeLabel}}</button>
    </block>
    <block wx:elif="{{accountLinkCodeMode}}">
      <block wx:if="{{accountLinkTargetId}}">
        <text class="account-user-meta">{{copy.loginAsLabel}}{{accountLinkTargetName}}</text>
        <button class="primary-button account-primary-button" disabled="{{loginBusy || (requiresAgreement && !agreementAccepted)}}" aria-busy="{{loginBusy}}" hover-class="press-feedback" bindtap="confirmLinkCode">{{loginBusy ? copy.signingInLabel : copy.confirmLinkCodeLabel}}</button>
        <button class="text-button account-create-button" aria-label="{{copy.clearCodeLabel}}" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="clearLinkCode">{{copy.clearCodeLabel}}</button>
      </block>
      <block wx:else>
        <button class="primary-button account-primary-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="openEmailLinkCode">{{copy.emailLinkCodeLabel}}</button>
        <button wx:if="{{!requiresAgreement}}" class="text-button account-create-button account-link-website-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="openLinkCodeWebsite">{{copy.openLinkCodeWebsiteLabel}}</button>
        <text class="account-link-code-prompt">{{copy.linkCodeReadyHint}}</text>
        <view class="account-link-code-row">
          <input class="account-link-code-input" value="{{accountLinkCode}}" type="number" placeholder="{{copy.linkCodeLabel}}" aria-label="{{copy.linkCodeLabel}}" maxlength="6" disabled="{{loginBusy}}" bindinput="onLinkCodeInput" />
          <button wx:if="{{accountLinkCode}}" class="text-button" aria-label="{{copy.clearCodeLabel}}" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="clearLinkCode">×</button>
        </view>
        <button class="primary-button account-primary-button account-link-continue-button" disabled="{{loginBusy || !accountLinkCode}}" aria-busy="{{loginBusy}}" hover-class="press-feedback" bindtap="previewLinkCode">{{copy.previewLinkCodeLabel}}</button>
      </block>
    </block>
    <button wx:else
      class="primary-button account-primary-button"
      aria-label="{{copy.linkExistingAccountLabel}}"
      disabled="{{loginBusy || (requiresAgreement && !agreementAccepted)}}"
      hover-class="press-feedback"
      bindtap="linkExistingAccount"
    >{{copy.linkExistingAccountLabel}}</button>
    <button
      wx:if="{{accountCanCreate && !accountLinkCodeMode && !phoneAccountFound && !existingOnly}}"
      class="text-button account-create-button"
      aria-label="{{copy.createAccountLabel}}"
      disabled="{{loginBusy || (requiresAgreement && !agreementAccepted)}}"
      hover-class="press-feedback"
      bindtap="createAccount"
    >{{copy.createAccountLabel}}</button>
    <button class="text-button account-create-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="cancelIdentityChoice">{{copy.cancelLabel}}</button>
  </view>
  <button
    wx:elif="{{loginStorageUnavailable}}"
    class="primary-button account-primary-button"
    aria-label="{{copy.retrySessionAria}}"
    hover-class="press-feedback"
    bindtap="retryMiniProgramSession"
  >
    {{copy.retrySessionLabel}}
  </button>
  <text
    wx:if="{{loginError}}"
    class="status-text status-text--error"
    aria-role="status"
    aria-live="polite"
    aria-atomic="true"
  >{{loginError}}</text>
  <text class="account-note">{{loginNote}}</text>
</view>

<view wx:else class="page account-user-page">
  <text class="eyebrow">{{copy.accountEyebrow}}</text>
  <text class="page-title">{{displayName}}</text>
  <text wx:if="{{uidText}}" class="account-user-meta">CubeRoot ID {{uidText}}</text>
  <view wx:if="{{editingName}}" class="account-name-editor">
    <view class="account-link-code-row">
      <input class="account-link-code-input" value="{{nameDraft}}" maxlength="100" aria-label="{{copy.editName}}" disabled="{{nameBusy}}" bindinput="inputDisplayName" />
      <button hover-class="press-feedback" wx:if="{{nameDraft}}" class="text-button" aria-label="{{copy.clearName}}" disabled="{{nameBusy}}" bindtap="clearDisplayName">×</button>
    </view>
    <view class="account-name-actions">
      <button hover-class="press-feedback" class="text-button" disabled="{{nameBusy}}" bindtap="cancelDisplayName">{{copy.cancelLabel}}</button>
      <button hover-class="press-feedback" class="primary-button" disabled="{{nameBusy || !nameDraft}}" loading="{{nameBusy}}" bindtap="saveDisplayName">{{copy.saveName}}</button>
    </view>
  </view>
  <button hover-class="press-feedback" wx:elif="{{!wcaId}}" class="text-button account-name-edit" bindtap="editDisplayName">{{copy.editName}}</button>
  <button hover-class="press-feedback" class="text-button account-name-edit" loading="{{identitiesBusy}}" aria-expanded="{{identitiesOpen}}" bindtap="toggleIdentities">{{copy.identities}}</button>
  <view wx:if="{{identitiesOpen}}" class="account-identities">
    <view wx:for="{{identityRows}}" wx:key="key" class="account-identity">
      <text>{{item.label}}</text>
      <text wx:if="{{item.handle}}" class="account-user-meta" selectable="{{true}}">{{item.handle}}</text>
      <button hover-class="press-feedback" class="text-button" data-index="{{index}}" disabled="{{identityMutationBusy || nameBusy}}" bindtap="unlinkIdentity">{{copy.unlink}}</button>
    </view>
    <text wx:if="{{hasPassword}}" class="account-user-meta">{{copy.password}}</text>
    <text wx:if="{{!identitiesBusy && !identitiesError && !identityRows.length && !hasPassword}}" class="account-user-meta">{{copy.identitiesEmpty}}</text>
    <view wx:if="{{identitiesError}}">
      <text class="status-text status-text--error" aria-role="status">{{identitiesError}}</text>
      <button hover-class="press-feedback" class="text-button" bindtap="loadIdentities">{{copy.identitiesRetry}}</button>
    </view>
  </view>
  <text wx:if="{{wcaLinkPending}}" class="status-text" aria-role="status" aria-live="polite">{{copy.wcaLinkHint}}</text>
  <button
    class="primary-button account-primary-button"
    aria-label="{{copy.accountButtonAria}}"
    hover-class="press-feedback"
    bindtap="openAccount"
  >
    {{copy.accountButtonLabel}}
  </button>
  <button hover-class="press-feedback" class="text-button account-name-edit" disabled="{{identityMutationBusy || nameBusy}}" bindtap="signOut">{{copy.signOut}}</button>
  <button hover-class="press-feedback" wx:if="{{!requiresAgreement}}" class="text-button account-name-edit" disabled="{{identityMutationBusy || nameBusy}}" bindtap="openSecuritySettings">{{copy.securitySettings}}</button>
  <button hover-class="press-feedback" class="text-button account-name-edit" disabled="{{identityMutationBusy || nameBusy}}" bindtap="openDeleteAccount">{{copy.deleteAccount}}</button>
  <text
    wx:if="{{accountError}}"
    class="status-text status-text--error"
    aria-role="status"
    aria-live="polite"
    aria-atomic="true"
  >{{accountError}}</text>
  <view class="account-release">
    <view class="account-release-version">
      <text class="account-release-label">{{release.versionLabel}}</text>
      <text class="account-release-value">{{release.version}}</text>
      <text wx:if="{{release.channel}}" class="account-release-channel">{{release.channel}}</text>
    </view>
    <text class="account-release-title">{{release.notesTitle}}</text>
    <view class="account-release-notes">
      <view
        wx:for="{{release.notes}}"
        wx:key="*this"
        class="account-release-note"
      >
        <view class="account-release-dot" />
        <text>{{item}}</text>
      </view>
    </view>
  </view>
  <include src="../../templates/native-contact.wxml" />
</view>
</scroll-view>
