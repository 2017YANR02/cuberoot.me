<page-meta page-style="{{appearanceStyle}}" />
<import src="../../templates/native-appearance.wxml" />
<template name="account-icon">
  <image class="account-icon" src="/assets/tabbar/{{icon}}-{{scheme}}.png" aria-hidden="true" />
</template>
<template name="account-home-row">
  <button class="account-home-row" hover-class="press-feedback" data-section="{{section}}" bindtap="selectAccountSection">
    <template is="account-icon" data="{{icon: icon, scheme: scheme}}" />
    <text>{{label}}</text>
    <template is="account-icon" data="{{icon: 'chevron-right', scheme: scheme}}" />
  </button>
</template>
<template name="account-profile">
  <view class="account-profile">
    <image wx:if="{{avatarUrl}}" class="account-avatar" src="{{avatarUrl}}" mode="aspectFill" aria-hidden="true" binderror="hideUnavailableAvatar" />
    <text wx:else class="account-avatar" aria-hidden="true">{{profileInitial}}</text>
    <view class="account-profile-details">
      <text class="account-profile-name">{{displayName}}</text>
      <text wx:if="{{uidText || wcaId}}" class="account-user-meta">{{wcaId || ('ID ' + uidText)}}</text>
    </view>
  </view>
</template>
<view class="native-tab-surface account-native" style="{{appearanceStyle}}">
<template is="native-scenery" wx:if="{{!isTimelineEntry}}" />
<scroll-view class="account-scroll" scroll-y="{{true}}" scroll-x="{{false}}" enhanced="{{true}}" show-scrollbar="{{false}}" scroll-into-view="{{'account-' + accountSection}}">
<view id="account-{{accountSection}}" />
<view wx:if="{{isTimelineEntry}}" class="page account-entry-page">
  <text class="account-entry-copy" aria-role="status">{{copy.entryCopy}}</text>
</view>

<view wx:elif="{{loginRequired && accountSection !== 'settings'}}" class="page account-login-page">
  <text class="page-title">{{wechatPhoneRequired ? copy.phoneTitle : accountLinkCodeMode ? copy.linkExistingAccountLabel : phoneAccountFound ? copy.phoneFoundTitle : accountLinkRequired ? copy.accountChoiceTitle : copy.pageTitle}}</text>
  <text class="page-intro">{{wechatPhoneRequired ? copy.phoneHint : accountLinkCodeMode ? copy.linkCodeHint : phoneAccountFound ? copy.phoneFoundHint : accountLinkRequired ? copy.accountChoiceNote : loginIntro}}</text>
  <view wx:if="{{requiresAgreement}}" class="account-policy">
    <view class="account-policy-links">
      <button
        class="text-button account-policy-link"
        hover-class="press-feedback"
        bindtap="openPolicy"
      >{{copy.userAgreementLabel}}</button>
      <button
        class="text-button account-policy-link"
        hover-class="press-feedback"
        bindtap="openPolicy"
      >{{copy.privacyLabel}}</button>
    </view>
    <button
      class="text-button account-consent-toggle"
      aria-label="{{copy.agreementLabel}}"
      aria-pressed="{{agreementAccepted}}"
      hover-class="press-feedback"
      bindtap="toggleAgreement"
    >{{agreementAccepted ? '✓' : '○'}} {{copy.agreementLabel}}</button>
  </view>
  <view wx:if="{{wechatPhoneRequired && !loginStorageUnavailable}}" class="account-link-actions">
    <button wx:if="{{wechatPhoneSupported}}" class="primary-button account-primary-button" open-type="getRealtimePhoneNumber" bindtap="beginPhoneAuthorization" bindgetrealtimephonenumber="authorizePhone" disabled="{{loginBusy}}" aria-busy="{{loginBusy}}" hover-class="press-feedback">{{loginBusy ? copy.signingInLabel : copy.phoneAuthorize}}</button>
    <button class="text-button account-create-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="linkExistingAccount">{{copy.phoneOtherLogin}}</button>
    <button class="text-button account-create-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="openPolicy">{{copy.privacyLabel}}</button>
    <button class="text-button account-create-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="cancelIdentityChoice">{{copy.cancelLabel}}</button>
  </view>
  <button
    wx:elif="{{!loginStorageUnavailable && !accountLinkRequired}}"
    class="primary-button account-primary-button"
    aria-busy="{{loginBusy}}"
    aria-label="{{loginBusy ? loginButtonBusyLabel : loginButtonLabel}}"
    disabled="{{loginBusy || (requiresAgreement && !agreementAccepted)}}"
    hover-class="press-feedback"
    bindtap="loginWithMiniProgram"
  >
    {{loginBusy ? copy.signingInLabel : loginButtonLabel}}
  </button>
  <view wx:elif="{{accountLinkRequired && !loginStorageUnavailable}}" class="account-link-actions{{!accountLinkCodeMode && !phoneAccountFound && accountCanCreate && !existingOnly ? ' account-choice-actions' : ''}}">
    <block wx:if="{{phoneAccountFound && !accountLinkCodeMode}}">
      <text class="account-user-meta">{{accountLinkTargetName}} · CubeRoot ID {{accountLinkTargetId}}</text>
      <button class="primary-button account-primary-button" disabled="{{loginBusy}}" aria-busy="{{loginBusy}}" hover-class="press-feedback" bindtap="confirmPhoneAccount">{{loginBusy ? copy.signingInLabel : copy.confirmLinkCodeLabel}}</button>
    </block>
    <block wx:elif="{{accountLinkCodeMode}}">
      <block wx:if="{{accountLinkTargetId}}">
        <text class="account-user-meta">{{copy.loginAsLabel}}{{accountLinkTargetName}}</text>
        <button class="primary-button account-primary-button" disabled="{{loginBusy || (requiresAgreement && !agreementAccepted)}}" aria-busy="{{loginBusy}}" hover-class="press-feedback" bindtap="confirmLinkCode">{{loginBusy ? copy.signingInLabel : copy.confirmLinkCodeLabel}}</button>
        <button class="text-button account-create-button" aria-label="{{copy.clearCodeLabel}}" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="clearLinkCode">{{copy.clearCodeLabel}}</button>
      </block>
      <block wx:else>
        <button class="primary-button account-primary-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="openEmailLinkCode">{{copy.emailLinkCodeLabel}}</button>
        <button wx:if="{{!requiresAgreement}}" class="text-button account-create-button account-link-website-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="openLinkCodeWebsite">{{copy.openLinkCodeWebsiteLabel}}</button>
        <text class="account-link-code-prompt">{{copy.linkCodeReadyHint}}</text>
        <view class="account-link-code-row">
          <input class="account-link-code-input" value="{{accountLinkCode}}" type="number" placeholder="{{copy.linkCodeLabel}}" aria-label="{{copy.linkCodeLabel}}" maxlength="6" disabled="{{loginBusy}}" bindinput="onLinkCodeInput" />
          <button wx:if="{{accountLinkCode}}" class="text-button" aria-label="{{copy.clearCodeLabel}}" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="clearLinkCode">×</button>
        </view>
        <button class="primary-button account-primary-button account-link-continue-button" disabled="{{loginBusy || !accountLinkCode}}" aria-busy="{{loginBusy}}" hover-class="press-feedback" bindtap="previewLinkCode">{{copy.previewLinkCodeLabel}}</button>
      </block>
    </block>
    <button wx:else
      class="primary-button account-primary-button"
      aria-label="{{copy.linkExistingAccountLabel}}"
      disabled="{{loginBusy || (requiresAgreement && !agreementAccepted)}}"
      hover-class="press-feedback"
      bindtap="linkExistingAccount"
    >{{copy.linkExistingAccountLabel}}</button>
    <button
      wx:if="{{accountCanCreate && !accountLinkCodeMode && !phoneAccountFound && !existingOnly}}"
      class="text-button account-create-button"
      aria-label="{{copy.createAccountLabel}}"
      disabled="{{loginBusy || (requiresAgreement && !agreementAccepted)}}"
      hover-class="press-feedback"
      bindtap="createAccount"
    >{{copy.createAccountLabel}}</button>
    <button class="text-button account-create-button" disabled="{{loginBusy}}" hover-class="press-feedback" bindtap="cancelIdentityChoice">{{copy.cancelLabel}}</button>
  </view>
  <button
    wx:elif="{{loginStorageUnavailable}}"
    class="primary-button account-primary-button"
    aria-label="{{copy.retrySessionAria}}"
    hover-class="press-feedback"
    bindtap="retryMiniProgramSession"
  >
    {{copy.retrySessionLabel}}
  </button>
  <text
    wx:if="{{loginError}}"
    class="status-text status-text--error"
    aria-role="status"
    aria-live="polite"
    aria-atomic="true"
  >{{loginError}}</text>
  <text wx:if="{{!accountLinkRequired && !loginStorageUnavailable}}" class="account-note">{{loginNote}}</text>
  <view wx:if="{{!loginBusy && !accountLinkRequired && !wechatPhoneRequired && !browserLoginPending}}" class="account-guest-actions">
    <template is="account-home-row" data="{{section: 'settings', icon: 'settings', label: copy.settingsLabel, scheme: appearanceScheme}}" />
  </view>
</view>

<view wx:else class="page account-user-page">
  <block wx:if="{{accountSection === 'home'}}">
    <template is="account-profile" data="{{avatarUrl: avatarUrl, profileInitial: profileInitial, displayName: displayName, uidText: uidText, wcaId: wcaId}}" />
    <template is="account-home-row" data="{{section: 'space', icon: 'user-round', label: copy.spaceLabel, scheme: appearanceScheme}}" />
    <template is="account-home-row" data="{{section: 'security', icon: 'shield', label: copy.securityLabel, scheme: appearanceScheme}}" />
    <template is="account-home-row" data="{{section: 'settings', icon: 'settings', label: copy.settingsLabel, scheme: appearanceScheme}}" />
    <button class="account-home-row" hover-class="press-feedback" disabled="{{identityMutationBusy || nameBusy}}" bindtap="signOut">
      <template is="account-icon" data="{{icon: 'log-out', scheme: appearanceScheme}}" />
      <text>{{copy.signOut}}</text>
      <template is="account-icon" data="{{icon: 'chevron-right', scheme: appearanceScheme}}" />
    </button>
  </block>
  <view wx:else class="account-detail-header">
    <button class="account-back" hover-class="press-feedback" aria-label="{{copy.backLabel}}" data-section="home" bindtap="selectAccountSection">
      <template is="account-icon" data="{{icon: accountSection === 'settings' ? 'arrow-left' : 'chevron-left', scheme: appearanceScheme}}" />
    </button>
    <text class="page-title">{{accountSection === 'space' ? copy.spaceLabel : accountSection === 'security' ? copy.securityLabel : copy.appearanceLabel}}</text>
  </view>
  <block wx:if="{{accountSection === 'space'}}">
    <template is="account-profile" data="{{avatarUrl: avatarUrl, profileInitial: profileInitial, displayName: displayName, uidText: uidText, wcaId: wcaId}}" />
    <view wx:if="{{editingName}}" class="account-name-editor">
      <view class="account-link-code-row">
        <input class="account-link-code-input" value="{{nameDraft}}" maxlength="100" aria-label="{{copy.editName}}" disabled="{{nameBusy}}" bindinput="inputDisplayName" />
        <button hover-class="press-feedback" wx:if="{{nameDraft}}" class="text-button" aria-label="{{copy.clearName}}" disabled="{{nameBusy}}" bindtap="clearDisplayName">×</button>
      </view>
      <view class="account-name-actions">
        <button hover-class="press-feedback" class="text-button" disabled="{{nameBusy}}" bindtap="cancelDisplayName">{{copy.cancelLabel}}</button>
        <button hover-class="press-feedback" class="primary-button" disabled="{{nameBusy || !nameDraft}}" loading="{{nameBusy}}" bindtap="saveDisplayName">{{copy.saveName}}</button>
      </view>
    </view>
    <button hover-class="press-feedback" wx:elif="{{!wcaId}}" class="text-button account-name-edit" bindtap="editDisplayName">{{copy.editName}}</button>
    <button wx:if="{{hasWebsiteAccount}}" class="text-button account-security-row" hover-class="press-feedback" bindtap="openAccount">{{copy.accountButtonLabel}}</button>
    <button wx:if="{{copy.payouts}}" class="text-button account-security-row" hover-class="press-feedback" bindtap="openPayouts">{{copy.payouts}}</button>
  </block>
  <view wx:if="{{accountSection === 'security'}}" class="account-security">
    <button hover-class="press-feedback" class="text-button account-name-edit account-security-row" loading="{{identitiesBusy}}" aria-expanded="{{identitiesOpen}}" bindtap="toggleIdentities">{{copy.identities}}</button>
    <view wx:if="{{identitiesOpen}}" class="account-identities">
      <view wx:for="{{identityRows}}" wx:key="key" class="account-identity">
        <text>{{item.label}}</text>
        <text wx:if="{{item.handle}}" class="account-user-meta" selectable="{{true}}">{{item.handle}}</text>
        <button hover-class="press-feedback" class="text-button" data-index="{{index}}" disabled="{{identityMutationBusy || nameBusy}}" bindtap="unlinkIdentity">{{copy.unlink}}</button>
      </view>
      <text wx:if="{{hasPassword}}" class="account-user-meta">{{copy.password}}</text>
      <text wx:if="{{!identitiesBusy && !identitiesError && !identityRows.length && !hasPassword}}" class="account-user-meta">{{copy.identitiesEmpty}}</text>
      <view wx:if="{{identitiesError}}">
        <text class="status-text status-text--error" aria-role="status">{{identitiesError}}</text>
        <button hover-class="press-feedback" class="text-button" bindtap="loadIdentities">{{copy.identitiesRetry}}</button>
      </view>
    </view>
    <button hover-class="press-feedback" class="text-button account-security-row" disabled="{{identityMutationBusy || nameBusy}}" bindtap="openSecuritySettings">{{copy.securitySettings}}</button>
    <button hover-class="press-feedback" class="text-button account-name-edit account-security-row account-security-row--danger" disabled="{{identityMutationBusy || nameBusy}}" bindtap="openDeleteAccount">{{copy.deleteAccount}}</button>
  </view>
  <text wx:if="{{wcaLinkPending}}" class="status-text" aria-role="status" aria-live="polite">{{copy.wcaLinkHint}}</text>
  <text
    wx:if="{{accountError}}"
    class="status-text status-text--error"
    aria-role="status"
    aria-live="polite"
    aria-atomic="true"
  >{{accountError}}</text>
  <block wx:if="{{accountSection === 'settings' && appearanceSettings}}">
    <view class="account-appearance-row">
      <text>{{copy.languageLabel}}</text>
      <picker range="{{appearanceSettings.list.locale}}" range-key="label" value="{{appearanceSettings.localeIndex}}" data-field="locale" bindchange="changeAppearanceOption" aria-label="{{copy.languageLabel}}">
        <view class="account-appearance-control">{{appearanceSettings.list.locale[appearanceSettings.localeIndex].label}}</view>
      </picker>
    </view>
    <view class="account-appearance-row">
      <text>{{copy.appearanceLabel}}</text>
      <picker range="{{appearanceSettings.list.theme}}" range-key="label" value="{{appearanceSettings.themeIndex}}" data-field="theme" bindchange="changeAppearanceOption" aria-label="{{copy.appearanceLabel}}">
        <view class="account-appearance-control">
          <template wx:if="{{appearanceSettings.theme.icon}}" is="account-icon" data="{{icon: appearanceSettings.theme.icon, scheme: appearanceScheme}}" />
          <view wx:else class="account-appearance-swatch" style="background:{{appearanceSettings.theme.swatch}}" />
          <text>{{appearanceSettings.theme.label}}</text>
        </view>
      </picker>
    </view>
    <view class="account-appearance-row">
      <text>{{copy.accentLabel}}</text>
      <view class="account-appearance-choices">
        <picker range="{{appearanceSettings.list.accent}}" range-key="label" value="{{appearanceSettings.accentIndex}}" data-field="accent" bindchange="changeAppearanceOption" aria-label="{{copy.accentLabel}}">
          <view class="account-appearance-control">
            <view class="account-appearance-swatch" style="background:{{appearanceSettings.accent.swatch}}" />
            <text>{{appearanceSettings.accent.label}}</text>
          </view>
        </picker>
        <input wx:if="{{appearanceSettings.custom}}" class="account-appearance-control account-appearance-hex" value="{{appearanceSettings.hex}}" maxlength="7" aria-label="{{copy.hexLabel}}" bindblur="changeAppearanceHex" />
      </view>
    </view>
    <view class="account-appearance-row">
      <text>{{copy.backdropLabel}}</text>
      <picker range="{{appearanceSettings.list.backdrop}}" range-key="label" value="{{appearanceSettings.backdropIndex}}" data-field="backdrop" bindchange="changeAppearanceOption" aria-label="{{copy.backdropLabel}}">
        <view class="account-appearance-control">{{appearanceSettings.list.backdrop[appearanceSettings.backdropIndex].label}}</view>
      </picker>
    </view>
    <view class="account-appearance-row account-appearance-row--last">
      <text>{{copy.contrastLabel}}</text>
      <switch checked="{{appearanceSettings.contrast}}" aria-label="{{copy.contrastLabel}}" bindchange="changeAppearanceContrast" />
    </view>
    <view wx:if="{{appearanceSettings.scenes.length}}" class="account-appearance-scenes">
      <button wx:for="{{appearanceSettings.scenes}}" wx:key="id" class="account-appearance-scene" data-id="{{item.id}}" aria-pressed="{{item.selected}}" hover-class="press-feedback" bindtap="changeAppearanceBackground">
        <image src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
        <text>{{item.label}}</text>
        <template wx:if="{{item.selected}}" is="account-icon" data="{{icon: 'check', scheme: appearanceScheme}}" />
      </button>
    </view>
  </block>
</view>
</scroll-view>
</view>
