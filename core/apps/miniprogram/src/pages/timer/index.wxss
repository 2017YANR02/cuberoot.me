.nt-training-attempt { font: 11px/1.2 'LiberationMono', monospace; }
.nt-training-attempt--pending, .nt-training-attempt--dns, .nt-training-attempt--ineligible { color: var(--cr-faint); }
.nt-training-attempt--ineligible { opacity: .55; text-decoration: line-through; }
.nt-training-attempt--over, .nt-target-overshot .nt-time { color: var(--cr-danger); }
.nt-training-reset { color: var(--cr-text); }
.nt-attempt-splits { display: flex; flex-wrap: nowrap; justify-content: center; gap: 8px; min-height: 44px; margin: 12px 0 0; overflow-x: auto; }
.nt-attempt-split {
  min-width: 56px; margin: 0; padding: 4px 10px; border: 1px solid var(--cr-line);
  border-radius: 999px; background: var(--cr-surface); color: var(--cr-muted); text-align: center;
