.nt-live-analysis-line { display: block; width: 100%; box-sizing: border-box; margin: 0 0 6px; padding: 0; color: var(--cr-text); text-align: left; overflow-wrap: anywhere; font: 13px/1.7 'LiberationMono', monospace; }
.nt-live-analysis-body { width: 100%; text-align: left; }
.nt-live-analysis-group { margin-top: 12px; }
.nt-live-analysis-comment { display: inline; margin-left: 6px; color: var(--cr-muted); font: 12px/1.4 'LiberationMono', monospace; }
.nt-live-analysis-chip { display: inline-flex; width: 20px; height: 13px; gap: 1px; overflow: hidden; border: 1px solid var(--cr-line); border-radius: 3px; background: var(--cr-line); }
.nt-live-analysis-chip > view { flex: 1; }
.nt-live-analysis-actions { display: flex; gap: 6px; }
.nt-live-analysis-actions > button { display: flex; align-items: center; justify-content: center; min-height: 32px; min-width: 32px; margin: 0; padding: 0 5px; color: var(--cr-muted); }
.nt-live-analysis-toggle { border: 1px solid var(--cr-line); border-radius: 4px; }
.nt-live-analysis-toggle.is-selected { border-color: color-mix(in srgb, var(--cr-accent) 55%, transparent); background: color-mix(in srgb, var(--cr-accent) 8%, transparent); }
@media (max-width: 480px) {
  .nt-live-analysis-line { font-size: 12px; }
