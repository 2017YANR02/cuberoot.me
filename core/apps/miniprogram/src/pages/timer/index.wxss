.nt-room-lobby { align-self: center; display: flex; flex-direction: column; gap: 16rpx; width: min(100%, 560rpx); margin-block: 32rpx; text-align: center; }
.nt-room-input { box-sizing: border-box; background: var(--cr-surface); border: 1rpx solid var(--cr-line); border-radius: 12rpx; min-height: 72rpx; padding-inline: 18rpx; }
