.nt-solo-scramble .nt-scramble {
  --nt-scramble-base: calc(clamp(var(--solo-scramble-font-min, 16px), 4vw, var(--solo-scramble-font-max, 28px)) * var(--nt-scramble-scale, 1));
  width: 100%; min-height: 0; padding: 0;
  font-family: 'LiberationMono', 'Courier New', monospace;
  font-size: min(var(--nt-scramble-base), max(14px, calc(var(--nt-scramble-base) * var(--nt-scramble-length, 1))));
  line-height: clamp(1.25, calc(1.5 * var(--nt-scramble-length, 1)), 1.5);
  word-spacing: clamp(.1em, calc(var(--solo-scramble-spacing, .25em) * var(--nt-scramble-length, 1)), var(--solo-scramble-spacing, .25em));
}
.nt-solo-stage--compact .nt-scramble { --nt-scramble-base: calc(clamp(16px, 2.8vw, 20px) * var(--nt-scramble-scale, 1)); }
.nt-solo-scramble .nt-scramble--compact { line-height: 1.25; }
.nt-solo-scramble .nt-scramble-font--mono, .nt-time-font--mono { font-family: ui-monospace, monospace; }
.nt-solo-scramble .nt-scramble-font--sans, .nt-time-font--sans { font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
.nt-time-font--liberation { font-family: 'LiberationMono', 'Courier New', monospace; }
.nt-time-font--mono, .nt-time-font--liberation { font-weight: 600; }
.nt-solo-scramble .nt-source { display: flex; justify-content: center; align-items: center; min-height: var(--solo-source-control-height, 44px); line-height: 1.3; }
.nt-solo-stage > .nt-clock-region { flex: 0 0 auto; margin-top: var(--nt-solo-timer-gap, 20px); }
.nt-solo-stage .nt-clock, .nt-solo-below .nt-previews { flex: none; min-height: 0; padding: 0; }
.nt-solo-stage .nt-clock:not(.nt-manual-entry) { height: var(--nt-solo-readout-size, 48px); }
.nt-solo-stage .nt-time { letter-spacing: .02em; }
.nt-solo-below .nt-preview { width: 100%; max-width: 80%; }

/* Keep the clock on the stage axis while scramble lines or training details change. */
.nt-solo-stage--anchored {
  display: grid;
  flex: 1 1 0;
  min-height: 0;
  grid-template-rows: minmax(0, 1fr) auto minmax(0, 1fr);
}
.nt-solo-stage--anchored > .nt-clock-region,
.nt-solo-stage--anchored > .nt-solo-below { min-width: 0; }
.nt-solo-stage--anchored > .nt-clock-region { margin-top: 0; }
.nt-solo-stage--anchored .nt-solo-scramble,
.nt-solo-stage--anchored .nt-solo-below { min-height: 0; overflow-y: auto; }
.nt-solo-stage--anchored .nt-solo-scramble {
  display: flex;
  flex-direction: column;
  padding-bottom: var(--nt-solo-timer-gap, 20px);
}
.nt-solo-stage--anchored .nt-solo-scramble-content { flex: none; margin-top: auto; }
.nt-solo-chrome-hidden { visibility: hidden; pointer-events: none; }
.nt-live-workspace { display: flex; flex: 1 1 0; min-height: 0; flex-direction: column; min-width: 0; }
.nt-live-workspace--active { flex: 1 0 auto; }
.nt-live-stage { box-sizing: border-box; width: min(100%, 36rem); min-height: 4.5em; margin: 12px auto 0; padding: 0 12px; text-align: center; }
