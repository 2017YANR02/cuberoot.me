.nt-live-stage-moves { color: var(--cr-text); overflow-wrap: anywhere; font: clamp(16px, 2vw, 22px)/1.5 'LiberationMono', monospace; }
.nt-live-analysis { box-sizing: border-box; min-width: 0; padding: 12px 16px; }
