/* The host's reported window height can be slightly smaller than its WebView. */
.native-timer--solo { min-height: 0; height: calc(100vh - 50px - env(safe-area-inset-bottom)); padding: 0; overflow-y: auto; }
.native-timer--solo .nt-toolbar { flex: 0 0 auto; width: calc(100% - 8px); max-width: 420px; min-height: 56px; align-items: center; }
.native-timer--solo .nt-tool { min-height: 44px; height: 44px; font-size: 13px; font-weight: 400; }
.native-timer--solo .nt-tool .nt-icon { width: 18px; height: 18px; }
.nt-solo-stage {
  box-sizing: border-box;
  display: flex;
  flex: 1 0 auto;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding: 0 var(--solo-stage-inline, 16px) var(--solo-stage-bottom, 16px);
}
