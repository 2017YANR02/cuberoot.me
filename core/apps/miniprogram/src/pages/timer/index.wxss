}
@media (min-width: 1024px), (min-width: 800px) and (min-height: 500px) and (orientation: landscape) {
  .nt-live-workspace--active { display: grid; grid-template-columns: minmax(0, 1fr) minmax(340px, 30%); }
  .nt-live-workspace--active .nt-live-analysis { border-left: 1px solid var(--cr-line); }
}
.nt-solo-footer { display: flex; flex: 0 0 auto; align-items: flex-end; justify-content: space-between; gap: 12px; padding: var(--solo-stat-rail-top-bottom, 10px) var(--solo-stat-rail-inline, 12px); }
.nt-solo-footer .nt-stats { flex-shrink: 0; align-items: flex-start; gap: 1px; width: auto; padding: 4px 8px; border-radius: 10px; }
.nt-solo-footer--tight { padding-block: 4px; }
.nt-solo-footer:not(.nt-solo-footer--horizontal) .nt-stats { flex-direction: column; }
.nt-solo-footer--horizontal .nt-stats { flex-direction: row; flex-wrap: wrap; gap: 2px 12px; }
.nt-solo-footer--horizontal .nt-solo-stat { grid-template-columns: auto auto; column-gap: 6px; align-self: auto; }
.nt-solo-footer--docked { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }
.nt-solo-footer--docked .nt-stats { grid-area: 1 / 1; justify-self: start; max-width: 100%; min-width: 0; }
.nt-solo-footer--docked .nt-solo-docked-preview { grid-area: 1 / 2; max-width: none; margin-left: 0; }
.nt-solo-footer--docked .nt-rank { grid-area: 1 / 3; text-align: right; }
.nt-training-summary { display: flex; flex-wrap: wrap; align-items: center; column-gap: 8px; }
.nt-training-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 6px 0; min-width: 0; }
.nt-training-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  max-width: 100%;
  padding: 3px 10px;
  box-sizing: border-box;
  border: 1px solid color-mix(in srgb, var(--cr-text) 18%, transparent);
  border-radius: 999px;
  background: color-mix(in srgb, var(--cr-text) 5%, transparent);
  color: var(--cr-muted);
  font: 12px/1.2 'LiberationMono', monospace;
  font-variant-numeric: tabular-nums;
}
.nt-training-pill--info, .nt-training-pill--success, .nt-training-pill--warn, .nt-training-pill--over {
  --nt-training-tone: var(--classic-signal-info);
  border-color: color-mix(in srgb, var(--nt-training-tone) 35%, transparent);
  background: color-mix(in srgb, var(--nt-training-tone) 8%, transparent);
  color: var(--cr-text);
}
.nt-training-pill--success, .nt-training-pill--warn {
  border-color: color-mix(in srgb, var(--nt-training-tone) 55%, transparent);
  background: color-mix(in srgb, var(--nt-training-tone) 12%, transparent);
  color: var(--nt-training-tone);
}
.nt-training-pill--success { --nt-training-tone: var(--classic-signal-success); }
.nt-training-pill--warn { --nt-training-tone: var(--classic-signal-warning); }
.nt-training-pill--over { --nt-training-tone: var(--cr-danger); color: var(--cr-danger); }
.nt-training-pill--streak { padding: 2px 6px; gap: 3px; font-size: 11px; color: var(--classic-signal-warning); }
.nt-training-pill .nt-settings-icon { width: 12px; height: 12px; flex-basis: 12px; }
.nt-training-track { width: 60px; height: 4px; border-radius: 999px; overflow: hidden; background: color-mix(in srgb, var(--cr-text) 8%, transparent); }
.nt-training-fill { height: 100%; background: var(--nt-training-tone); }
.nt-training-muted { opacity: .75; }
