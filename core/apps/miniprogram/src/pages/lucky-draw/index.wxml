<view class="draw-page" style="{{appearanceStyle}}" wx:if="{{view}}">
 <view class="options"><text>{{copy.training}}</text><switch checked="{{view.session.training}}" data-key="training" bindchange="setting"/><text>{{copy.stage}}</text><switch checked="{{view.session.stage}}" data-key="stage" bindchange="setting"/><text>{{copy.repeat}}</text><switch checked="{{view.session.repeat}}" data-key="repeat" bindchange="setting"/></view>
 <view wx:if="{{!view.session.training}}"><text>{{copy.count}}</text><input type="number" value="{{view.session.count}}" bindinput="count"/></view>
 <text wx:if="{{view.message}}">{{view.message}}</text>
 <view class="actions"><button hover-class="press-feedback" data-action="edit" bindtap="act" disabled="{{view.busy}}">{{copy.editor}}</button><button hover-class="press-feedback" data-action="reset" bindtap="act" disabled="{{view.busy || !view.session.history.length}}">{{copy.reset}}</button></view>
 <view wx:if="{{view.editing}}">
 <textarea value="{{view.draft}}" data-key="draft" bindinput="input" maxlength="500000" placeholder="{{copy.hint}}"/><text class="note">{{copy.hint}}</text><text class="note">{{copy.editNote}}</text>
 <view wx:if="{{view.duplicates}}"><text>{{copy.duplicates}} ({{view.duplicates}})</text><button hover-class="press-feedback" data-action="dedupe" bindtap="act">{{copy.dedupe}}</button></view>
 <view class="actions"><button hover-class="press-feedback" data-action="apply" bindtap="act">{{copy.apply}}</button><button hover-class="press-feedback" data-action="clear" bindtap="act">{{copy.clear}}</button></view>
 <view wx:if="{{view.session.training}}"><text>{{copy.letters}}</text><input value="{{view.letters}}" data-key="letters" bindinput="input"/><view class="actions"><button hover-class="press-feedback" data-action="builtin" bindtap="act">{{copy.builtin}}</button><button hover-class="press-feedback" data-action="weak" bindtap="act">{{copy.weak}}</button></view></view>
 <input placeholder="{{copy.name}}" value="{{view.listName}}" data-key="listName" bindinput="input"/><button hover-class="press-feedback" data-action="save" bindtap="act" disabled="{{!view.listName || !view.draft}}">{{copy.save}}</button>
 <view wx:for="{{view.saved}}" wx:key="name" class="actions"><text>{{item.name}}</text><button hover-class="press-feedback" data-action="load" data-index="{{index}}" bindtap="act">{{copy.load}}</button><button hover-class="press-feedback" data-action="remove" data-index="{{index}}" bindtap="act">{{copy.remove}}</button></view>
 <input placeholder="{{copy.query}}" value="{{view.query}}" data-key="query" bindinput="input"/><button hover-class="press-feedback" data-action="search" bindtap="act" disabled="{{view.loading}}">{{copy.search}}</button>
 <view wx:for="{{view.competitions}}" wx:key="id"><text>{{item.name}} · {{item.date}}</text><button hover-class="press-feedback" data-action="import" data-index="{{index}}" bindtap="act" disabled="{{view.loading}}">{{copy.import}}</button></view>
 <view wx:if="{{view.preview}}"><text>{{copy.preview}} · {{view.source}}</text><text class="note">{{copy.source}}</text><scroll-view scroll-y class="preview"><text selectable>{{view.preview}}</text></scroll-view><view class="actions"><button hover-class="press-feedback" data-action="replace" bindtap="act">{{copy.replace}}</button><button hover-class="press-feedback" data-action="append" bindtap="act">{{copy.append}}</button><button hover-class="press-feedback" data-action="cancel" bindtap="act">{{copy.cancel}}</button></view></view>
 </view>
 <view class="counts"><text>{{copy.remaining}} {{view.remaining}}</text><text>{{copy.history}} {{view.session.history.length}}</text></view>
 <view class="stage {{view.session.stage ? 'is-3d' : ''}} {{view.busy ? 'drawing' : ''}} {{view.last.length && !view.busy ? 'has-result' : ''}}">
  <view wx:if="{{view.session.stage || !view.last.length || view.busy}}" class="cloud">
   <view wx:for="{{cards}}" wx:key="id" class="slot" style="{{item.style}}"><view class="card"><text>{{item.name}}</text><text class="note" wx:if="{{item.number}}">#{{item.number}}</text></view></view>
  </view>
  <view wx:if="{{view.last.length && !view.busy}}" class="winners"><view class="card winner" wx:for="{{view.last}}" wx:key="id"><text>{{item.name}}</text><text class="note" wx:if="{{item.number}}">#{{item.number}}</text><text class="answer" wx:if="{{view.session.training && view.revealed}}">{{item.answer || copy.noAnswer}}</text></view></view>
 </view>
 <view class="actions primary"><button hover-class="press-feedback" wx:if="{{view.session.training && view.last.length && !view.revealed}}" data-action="reveal" bindtap="act" disabled="{{view.busy}}">{{copy.reveal}}</button><block wx:if="{{view.session.training && view.revealed}}"><button hover-class="press-feedback" data-action="known" bindtap="act">{{copy.known}}</button><button hover-class="press-feedback" data-action="unknown" bindtap="act">{{copy.unknown}}</button></block><button hover-class="press-feedback" data-action="draw" bindtap="act" disabled="{{view.busy || !view.remaining}}">{{view.busy ? copy.busy : view.remaining ? copy.next : copy.empty}}</button></view>
 <view class="actions"><text>{{copy.history}}</text><button hover-class="press-feedback" data-action="copy" bindtap="act" disabled="{{!history.length}}">{{copy.copy}}</button><button hover-class="press-feedback" bindtap="export" disabled="{{!history.length}}">{{copy.export}}</button></view><view wx:for="{{history}}" wx:key="order"><text>{{item.order}}. {{item.number ? '#' + item.number + ' ' : ''}}{{item.name}} {{item.rating}}</text></view>
</view>
