.draw-page {
  padding: 28rpx;
  background: var(--cr-bg);
  color: var(--cr-text);
  min-height: 100vh;
  box-sizing: border-box;
}
.options {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
}
.actions,
.counts {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 0;
}
.counts {
  justify-content: space-between;
}
button {
  font-size: 26rpx;
  margin: 0;
  padding: 16rpx 24rpx;
  min-height: 76rpx;
  border: 1rpx solid var(--cr-line);
  border-radius: 12rpx;
  line-height: 1.4;
  background: var(--cr-surface);
  color: var(--cr-text);
}
input,
textarea {
  padding: 16rpx;
  border: 1rpx solid var(--cr-line);
  border-radius: 12rpx;
  margin: 12rpx 0;
  box-sizing: border-box;
  width: 100%;
}
textarea {
  height: 300rpx;
}
.note {
  display: block;
  font-size: 24rpx;
  color: var(--cr-muted);
}
.preview {
  max-height: 300rpx;
  white-space: pre-wrap;
}
.stage {
  position: relative;
  min-height: 420rpx;
  overflow: hidden;
  background: var(--cr-surface);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.stage.is-3d {
  min-height: 680rpx;
  perspective: 850px;
}
.cloud,
.winners {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  padding: 32rpx;
}
.card {
  border: 1rpx solid var(--cr-line);
  background: var(--cr-bg);
  padding: 24rpx;
  border-radius: 16rpx;
  overflow-wrap: anywhere;
  text-align: center;
  min-width: 80rpx;
}
.is-3d .cloud {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 440px;
  height: 340px;
  padding: 0;
  transform: translate(-50%, -50%) scale(0.74);
  transform-style: preserve-3d;
  transition: opacity 300ms;
  pointer-events: none;
}
.is-3d .slot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 112px;
  height: 82px;
  margin: -41px 0 0 -56px;
  transform-style: preserve-3d;
  transform: translate3d(var(--x), var(--y), var(--z)) rotateY(var(--yaw))
    rotateZ(var(--tilt));
}
.is-3d .slot .card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  min-width: 0;
  padding: 10px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 20px;
  line-height: 1.2;
  animation: card-float 4s ease-in-out infinite alternate;
  animation-delay: var(--delay);
}
.is-3d .slot .card::before {
  content: "";
  position: absolute;
  left: 8px;
  top: 8px;
  width: 7px;
  height: 7px;
  border-top: 1px solid var(--cr-accent);
  border-left: 1px solid var(--cr-accent);
}
.is-3d .slot .note {
  font-size: 12px;
  margin-top: 6px;
}
.is-3d.has-result .cloud {
  opacity: 0.12;
}
.has-result .slot .card,
.drawing .slot .card {
  animation-play-state: paused;
}
.drawing .slot {
  animation: card-shuffle 900ms ease-in-out both;
}
.winners {
  position: relative;
  z-index: 1;
  max-height: 800rpx;
  overflow: auto;
  width: 100%;
  box-sizing: border-box;
}
.winner {
  font-size: 80rpx;
  min-width: 300rpx;
  max-width: 100%;
  padding: 44rpx 56rpx;
  border-color: var(--cr-accent);
}
.is-3d .winner {
  animation: result-in 550ms cubic-bezier(0.16, 1, 0.3, 1) both;
}
.answer {
  display: block;
  font-size: 36rpx;
  margin-top: 20rpx;
}
@keyframes card-float {
  from {
    transform: translateY(-6px) rotateY(-4deg);
  }
  to {
    transform: translateY(8px) rotateY(4deg);
  }
}
@keyframes card-shuffle {
  35%,
  65% {
    transform: translate3d(
        calc(var(--x) * 0.28),
        calc(var(--y) * 0.28),
        calc(var(--z) * 0.5)
      )
      rotateY(calc(var(--yaw) * -1)) rotateZ(calc(var(--tilt) * -1));
  }
}
@keyframes result-in {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.75) rotateY(-25deg);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  .cloud,
  .slot,
  .card {
    animation: none !important;
    transition: none !important;
  }
}
.primary {
  position: sticky;
  bottom: 0;
  background: var(--cr-bg);
  padding: 16rpx 0;
}
.primary button:last-child {
  background: var(--cr-accent);
  color: var(--cr-bg);
}
