<view class="page timeline-share-page">
  <text class="eyebrow">分享</text>
  <text class="page-title">{{title}}</text>
  <text wx:if="{{description}}" class="page-intro">{{description}}</text>

  <view wx:if="{{canShare}}" class="timeline-share-actions">
    <text class="status-text" aria-role="status" aria-live="polite">点击右上角“…”并选择“分享到朋友圈”</text>
    <button class="primary-button timeline-share-button" hover-class="press-feedback" bindtap="openRoute">打开页面</button>
    <text wx:if="{{errorMessage}}" class="status-text status-text--error" aria-role="alert">{{errorMessage}}</text>
  </view>
  <text wx:else class="status-text status-text--error" aria-role="alert">{{errorMessage}}</text>
</view>
