<page-meta page-style="{{appearanceStyle}}" />
<import src="../../templates/native-appearance.wxml" />
<template is="native-scenery" />
<view wx:if="{{loading}}" class="membership-loading" aria-role="status" aria-label="{{labels.loading}}">
  <image class="membership-loading-logo" src="/assets/cuberoot-logo.png" mode="aspectFit" aria-hidden="true" />
</view>
<view wx:else class="page">
  <text wx:if="{{account}}" class="page-intro">{{account}}</text>
  <text wx:if="{{amount}}" class="page-title">{{amount}}</text>
  <text wx:if="{{message}}" class="page-intro">{{message}}</text>
  <text wx:if="{{error}}" class="status-text status-text--error" aria-role="status">{{error}}</text>
  <button wx:if="{{error && hasEntry && !context}}" hover-class="press-feedback" class="text-button" bindtap="refresh">{{labels.retry}}</button>
  <button hover-class="press-feedback" wx:if="{{needsLogin}}" class="primary-button" bindtap="login">{{labels.login}}</button>
  <block wx:if="{{context}}">
    <text wx:if="{{!context.pilot}}" class="page-intro">{{labels.rules}}</text>
    <button hover-class="press-feedback" class="text-button" bindtap="terms">{{labels.terms}}</button>
    <!-- allow-checkbox: explicit renewal consent must be actively selected -->
    <checkbox-group wx:if="{{canSign}}" bindchange="consent"><label><checkbox value="agree" checked="{{agreed}}" />{{labels.agree}}</label></checkbox-group>
    <button hover-class="press-feedback" wx:if="{{canSign}}" class="primary-button" disabled="{{!agreed || busy || refreshing}}" loading="{{busy}}" bindtap="sign">{{labels.sign}}</button>
    <button hover-class="press-feedback" class="text-button" disabled="{{busy || refreshing}}" bindtap="refresh">{{labels.refresh}}</button>
    <button hover-class="press-feedback" wx:if="{{canCancel}}" class="text-button" disabled="{{busy || refreshing}}" bindtap="cancel">{{labels.cancel}}</button>
  </block>
</view>
