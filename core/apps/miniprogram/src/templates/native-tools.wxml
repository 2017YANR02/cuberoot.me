<view class="page native-tools native-tab-surface" style="{{appearanceStyle}}">
  <view class="tools-sections">
    <button wx:for="{{copy.sections}}" wx:key="id" class="tools-section{{section === item.id ? ' tools-section--active' : ''}}" aria-pressed="{{section === item.id}}" data-section="{{item.id}}" hover-class="press-feedback" bindtap="selectTool">{{item.label}}</button>
  </view>
  <block wx:if="{{section === 'wca'}}">
  <view class="tools-query-bar">
    <picker mode="selector" range="{{copy.choices}}" value="{{modeIndex}}" bindchange="changeMode"><view class="tools-select">{{copy.choices[modeIndex]}}</view></picker>
    <button wx:if="{{mode !== 'person' && !error}}" hover-class="press-feedback" class="tools-button" bindtap="search" disabled="{{loading}}">{{copy.retry}}</button>
  </view>
  <view wx:if="{{mode === 'person'}}" class="tools-search">
    <input value="{{query}}" bindinput="inputQuery" bindconfirm="search" confirm-type="search" placeholder="{{copy.placeholder}}" aria-label="WCA ID" maxlength="10" />
    <button hover-class="press-feedback" class="tools-button {{query ? '' : 'tools-clear-empty'}}" disabled="{{!query}}" aria-hidden="{{!query}}" bindtap="clearQuery" aria-label="{{copy.clear}}">×</button>
    <button hover-class="press-feedback" class="tools-button" bindtap="search" disabled="{{loading}}">{{copy.search}}</button>
  </view>
  <text wx:if="{{mode === 'records'}}" class="tools-note">{{copy.source}}</text>
  <text wx:if="{{loading}}" class="tools-note" aria-role="status">{{copy.loading}}</text>
  <view wx:elif="{{error}}"><text class="tools-error">{{error}}</text><button hover-class="press-feedback" class="tools-button" bindtap="search">{{copy.retry}}</button></view>
  <block wx:else>
    <text wx:if="{{personName}}" class="page-title">{{personName}}</text>
    <text wx:if="{{!rows.length && (mode !== 'person' || searched)}}" class="tools-note">{{copy.empty}}</text>
    <view wx:for="{{rows}}" wx:key="id" class="tools-row"><text class="tools-row-title" selectable="{{true}}">{{item.title}}</text><text wx:if="{{item.detail}}" class="tools-note">{{item.detail}}</text><text wx:if="{{item.result}}" class="tools-rank">{{item.result}}</text></view>
  </block>
  </block>
  <view wx:elif="{{section === 'average'}}" class="tools-workspace">
    <text class="tools-field-label">{{copy.averageInputLabel}}</text>
    <text class="tools-note">{{copy.averageHelp}}</text>
    <textarea class="tools-input tools-input--times" value="{{averageInput}}" aria-label="{{copy.averageInputLabel}}" placeholder="{{copy.averageExample}}" maxlength="2400" bindinput="inputAverage" />
    <button class="primary-button tools-calculate" hover-class="press-feedback" disabled="{{!averageInput}}" bindtap="calculateAverage">{{copy.calculate}}</button>
    <text wx:if="{{averageError}}" class="tools-error" aria-role="status">{{averageError}}</text>
    <view wx:if="{{averageResults.length}}" class="tools-stat-grid">
      <view wx:for="{{averageResults}}" wx:key="label" class="tools-stat">
        <text class="tools-stat-label">{{item.label}}</text>
        <text class="tools-stat-value" selectable="{{true}}">{{item.value}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="tools-workspace">
    <text class="tools-field-label">{{copy.algInputLabel}}</text>
    <textarea class="tools-input" value="{{algInput}}" aria-label="{{copy.algInputLabel}}" placeholder="R U R' U'" maxlength="1200" bindinput="inputAlg" />
    <view class="tools-actions">
      <button class="tools-action" disabled="{{!algInput}}" data-action="inverse" hover-class="press-feedback" bindtap="transformAlg">{{copy.algInverse}}</button>
      <button class="tools-action" disabled="{{!algInput}}" data-action="M" hover-class="press-feedback" bindtap="transformAlg">{{copy.algMirrorLeft}}</button>
      <button class="tools-action" disabled="{{!algInput}}" data-action="S" hover-class="press-feedback" bindtap="transformAlg">{{copy.algMirrorFront}}</button>
    </view>
    <text wx:if="{{algError}}" class="tools-error" aria-role="status">{{algError}}</text>
    <view wx:if="{{algOutput}}" class="tools-output">
      <text class="tools-alg-output" selectable="{{true}}">{{algOutput}}</text>
      <button class="tools-button" hover-class="press-feedback" bindtap="copyAlg">{{copy.copyResult}}</button>
    </view>
  </view>
</view>
