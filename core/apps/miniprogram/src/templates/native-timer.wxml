            </view>
            <text wx:else class="nt-hint">{{statistics.charts.scatter.empty}}</text>
            <view wx:if="{{statistics.charts.scatter.visible}}" class="nt-chart-axis nt-statistics-axis-horizontal nt-statistics-axis-attempts"><text>{{statistics.charts.scatter.attempts[0]}}</text><text>{{statistics.charts.scatter.attempts[1]}}</text><text>{{statistics.charts.scatter.attempts[2]}}</text></view>
            <text wx:if="{{statisticsChartHint.chart === 'scatter'}}" class="nt-hint nt-statistics-chart-hint" aria-role="status">{{statisticsChartHint.label}}</text>
            <text class="nt-category">{{statistics.charts.distribution.title}}</text>
            <block wx:if="{{statistics.charts.distribution.bins.length}}">
              <text class="nt-statistics-peak">max {{statistics.charts.distribution.peak}}</text>
              <view class="nt-histogram nt-statistics-histogram">
                <view wx:for="{{statistics.charts.distribution.bins}}" wx:key="index" class="nt-histogram-column" aria-label="{{item.label}}" data-label="{{item.label}}" data-chart="distribution" bindtap="selectStatisticsChartPoint"><view class="nt-histogram-bar {{item.count ? '' : 'is-empty'}}" style="height: {{item.height}}%"></view></view>
              </view>
              <view class="nt-chart-axis nt-statistics-axis-horizontal"><text>{{statistics.charts.distribution.min}}</text><text>{{statistics.charts.distribution.mid}}</text><text>{{statistics.charts.distribution.max}}</text></view>
              <text wx:if="{{statisticsChartHint.chart === 'distribution'}}" class="nt-hint nt-statistics-chart-hint" aria-role="status">{{statisticsChartHint.label}}</text>
            </block>
            <text wx:else class="nt-hint">{{statistics.charts.distribution.empty}}</text>
            <block wx:if="{{statistics.charts.practiceTimes}}">
              <text class="nt-category">{{statistics.charts.practiceTimes.title}}</text>
              <text class="nt-hint">{{statistics.charts.practiceTimes.hourLabel}}</text>
              <template is="nt-statistics-practice-bars" data="{{chart: statistics.charts.practiceTimes.hours, compact: true, chartKey: 'hours', countLabel: statistics.charts.practiceTimes.countLabel, medianLabel: statistics.charts.practiceTimes.medianLabel, hint: statisticsChartHint}}" />
              <text class="nt-hint">{{statistics.charts.practiceTimes.dayLabel}}</text>
              <template is="nt-statistics-practice-bars" data="{{chart: statistics.charts.practiceTimes.weekdays, compact: false, chartKey: 'weekdays', countLabel: statistics.charts.practiceTimes.countLabel, medianLabel: statistics.charts.practiceTimes.medianLabel, hint: statisticsChartHint}}" />
            </block>
          </block>
          <block wx:if="{{statistics.cases}}">
            <block wx:if="{{statistics.cases.cfop.length}}">
              <text class="nt-category">{{statistics.copy.caseDetails}}</text>
              <text wx:if="{{!statistics.cases.cfop[0].rows.length && !statistics.cases.cfop[1].rows.length}}" class="nt-hint">{{statistics.copy.emptyCases}}</text>
              <block wx:for="{{statistics.cases.cfop}}" wx:key="stage" wx:for-item="group">
                <view wx:if="{{group.rows.length}}" class="nt-statistics-section">
                  <text class="nt-hint">{{group.title}}</text>
                  <view class="nt-statistics-case-row nt-statistics-table-head"><text>{{statistics.copy.case}}</text><text>{{statistics.copy.count}}</text><text>{{statistics.copy.mean}}</text><text>{{statistics.copy.best}}</text><text>{{statistics.copy.worst}}</text></view>
                  <view wx:for="{{group.rows}}" wx:key="id" class="nt-statistics-case-row"><text>{{item.id}}</text><text>{{item.count}}</text><text>{{item.avg}}</text><text>{{item.best}}</text><text>{{item.worst}}</text></view>
                  <button wx:if="{{group.remaining}}" class="nt-statistics-action nt-statistics-expand" data-action="cases" data-value="{{group.stage}}" bindtap="changeStatistics" aria-expanded="{{group.expanded}}" hover-class="press-feedback">
                    <image class="nt-icon-light" src="/assets/tabbar/{{group.expanded ? 'chevron-down' : 'chevron-right'}}-light.png" aria-hidden="true" /><image class="nt-icon-dark" src="/assets/tabbar/{{group.expanded ? 'chevron-down' : 'chevron-right'}}-dark.png" aria-hidden="true" />
                    <text>{{group.expanded ? statistics.copy.hideCases : group.expandLabel}}</text>
                  </button>
                  <view wx:if="{{group.slowest.length}}" class="nt-statistics-case-slowest nt-hint"><text>{{statistics.copy.slowest}}</text><text wx:for="{{group.slowest}}" wx:key="id">{{index + 1}}. {{item.id}} ({{item.avg}})</text></view>
                </view>
              </block>
            </block>
            <text class="nt-category">{{statistics.cases.title}}</text>
            <view wx:for="{{statistics.cases.thresholds}}" wx:key="threshold" class="nt-statistics-threshold"><text>{{item.label}}</text><view class="nt-statistics-threshold-track"><view style="width: {{item.pct}}%"></view></view><text>{{item.text}}</text></view>
            <text wx:if="{{!statistics.cases.thresholds.length}}" class="nt-hint">{{statistics.copy.noThresholds}}</text>
          </block>
        </view>
      </block>
      <block wx:elif="{{sheet === 'detail'}}">
        <text class="nt-detail-time" selectable="{{true}}">{{detail.result}}</text><text class="nt-hint">{{detail.date}}</text>
        <view class="nt-setting"><text>{{copy.event}}</text><text>{{detail.eventName}}</text></view>
        <view class="nt-setting"><text>{{copy.rawTime}}</text><text>{{detail.rawTime}}</text></view>
        <view class="nt-setting"><text>{{copy.penalty}}</text><picker range="{{penaltyLabels}}" value="{{penaltyIndex}}" bindchange="changeDetailPenalty"><view class="nt-control">{{penaltyLabels[penaltyIndex]}}</view></picker></view>
        <view wx:if="{{detail.inspection}}" class="nt-setting"><text>{{copy.inspectionTime}}</text><text>{{detail.inspection}}</text></view>
        <view wx:if="{{detail.deviceName}}" class="nt-setting"><text>{{copy.device}}</text><text>{{detail.deviceName}}</text></view>
        <view wx:if="{{detail.source}}" class="nt-setting"><text>{{copy.source}}</text><text>{{detail.source}}</text></view>
        <text class="nt-result-scramble" selectable="{{true}}">{{detail.scramble}}</text><text wx:if="{{detail.comment}}" class="nt-comment" selectable="{{true}}">{{detail.comment}}</text>
        <view wx:if="{{detailPreview}}" class="nt-previews"><view class="nt-preview"><image mode="aspectFit" src="{{detailPreview}}" binderror="detailImageError" aria-label="{{copy.preview}}" /></view></view>
        <text wx:if="{{detailPreviewError}}" class="nt-error">{{detailPreviewError}}</text>
        <block wx:if="{{detail.stages.length}}">
          <text class="nt-category">{{copy.stageSplits}}</text>
          <view class="nt-stat-row nt-hint"><text></text><text>{{copy.duration}}</text><text>{{copy.cumulative}}</text></view>
          <view wx:for="{{detail.stages}}" wx:key="id" class="nt-stat-row"><text>{{item.label}}</text><text>{{item.duration}}</text><text>{{item.cumulative}}</text></view>
        </block>
        <block wx:if="{{detail.memo}}">
          <view class="nt-setting"><text>{{copy.memo}}</text><text>{{detail.memo}}</text></view>
          <view class="nt-setting"><text>{{copy.execution}}</text><text>{{detail.execution}}</text></view>
        </block>
        <button wx:if="{{detail.canRecap}}" class="nt-control" bindtap="openSheet" data-sheet="recap" hover-class="press-feedback">{{copy.recap}}</button>
        <view class="nt-actions"><button hover-class="press-feedback" wx:for="{{resultActions}}" wx:key="id" class="nt-control" bindtap="resultAction" data-action="{{item.id}}">{{item.title}}</button></view>
        <picker wx:if="{{moveTargets.length}}" range="{{moveTargets}}" range-key="name" bindchange="moveResult"><view class="nt-control">{{copy.moveSession}}</view></picker>
      </block>
      <block wx:elif="{{sheet === 'replay'}}">
        <view class="nt-entry-field">
          <text>{{copy.replayInput.input}}</text>
          <textarea class="nt-draft" value="{{draft}}" maxlength="-1" bindinput="inputReplay" disabled="{{replayLoading}}" focus="{{true}}" aria-label="{{copy.replayInput.input}}" />
        </view>
        <text wx:if="{{formError}}" class="nt-error" aria-role="alert">{{formError}}</text>
        <view class="nt-actions">
          <button wx:if="{{replayHasInput}}" class="nt-control" bindtap="clearReplayInput" disabled="{{replayLoading}}" hover-class="press-feedback">{{copy.replayInput.clear}}</button>
          <button class="nt-control" bindtap="openReplayInput" disabled="{{replayLoading || !replayHasInput}}" hover-class="press-feedback">{{replayLoading ? copy.replayInput.loading : copy.replayInput.open}}</button>
        </view>
      </block>
      <block wx:elif="{{sheet === 'recap'}}">
        <text wx:if="{{recapLoading}}" class="nt-hint" aria-role="status">{{copy.solving}}</text>
        <text wx:if="{{formError}}" class="nt-error" aria-role="alert">{{formError}}</text>
        <block wx:if="{{recapFrame}}">
          <view class="nt-setting"><text>{{copy.recapTurns}} {{recapSummary.moves}}</text><text>TPS {{recapSummary.tps}}</text><text wx:if="{{recapSummary.fluency != null}}">{{copy.recapFluency}} {{recapSummary.fluency}}%</text></view>
          <view class="nt-solver-playback">
            <view class="nt-live-cube nt-recap-cube">
              <image wx:if="{{!recapCanvasReady}}" src="{{recapFrame.image}}" mode="aspectFit" aria-label="{{copy.preview}}" />
              <canvas wx:if="{{recapCanvas}}" type="webgl" id="nt-recap-canvas" class="nt-live-canvas {{recapCanvasReady ? 'nt-live-canvas--ready' : ''}}" aria-label="{{copy.preview}}" />
            </view>
            <view wx:if="{{recapHasGyro && recapCanvasReady}}" class="nt-setting"><text>{{copy.recapGyro}}</text><switch checked="{{recapGyro}}" bindchange="toggleRecapGyro" aria-label="{{copy.recapGyro}}" /></view>
            <view class="nt-setting"><text>{{recapFrame.index}} / {{recapFrame.total}} {{recapFrame.move}}</text>
              <button class="nt-control" bindtap="toggleRecapPlayback" hover-class="press-feedback">{{recapPlaying ? copy.solverPause : copy.solverPlay}}</button>
            </view>
            <slider min="0" max="{{recapFrame.total}}" value="{{recapFrame.index}}" bindchange="seekRecap" aria-label="{{copy.solverPlay}}" />
          </view>
          <view class="nt-actions">
            <button class="nt-control" bindtap="copyRecap" hover-class="press-feedback">{{copy.recapCopy}}</button>
            <button class="nt-control" bindtap="copyRecap" data-kind="link" hover-class="press-feedback">{{copy.recapLink}}</button>
          </view>
          <view wx:for="{{recapStages}}" wx:key="key" class="nt-setting"><text>{{item.label}}</text><text>{{item.result}}</text></view>
          <button wx:for="{{recapRows}}" wx:key="index" class="nt-result nt-recap-row" bindtap="seekRecapRow" data-index="{{index}}" hover-class="press-feedback">
            <text>{{item.index}}</text><text>{{item.move}}</text><text>{{item.time}}</text><text>{{item.gapTime}}</text>
          </button>
        </block>
      </block>
      <block wx:elif="{{sheet === 'import'}}">
        <block wx:if="{{!importStatus}}">
          <button class="nt-control" bindtap="readTimerImport" disabled="{{importBusy}}" hover-class="press-feedback">{{copy.dataImportPaste}}</button>
          <button wx:for="{{importFiles}}" wx:key="id" class="nt-result" bindtap="readTimerImport" data-id="{{item.id}}" disabled="{{importBusy}}" hover-class="press-feedback">{{item.filename}}</button>
          <textarea class="nt-draft" value="{{draft}}" bindinput="draftInput" maxlength="-1" placeholder="{{copy.dataImportPlaceholder}}" />
          <button class="nt-control" bindtap="checkTimerImport" disabled="{{importBusy}}" hover-class="press-feedback">{{copy.dataImportInspect}}</button>
        </block>
        <block wx:else>
          <view class="nt-setting"><text>{{copy.session}}</text><text>{{importCounts.groups}}</text></view>
          <view class="nt-setting"><text>{{copy.results}}</text><text>{{importCounts.solves}}</text></view>
          <view wx:for="{{importRows}}" wx:key="id" class="nt-setting">
            <text>{{item.name}}</text>
            <picker range="{{events}}" range-key="name" value="{{item.index < 0 ? 0 : item.index}}" bindchange="setTimerImportEvent" data-id="{{item.id}}"><view class="nt-control">{{item.index < 0 ? copy.dataImportMapping : events[item.index].name}}</view></picker>
          </view>
          <button class="nt-control" bindtap="finishTimerImport" disabled="{{importBusy || importUnresolved}}" hover-class="press-feedback">{{copy.dataImportComplete}}</button>
        </block>
        <text wx:if="{{formError}}" class="nt-error" aria-role="alert">{{formError}}</text>
      </block>
      <block wx:elif="{{sheet === 'manual'}}">
        <block wx:if="{{entryKind === 'fmc'}}">
          <view class="nt-entry-field"><text>{{copy.entry.fmcSolution}}</text><textarea class="nt-draft" value="{{manualDraft.fmcSolution}}" data-field="fmcSolution" bindinput="changeManualEntry" placeholder="{{copy.entry.fmcSolutionPlaceholder}}" maxlength="-1" /></view>
          <view class="nt-entry-field"><text>{{copy.entry.fmcMoveCount}}</text><input value="{{manualDraft.fmcMoveCount}}" type="number" data-field="fmcMoveCount" bindinput="changeManualEntry" placeholder="{{copy.entry.fmcMoveCountPlaceholder}}" /></view>
        </block>
        <block wx:elif="{{entryKind === 'mbld'}}">
          <view class="nt-setting">
            <view class="nt-entry-field"><text>{{copy.entry.attempted}}</text><input value="{{manualDraft.mbldAttempted}}" type="number" data-field="mbldAttempted" bindinput="changeManualEntry" placeholder="{{copy.entry.attemptedPlaceholder}}" /></view>
            <view class="nt-entry-field"><text>{{copy.entry.solved}}</text><input value="{{manualDraft.mbldSolved}}" type="number" data-field="mbldSolved" bindinput="changeManualEntry" placeholder="{{copy.entry.solvedPlaceholder}}" /></view>
          </view>
          <view class="nt-entry-field"><text>{{copy.entry.mbldTime}}</text><input value="{{manualDraft.time}}" data-field="time" bindinput="changeManualEntry" placeholder="{{copy.entry.mbldTimePlaceholder}}" /></view>
        </block>
        <block wx:else>
          <view class="nt-entry-field"><text>{{copy.entry.time}}</text><input value="{{manualDraft.time}}" data-field="time" bindinput="changeManualEntry" placeholder="{{copy.entry.timePlaceholder}}" /></view>
          <view class="nt-setting"><text>{{copy.entry.penalty}}</text><picker value="{{entryPenaltyIndex}}" range="{{entryPenalties}}" bindchange="changeEntryPenalty"><view class="nt-control">{{entryPenalties[entryPenaltyIndex]}}</view></picker></view>
        </block>
        <text wx:if="{{entryPreview}}" class="nt-hint">{{entryPreview}}</text>
        <view class="nt-entry-field"><text>{{copy.entry.scramble}}</text><textarea class="nt-draft" value="{{manualDraft.scramble}}" data-field="scramble" bindinput="changeManualEntry" placeholder="{{manualDraft.currentScramble}}" maxlength="-1" /></view>
        <view class="nt-entry-field"><text>{{entryKind === 'fmc' ? copy.entry.fmcComment : copy.entry.comment}}</text><input value="{{manualDraft.comment}}" data-field="comment" bindinput="changeManualEntry" placeholder="{{copy.entry.commentPlaceholder}}" /></view>
        <text wx:if="{{formError}}" class="nt-error">{{formError}}</text>
        <view class="nt-actions"><button class="nt-control" bindtap="closeSheet" hover-class="press-feedback">{{copy.entry.cancel}}</button><button class="nt-control" bindtap="saveDraft" hover-class="press-feedback">{{copy.entry.save}}</button></view>
      </block>
      <block wx:else>
        <textarea class="nt-draft" value="{{draft}}" bindinput="draftInput" maxlength="-1" placeholder="{{copy.session}}" />
        <text wx:if="{{formError}}" class="nt-error">{{formError}}</text>
        <view class="nt-actions"><button hover-class="press-feedback" class="nt-control" bindtap="clearDraft">{{copy.clear}}</button><button hover-class="press-feedback" class="nt-control" bindtap="saveDraft">{{copy.save}}</button></view>
      </block>
      </scroll-view>
      <view wx:if="{{sheet === 'device-management' && deviceManagement.stackmat}}" class="nt-device-timer-actions nt-stackmat-actions">
        <button wx:if="{{deviceManagement.stackmat.listening}}" class="nt-control nt-device-close" bindtap="stopStackmatListening" hover-class="press-feedback">{{deviceManagement.stackmat.stop}}</button>
        <button wx:elif="{{deviceManagement.stackmat.available}}" class="nt-control nt-device-close nt-device-primary" bindtap="startStackmatListening" disabled="{{deviceManagement.stackmat.starting}}" hover-class="press-feedback">{{deviceManagement.stackmat.start}}</button>
        <button class="nt-control nt-device-close nt-stackmat-close" bindtap="closeSheet" aria-label="{{deviceManagement.stackmat.close}}" hover-class="press-feedback"><template is="nt-solver-icon" data="{{icon: 'x'}}" /></button>
      </view>
      <view wx:if="{{sheet === 'statistics' && statistics}}" class="nt-statistics-footer">
        <button class="nt-statistics-action" bindtap="copyStatistics" hover-class="press-feedback">{{statisticsCopied ? statistics.copy.copied : statistics.copy.copy}}</button>
        <button class="nt-statistics-action" bindtap="closeSheet" hover-class="press-feedback">{{copy.close}}</button>
      </view>
      <view wx:if="{{sheet === 'bulk'}}" class="nt-bulk-actions">
        <button wx:if="{{bulkBatch}}" class="nt-bulk-button" bindtap="exportBulkScrambles" data-action="copy" hover-class="press-feedback">{{bulkCopied ? copy.bulkCopied : copy.bulkCopy}}</button>
        <button wx:if="{{bulkBatch}}" class="nt-bulk-button" bindtap="exportBulkScrambles" data-action="download" hover-class="press-feedback">{{copy.bulkDownload}}</button>
        <button class="nt-bulk-button" bindtap="closeSheet" hover-class="press-feedback">{{copy.close}}</button>
      </view>
    </view>
  </view>
  <view wx:if="{{sheet === 'settings' && orientationMenu}}" class="nt-settings-popover-layer">
    <view class="nt-settings-popover-dismiss" bindtap="closeScrambleOrientation" />
    <scroll-view class="nt-orientation-menu" style="{{orientationMenu.style}}" scroll-y="{{true}}" scroll-into-view="{{'nt-orientation-choice-' + orientationMenu.current}}" aria-role="list">
      <button wx:for="{{orientationMenu.options}}" wx:key="value" id="nt-orientation-choice-{{index}}" class="nt-orientation-option {{item.selected ? 'is-selected' : ''}}" data-index="{{index}}" bindtap="selectScrambleOrientation" aria-label="{{item.colors + ' ' + item.label}}" aria-pressed="{{item.selected}}" hover-class="press-feedback">
        <view class="nt-orientation-chip" aria-hidden="true"><view style="background:{{item.top}}" /><view style="background:{{item.front}}" /></view><text>{{item.label}}</text>
      </button>
    </scroll-view>
  </view>
  <view wx:if="{{sheet === 'settings' && settingsCategory === 'sound' && inspectionAlertsHelp}}" class="nt-settings-popover-layer">
    <view class="nt-settings-popover-dismiss" bindtap="closeInspectionAlertsHelp" />
    <view id="nt-inspection-alerts-help" class="nt-settings-help-panel" style="{{inspectionAlertsHelp.style}}" aria-role="tooltip"><text>{{settingsMenuCopy.inspectionAlertsHelp}}</text></view>
  </view>
  <view wx:if="{{sheet === 'bulk' && bulkProjectMenu}}" class="nt-settings-popover-layer">
    <view class="nt-settings-popover-dismiss" bindtap="closeBulkProjectMenu" />
    <scroll-view class="nt-bulk-project-menu" style="{{bulkProjectMenu}}" scroll-y="{{true}}" aria-role="menu"><template is="nt-project-list" data="{{groups: bulkProjectGroups, selected: bulkEvents[bulkEventIndex].id}}" /></scroll-view>
  </view>
</view>
