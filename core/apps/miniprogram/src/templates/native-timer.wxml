<template name="nt-layout-handles">
  <view class="nt-layout-handles">
    <button wx:if="{{!docked}}" class="nt-layout-handle nt-layout-move" hover-class="press-feedback" data-region="{{region}}" data-mode="move" aria-label="{{copy.layoutHandles[region].move}}" bindtouchstart="startLayoutDrag" catchtouchmove="moveLayoutDrag" bindtouchend="endLayoutDrag" bindtouchcancel="cancelLayoutDrag">
      <image class="nt-icon-light" src="/assets/tabbar/grip-horizontal-light.png" aria-hidden="true" />
      <image class="nt-icon-dark" src="/assets/tabbar/grip-horizontal-dark.png" aria-hidden="true" />
    </button>
    <button class="nt-layout-handle nt-layout-size" hover-class="press-feedback" data-region="{{region}}" data-docked="{{docked}}" data-mode="size" aria-label="{{copy.layoutHandles[region].size}}" bindtouchstart="startLayoutDrag" catchtouchmove="moveLayoutDrag" bindtouchend="endLayoutDrag" bindtouchcancel="cancelLayoutDrag">
      <view class="nt-layout-size-knob">
        <image class="nt-icon-light" src="/assets/tabbar/move-diagonal-2-dark.png" aria-hidden="true" />
        <image class="nt-icon-dark" src="/assets/tabbar/move-diagonal-2-light.png" aria-hidden="true" />
      </view>
    </button>
    <button wx:if="{{canHide}}" class="nt-layout-handle nt-layout-hide" hover-class="press-feedback" data-region="{{region}}" aria-label="{{copy.layoutHandles[region].hide}}" catchtap="hideLayoutRegion">
      <view class="nt-layout-size-knob">
        <image class="nt-icon-light" src="/assets/tabbar/x-dark.png" aria-hidden="true" />
        <image class="nt-icon-dark" src="/assets/tabbar/x-light.png" aria-hidden="true" />
      </view>
    </button>
  </view>
</template>
<template name="nt-settings-icon">
  <image class="nt-settings-icon nt-icon-light" src="/assets/tabbar/{{icon}}-light.png" aria-hidden="true" />
  <image class="nt-settings-icon nt-icon-dark" src="/assets/tabbar/{{icon}}-dark.png" aria-hidden="true" />
</template>
<template name="nt-smart-cube-device">
  <view id="nt-backdrop" class="timer-smart-cube-device__overlay nt-cube-panel" bindtap="closeSheet">
    <view class="timer-smart-cube-device__modal" aria-role="dialog" aria-label="{{device.title}}">
      <button class="timer-smart-cube-device__close" bindtap="closeSheet" aria-label="{{device.copy.close}}" hover-class="press-feedback">
        <template is="nt-settings-icon" data="{{icon: 'x'}}" />
      </button>
      <view class="timer-smart-cube-device__heading">
        <template is="nt-settings-icon" data="{{icon: 'bluetooth'}}" />
        <text class="timer-smart-cube-device__heading-title">{{device.title}}</text>
        <button wx:if="{{device.active}}" class="timer-smart-cube-device__battery{{device.batteryPercent !== null && device.batteryPercent <= 20 ? ' nt-cube-battery--low' : ''}}" bindtap="showCubeBattery" aria-label="{{device.copy.battery}} {{device.battery || '—'}}" hover-class="press-feedback">
          <view class="nt-cube-battery" aria-hidden="true">
            <view wx:if="{{device.batteryPercent !== null}}" class="nt-cube-battery-fill" style="width: {{device.batteryPercent}}%"></view>
            <view wx:else class="nt-cube-battery-unknown"></view>
          </view>
          <text aria-hidden="true">{{device.battery || '—'}}</text>
        </button>
      </view>
      <block wx:if="{{device.active}}">
        <view class="timer-smart-cube-device__summary">
          <view class="timer-smart-cube-device__primary">
            <text class="timer-smart-cube-device__name">{{device.deviceName}}</text>
            <view class="timer-smart-cube-device__state is-ok" aria-role="status" aria-label="{{device.status}}">
              <template is="nt-settings-icon" data="{{icon: 'circle-check'}}" />
            </view>
          </view>
        </view>
        <view class="timer-smart-cube-device__actions">
          <button wx:if="{{device.supportsCalibrate}}" class="timer-smart-cube-device__action" disabled="{{!device.canCalibrate}}" aria-busy="{{device.calibrating}}" hover-class="press-feedback" bindtap="calibrateCube">{{device.copy.calibrate}}</button>
          <button class="timer-smart-cube-device__action timer-smart-cube-device__action--danger" disabled="{{!device.canDisconnect || device.calibrating}}" hover-class="press-feedback" bindtap="disconnectDevice">{{device.copy.disconnect}}</button>
        </view>
      </block>
      <block wx:else>
        <view wx:if="{{error && !device.scanning && !device.connecting}}" class="timer-smart-cube-device__failure" aria-role="alert">
          <text class="nt-cube-failure-title">{{device.copy.connectionFailed}}</text>
          <text>{{error}}</text>
        </view>
        <view class="timer-smart-cube-device__picker" aria-label="{{device.copy.availableDevices}}">
          <view class="timer-smart-cube-device__picker-header">
            <text class="timer-smart-cube-device__picker-title">{{device.copy.availableDevices}}</text>
            <button class="timer-smart-cube-device__scan" bindtap="connectCube" disabled="{{device.scanning || device.connecting}}" aria-busy="{{device.scanning}}" hover-class="press-feedback">
              <view class="{{device.scanning ? 'is-scanning' : ''}}"><template is="nt-settings-icon" data="{{icon: 'refresh-cw'}}" /></view>
              <text>{{device.scanning ? device.copy.scanning : device.copy.scanAgain}}</text>
            </button>
          </view>
          <view wx:if="{{device.devices.length}}" class="timer-smart-cube-device__list" aria-role="list">
            <view wx:for="{{device.devices}}" wx:key="deviceId" class="timer-smart-cube-device__list-item" aria-role="listitem">
              <button class="timer-smart-cube-device__device" aria-label="{{device.copy.connect}} {{item.deviceName}}" aria-busy="{{item.connecting}}" data-id="{{item.deviceId}}" bindtap="connectListedCube" disabled="{{device.connecting}}" hover-class="press-feedback">
                <view class="timer-smart-cube-device__device-copy">
                  <text class="timer-smart-cube-device__device-name">{{item.deviceName}}</text>
                  <text class="timer-smart-cube-device__device-signal">{{item.signal}}</text>
                </view>
                <view class="timer-smart-cube-device__device-action">
                  <view wx:if="{{item.connecting}}" class="is-connecting"><template is="nt-settings-icon" data="{{icon: 'loader-circle'}}" /></view>
                  <text>{{item.connecting ? device.copy.connecting : device.copy.connect}}</text>
                </view>
              </button>
            </view>
          </view>
          <view wx:elif="{{!error || device.connecting || device.scanning}}" class="timer-smart-cube-device__empty" aria-role="status">
            {{device.connecting ? device.copy.connecting : device.scanning ? device.copy.scanning : device.copy.noDevices}}
          </view>
        </view>
      </block>
    </view>
  </view>
</template>
<template name="nt-source-choices">
  <block wx:for="{{copy.sourceChoices}}" wx:key="id">
    <button wx:if="{{officialAvailable || item.id !== 'wca'}}" class="nt-source-option {{source === item.id ? 'is-current' : ''}}" bindtap="chooseSource" data-source="{{item.id}}" aria-pressed="{{source === item.id}}" hover-class="press-feedback">
      <text>{{item.label}}</text><template wx:if="{{item.id === 'wca'}}" is="nt-solver-icon" data="{{icon: 'chevron-right'}}" />
    </button>
  </block>
</template>
<template name="nt-statistics-practice-bars">
  <view class="nt-statistics-practice-legend"><text>{{countLabel}}</text><text>{{medianLabel}}</text></view>
  <view class="nt-statistics-practice-chart">
    <view class="nt-statistics-practice-axis"><text>{{chart.axis.count}}</text><text>0</text></view>
    <view class="nt-statistics-practice-bars">
      <view wx:for="{{chart.bars}}" wx:key="index" class="nt-statistics-practice-slot" aria-label="{{item.label}} · n={{item.count}} · {{item.medianText}}" data-label="{{item.label}} · n={{item.count}} · {{item.medianText}}" data-chart="{{chartKey}}" bindtap="selectStatisticsChartPoint">
        <view class="nt-statistics-practice-plot">
          <view class="nt-statistics-practice-bar {{item.count ? '' : 'is-empty'}}" style="height: {{item.height}}%"></view>
          <view wx:if="{{item.medianY !== null}}" class="nt-statistics-practice-median" style="top: {{item.medianY}}%"></view>
        </view>
        <text class="nt-hint">{{compact && index % 3 !== 0 ? '' : item.label}}</text>
      </view>
    </view>
    <view class="nt-statistics-practice-axis nt-statistics-practice-axis-median"><text>{{chart.axis.max}}</text><text>{{chart.axis.min}}</text></view>
  </view>
  <text wx:if="{{hint.chart === chartKey}}" class="nt-hint nt-statistics-chart-hint" aria-role="status">{{hint.label}}</text>
</template>
<template name="nt-country-flag">
  <block wx:if="{{flag}}">
    <image wx:if="{{flag.src}}" class="nt-country-flag" mode="aspectFit" src="{{flag.src}}" aria-hidden="true" />
    <view wx:else class="nt-country-flag nt-country-flag-marker nt-country-flag-marker--{{flag.kind}}" aria-hidden="true"></view>
  </block>
</template>
<template name="nt-difficulty-slider">
  <view class="nt-dual-slider">
    <view id="nt-difficulty-track" class="nt-dual-slider-track" bindtouchstart="difficultyTrackDown" bindtouchmove="updateDifficultyTrack" bindtouchend="updateDifficultyTrack" bindtouchcancel="cancelDifficultyTrack" aria-label="{{label}} {{range.low}} – {{range.high}}">
      <view class="nt-dual-slider-base"></view>
      <view class="nt-dual-slider-selection" style="left: {{range.lowPercent}}%; width: {{range.highPercent - range.lowPercent}}%"></view>
      <view class="nt-dual-slider-thumb" style="left: {{range.lowPercent}}%"></view>
      <view class="nt-dual-slider-thumb" style="left: {{range.highPercent}}%"></view>
    </view>
    <view wx:if="{{range.marks.length}}" class="nt-dual-slider-marks">
      <button wx:for="{{range.marks}}" wx:key="value" style="left: {{item.position}}%" data-value="{{item.value}}" bindtap="tapDifficultyMark" aria-label="{{label}} {{item.value}}" hover-class="press-feedback">{{item.value}}</button>
    </view>
  </view>
</template>
<template name="nt-solver-icon">
  <image class="nt-icon nt-icon-light" src="/assets/tabbar/{{icon}}-light.png" aria-hidden="true" />
  <image class="nt-icon nt-icon-dark" src="/assets/tabbar/{{icon}}-dark.png" aria-hidden="true" />
</template>
<template name="nt-project-list">
  <view wx:for="{{groups}}" wx:for-item="group" wx:key="id" class="nt-project-group">
    <text class="nt-project-heading">{{group.name}}</text>
    <view class="nt-project-items">
      <button wx:for="{{group.items}}" wx:key="id" class="nt-choice nt-project-choice {{selected === item.id ? 'is-current' : ''}}" bindtap="selectProject" data-id="{{item.id}}" aria-pressed="{{selected === item.id}}" hover-class="press-feedback">
        <image wx:if="{{item.icon}}" class="nt-icon" src="/assets/tabbar/project-{{item.icon}}.png" aria-hidden="true" />
        <text wx:else class="nt-project-tag" aria-hidden="true">{{item.textLabel}}</text>
        <text class="nt-choice-label">{{item.name}}</text>
      </button>
    </view>
  </view>
</template>
<template name="nt-method-stage-options">
  <view class="nt-method-stage-options {{stages.length ? 'nt-method-stage-options--split' : ''}}">
    <scroll-view scroll-y class="nt-method-stage-column" style="height: {{(methods.length > 5 ? 5 : methods.length) * 34}}px">
      <button wx:for="{{methods}}" wx:key="key" class="nt-choice {{(activeMethod || selectedMethod) === item.key ? 'is-current' : ''}}" data-method="{{item.key}}" bindtap="chooseDifficultyMethod" hover-class="press-feedback" aria-pressed="{{(activeMethod || selectedMethod) === item.key}}">{{item.label}}</button>
    </scroll-view>
    <scroll-view wx:if="{{stages.length}}" scroll-y class="nt-method-stage-column" style="height: {{(stages.length > 5 ? 5 : stages.length) * 34}}px">
      <button wx:for="{{stages}}" wx:key="key" class="nt-choice {{activeMethod === selectedMethod && selectedStage === item.key ? 'is-current' : ''}}" data-stage="{{item.key}}" bindtap="chooseDifficultyStage" disabled="{{stagesDisabled}}" hover-class="press-feedback" aria-pressed="{{activeMethod === selectedMethod && selectedStage === item.key}}">{{item.label}}</button>
    </scroll-view>
  </view>
</template>
<template name="nt-difficulty-colors">
  <view wx:if="{{panel === 'colors'}}" class="nt-difficulty-color-menu">
    <view wx:for="{{groups}}" wx:key="mode" class="nt-difficulty-color-row">
      <text>{{item.label}}</text>
      <view class="nt-difficulty-swatches">
        <button wx:for="{{item.options}}" wx:for-item="option" wx:key="key" class="nt-difficulty-swatch {{selected === option.key ? 'is-current' : ''}}" style="background: {{option.swatch}}" data-key="{{option.key}}" bindtap="chooseDifficultyColor" hover-class="press-feedback" aria-label="{{option.label}}" aria-pressed="{{selected === option.key}}"></button>
      </view>
    </view>
  </view>
</template>
<template name="nt-difficulty-choice-buttons">
  <button wx:if="{{showColors}}" class="nt-control nt-difficulty-palette" bindtap="toggleDifficultyMenu" data-field="colors" disabled="{{colorsDisabled}}" aria-label="{{copy.difficultyColors}}" aria-expanded="{{panel === 'colors'}}" hover-class="press-feedback"><view class="nt-difficulty-swatch" style="background: {{swatch}}"></view></button>
  <button class="nt-control nt-difficulty-method" bindtap="toggleDifficultyMenu" data-field="method" aria-label="{{copy.difficultyMethod}} · {{copy.difficultyStage}}" aria-expanded="{{panel === 'method'}}" hover-class="press-feedback">{{methodLabel}}</button>
</template>
<view data-timer-surface="page" bindtouchstart="pageTimerTouch" class="native-timer nt-theme-{{appearanceScheme}} {{!battle && !netMode ? 'native-timer--solo' : ''}} {{layoutEditing ? 'native-timer--layout-editing' : ''}}" style="{{appearanceStyle}}{{!battle && !netMode && soloViewportHeight ? ';height:' + soloViewportHeight + 'px' : ''}}">
  <view id="nt-navigation-palette" aria-hidden="true"></view>
  <block wx:if="{{!battle && !netMode}}">
  <view data-timer-surface="page" id="nt-toolbar" class="nt-toolbar {{hideChrome ? 'nt-solo-chrome-hidden' : ''}}" aria-hidden="{{hideChrome}}">
    <button class="nt-tool" bindtap="openSheet" data-sheet="solver" disabled="{{busy || layoutEditing || generating || event !== '333' || !scramble}}" aria-label="{{copy.solver}}" hover-class="press-feedback">
      <image class="nt-icon nt-icon-light" src="/assets/tabbar/lightbulb-light.png" aria-hidden="true" />
      <image class="nt-icon nt-icon-dark" src="/assets/tabbar/lightbulb-dark.png" aria-hidden="true" />
    </button>
    <button id="nt-tool-video" class="nt-tool" bindtap="openSheet" data-sheet="video" disabled="{{busy || layoutEditing}}" aria-label="{{copy.sheetTitles.video}}" hover-class="press-feedback">
      <image class="nt-icon nt-icon-light" src="/assets/tabbar/video-light.png" aria-hidden="true" />
      <image class="nt-icon nt-icon-dark" src="/assets/tabbar/video-dark.png" aria-hidden="true" />
    </button>
    <button id="nt-tool-devices" class="nt-tool" bindtap="openDeviceCenter" disabled="{{busy || layoutEditing || !deviceCenter.visible}}" aria-label="{{deviceCenter.ariaLabel || copy.devices}}" hover-class="press-feedback"><image class="nt-icon" src="/assets/tabbar/bluetooth.png" aria-hidden="true" /></button>
    <button id="nt-tool-project" class="nt-tool" bindtap="openSheet" data-sheet="project" disabled="{{busy || layoutEditing || generating}}" aria-label="{{copy.event}} · {{eventName}}" aria-expanded="{{sheet === 'project'}}" hover-class="press-feedback">
      <image wx:if="{{eventIcon}}" class="nt-icon" src="/assets/tabbar/project-{{eventIcon}}.png" aria-hidden="true" /><text wx:else class="nt-project-tag">{{eventTextLabel}}</text>
    </button>
    <button id="nt-tool-content" class="nt-tool" bindtap="openSheet" data-sheet="content" disabled="{{busy || layoutEditing}}" aria-label="{{copy.content}} · {{copy.full}}" aria-expanded="{{sheet === 'content'}}" hover-class="press-feedback">{{copy.full}}</button>
    <button id="nt-tool-source" class="nt-tool" bindtap="openSheet" data-sheet="source" disabled="{{busy || layoutEditing}}" aria-label="{{copy.source}} · {{copy.sourceLabels[source]}}" hover-class="press-feedback">{{copy.sourceLabels[source]}}</button>
    <button id="nt-tool-difficulty" class="nt-tool {{difficultyActive ? 'nt-tool-active' : ''}}" bindtap="openSheet" data-sheet="difficulty" disabled="{{busy || layoutEditing || !canUseDifficulty}}" aria-label="{{copy.difficultyTitle}}" hover-class="press-feedback">{{copy.difficulty}}</button>
    <button class="nt-tool {{layoutEditing ? 'nt-tool-editing' : ''}}" bindtap="toggleLayout" disabled="{{busy}}" aria-label="{{copy.layout}}" aria-pressed="{{layoutEditing}}" hover-class="press-feedback">
      <image class="nt-icon nt-icon-light" src="/assets/tabbar/layout-template-light.png" aria-hidden="true" />
      <image class="nt-icon nt-icon-dark" src="/assets/tabbar/layout-template-dark.png" aria-hidden="true" />
    </button>
    <button class="nt-tool" bindtap="openSheet" data-sheet="settings" disabled="{{busy || layoutEditing}}" aria-label="{{copy.settings}}" hover-class="press-feedback">
      <image class="nt-icon nt-icon-light" src="/assets/tabbar/settings-light.png" aria-hidden="true" />
      <image class="nt-icon nt-icon-dark" src="/assets/tabbar/settings-dark.png" aria-hidden="true" />
    </button>
  </view>
  <view wx:if="{{externalName}}" class="nt-device {{hideChrome ? 'nt-solo-chrome-hidden' : ''}}" aria-hidden="{{hideChrome}}">{{externalName}}</view>
  <text wx:if="{{liveShare.badge}}" class="nt-live-share-status {{hideChrome ? 'nt-solo-chrome-hidden' : ''}}" aria-hidden="{{hideChrome}}" aria-role="status">{{liveShare.badge}}</text>
  <text wx:if="{{error}}" class="nt-error" aria-role="alert">{{error}}</text>
  <button wx:if="{{randomDifficultyStatus === 'error' || randomDifficultyStatus === 'empty' || randomDifficultyStatus === 'rare'}}" class="nt-control" bindtap="retryRandomDifficulty" hover-class="press-feedback">{{copy.retry}}</button>
  <view data-timer-surface="page" class="nt-live-workspace {{liveAnalysis ? 'nt-live-workspace--active' : ''}}">
  <view class="nt-solo-stage {{soloCompactStage ? 'nt-solo-stage--compact' : ''}} {{timingEnabled && !manualEditing && !layoutEditing && !liveAnalysis ? 'nt-solo-stage--anchored' : ''}}" style="padding-top: {{liveAnalysis ? 0 : soloScrambleGap}}px; --nt-solo-timer-gap: {{soloTimerGap}}px; --nt-solo-readout-size: {{soloReadoutSize}}px" data-timer-surface="stage" bindtouchstart="stageTouch" bindtouchmove="stageTouch" bindtouchend="stageTouch" bindtouchcancel="stageTouch">
  <view data-timer-surface="stage" class="nt-solo-scramble" hidden="{{!!liveAnalysis}}">
  <view data-timer-surface="stage" class="nt-solo-scramble-content {{hideChrome ? 'nt-solo-chrome-hidden' : ''}}" aria-hidden="{{hideChrome}}">
  <view data-timer-surface="stage" id="nt-layout-scrambleGap" class="nt-layout-region" style="top: {{timerLayout.scrambleOffsetY}}px">
    <view wx:if="{{manualEditing && !layoutEditing}}">
      <textarea class="nt-draft" value="{{manualText}}" bindinput="inputManualScrambles" bindblur="finishManualScrambles" maxlength="-1" placeholder="{{copy.queuePlaceholder}}" aria-label="{{copy.manualScrambles}}" />
    </view>
    <button wx:else hover-class="press-feedback" class="nt-scramble nt-scramble-font--{{soloScrambleFont}} {{compactScramble ? 'nt-scramble--compact' : ''}}" style="--nt-scramble-scale: {{soloScrambleScale}}; --nt-scramble-length: {{soloScrambleLengthScale}}" bindtap="scrambleTap" data-timer-surface="scramble" disabled="{{generating || (phase === 'running' && settings.scrambleClickAction !== 'start')}}" aria-label="{{scramble}}">{{generating ? copy.loading : event === 'custom' && !scramble ? '—' : scramble}}</button>
    <button wx:if="{{source === 'manual' && !manualEditing && !layoutEditing}}" class="nt-control {{busy ? 'nt-solo-chrome-hidden' : ''}}" aria-hidden="{{busy}}" bindtap="editManualScrambles" hover-class="press-feedback">{{copy.manualScrambles}}</button>
    <template wx:if="{{layoutEditing}}" is="nt-layout-handles" data="{{region: 'scrambleGap', copy: copy}}" />
  </view>
  <view wx:if="{{sourceLine && !timerLayout.hideCompetitionInfo}}" id="nt-layout-sourceGap" class="nt-layout-region" style="margin-top: {{soloSourceGap}}px; top: {{timerLayout.sourceOffsetY}}px">
    <button class="nt-hint nt-source" bindtap="openSheet" data-sheet="wca" style="font-size: calc(var(--solo-source-font-size) * {{soloSourceSize}})" hover-class="press-feedback">
      <template is="nt-country-flag" data="{{flag: competitionSourceFlag}}" />
      <text class="nt-source-title">{{sourceDetails.title}}</text>
      <image wx:if="{{eventIcon}}" class="nt-source-event" src="/assets/tabbar/project-{{eventIcon}}.png" aria-hidden="true" />
      <text>{{sourceDetails.round}}</text>
    </button>
    <template wx:if="{{layoutEditing}}" is="nt-layout-handles" data="{{region: 'sourceGap', copy: copy, canHide: true}}" />
  </view>
  <view wx:if="{{trainerCase}}" class="nt-trainer-case {{hideChrome ? 'nt-solo-chrome-hidden' : ''}}" aria-hidden="{{hideChrome}}">
    <text>{{trainerCase.label}} · {{trainerCase.depth}}</text>
    <button class="nt-control" bindtap="toggleTrainerAnswer" hover-class="press-feedback" disabled="{{busy || trainerBusy}}">{{trainerBusy ? copy.caseSolving : trainerShown ? copy.caseHide : trainerError ? copy.retry : copy.caseAnswer}}</button>
    <text wx:if="{{trainerError}}" class="nt-error" aria-role="status">{{copy.caseError}}</text>
    <text wx:if="{{trainerShown && trainerAnswer}}" class="nt-comment" selectable="{{true}}">{{trainerAnswer.frame}} {{trainerAnswer.notation}}</text>
  </view>
  </view>
  </view>
  <view data-timer-surface="stage" class="nt-clock-region">
    <view data-timer-surface="stage" wx:if="{{timingEnabled}}" id="nt-layout-timerGap" class="nt-layout-region" style="top: {{timerLayout.timerOffsetY}}px">
      <button data-timer-surface="stage" class="nt-clock nt-clock--{{phase}} {{trainingTarget.overshot ? 'nt-target-overshot' : ''}} {{targetPulse ? 'nt-target-pulse-' + targetPulse : ''}}" aria-label="{{hint}}" hover-class="press-feedback">
        <text data-timer-surface="stage" class="nt-time nt-time-font--{{soloReadoutFont}}" style="font-size: {{soloReadoutTextSize}}px">{{display}}</text>
      </button>
      <template wx:if="{{layoutEditing}}" is="nt-layout-handles" data="{{region: 'timerGap', copy: copy}}" />
    </view>
    <button wx:else class="nt-clock nt-manual-entry" bindtap="openSheet" data-sheet="manual" disabled="{{generating || layoutEditing || !canUseCurrentScramble}}" hover-class="press-feedback">{{copy.manualEntry}}</button>
  </view>
  <view data-timer-surface="stage" class="nt-solo-below">
      <view wx:if="{{hasTrainingTarget}}" aria-hidden="{{!trainingTarget}}" class="{{trainingTarget ? '' : 'nt-solo-chrome-hidden'}} nt-training-target nt-training-pill {{trainingTarget.overshot ? 'nt-training-pill--over' : 'nt-training-pill--info'}}">
        <template is="nt-settings-icon" data="{{icon: 'target'}}" />
        <text>{{trainingTarget.label}}</text><text class="nt-training-delta">{{trainingTarget.delta}}</text>
      </view>
      <view data-timer-surface="stage" wx:if="{{showStageSplits || showMemoSplit}}" class="nt-attempt-splits" aria-hidden="{{!attemptSplitChips.length}}">
        <block wx:for="{{attemptSplitChips}}" wx:key="key">
          <button wx:if="{{item.action}}" class="nt-attempt-split nt-attempt-split-action" catchtap="markAttemptSplit" data-mark="{{item.key}}" aria-label="{{item.label}}" hover-class="press-feedback">{{item.label}}</button>
          <text wx:else class="nt-attempt-split {{item.time ? 'nt-attempt-split-done' : ''}}">{{item.label}}{{item.time ? ' ' + item.time : ''}}</text>
        </block>
      </view>
  <view data-timer-surface="stage" wx:if="{{(preview || livePreview) && (!soloCompactStage || livePreview)}}" id="nt-layout-cubeGap" aria-hidden="{{hideChrome}}" class="nt-previews nt-layout-region {{hideChrome ? 'nt-solo-chrome-hidden' : ''}} {{livePreview ? '' : 'nt-layout-preview-frame'}}" style="margin-top: {{soloCubeGap}}px; top: {{timerLayout.cubeOffsetY}}px; --nt-layout-preview-height: {{soloCubeDrawHeight}}px">
