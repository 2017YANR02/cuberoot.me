<view class="native-timer" style="{{appearanceStyle}}">
  <view class="nt-toolbar" hidden="{{hideChrome}}">
    <button class="nt-control" bindtap="connectCube" disabled="{{busy}}" aria-label="{{copy.bluetooth}}" hover-class="press-feedback"><image class="nt-icon" src="/assets/tabbar/bluetooth.png" aria-hidden="true" /></button>
    <picker mode="selector" range="{{events}}" range-key="name" value="{{eventIndex}}" bindchange="selectEvent" disabled="{{busy || generating}}">
      <view class="nt-control nt-event">{{eventName}}</view>
    </picker>
    <picker range="{{copy.sourceOptions}}" value="{{sourceIndex}}" bindchange="selectSource" disabled="{{busy || generating}}" aria-label="{{copy.source}}"><view class="nt-control">{{copy.sourceOptions[sourceIndex]}}</view></picker>
    <button class="nt-control" bindtap="openSheet" data-sheet="settings" disabled="{{busy}}" aria-label="{{copy.settings}}" hover-class="press-feedback"><image class="nt-icon" src="/assets/tabbar/settings-2.png" aria-hidden="true" /></button>
  </view>
  <view wx:if="{{deviceName}}" hidden="{{hideChrome}}" class="nt-device">{{deviceName}} <text wx:if="{{battery !== null}}"> · {{battery}}%</text></view>
  <view wx:if="{{externalName}}" hidden="{{hideChrome}}" class="nt-device">{{externalName}}</view>
  <text wx:if="{{error}}" class="nt-error" aria-role="alert">{{error}}</text>
  <button hover-class="press-feedback" hidden="{{hideChrome}}" class="nt-scramble {{compactScramble ? 'nt-scramble--compact' : ''}}" style="font-size: {{scrambleFontSize}}rpx" bindtap="scrambleTap" bindtouchstart="scrambleDown" bindtouchend="scrambleUp" bindtouchcancel="timerCancel" disabled="{{generating || phase === 'running'}}" aria-label="{{scramble}}">{{generating ? copy.loading : scramble}}</button>
  <text wx:if="{{sourceLine}}" hidden="{{hideChrome}}" class="nt-hint nt-source">{{sourceLine}}</text>
  <button wx:if="{{settings.timingEnabled !== false}}" class="nt-clock nt-clock--{{phase}}" bindtouchstart="timerDown" bindtouchend="timerUp" bindtouchcancel="timerCancel" aria-label="{{hint}}" hover-class="press-feedback">
    <text class="nt-time" style="font-size: {{timerFontSize}}rpx">{{display}}</text>
  </button>
  <button wx:else class="nt-clock nt-manual-entry" bindtap="openSheet" data-sheet="manual" disabled="{{generating}}" hover-class="press-feedback">{{copy.manualEntry}}</button>
  <view wx:if="{{preview || livePreview}}" hidden="{{hideChrome}}" class="nt-previews">
    <view wx:if="{{preview}}" class="nt-preview"><image mode="aspectFit" src="{{preview}}" binderror="imageError" aria-label="{{copy.preview}}" /><text wx:if="{{cubeConnected}}" class="nt-hint">{{copy.preview}}</text></view>
    <view wx:if="{{livePreview}}" class="nt-preview"><image mode="aspectFit" src="{{livePreview}}" binderror="imageError" aria-label="{{copy.live}}" /><text class="nt-hint">{{copy.live}}</text></view>
  </view>
  <text wx:if="{{previewError}}" class="nt-error">{{previewError}}</text>
  <text wx:if="{{cubeConnected}}" hidden="{{hideChrome}}" class="nt-hint nt-cube-hint">{{guidance}}</text>
  <button hover-class="press-feedback" wx:if="{{phase === 'ready' || phase === 'inspecting'}}" class="nt-control" bindtap="cancelAttempt">{{copy.cancel}}</button>
  <view class="nt-footer" hidden="{{hideChrome}}">
    <button class="nt-control" bindtap="previousScramble" disabled="{{busy || generating || !canPrevious}}" aria-label="{{copy.previous}}" hover-class="press-feedback"><image class="nt-icon" src="/assets/tabbar/chevron-left.png" aria-hidden="true" /></button>
    <button class="nt-control" bindtap="openSheet" data-sheet="history" disabled="{{busy}}" hover-class="press-feedback">{{copy.results}}</button>
    <button class="nt-control" bindtap="nextScramble" disabled="{{busy || generating}}" aria-label="{{copy.next}}" hover-class="press-feedback"><image class="nt-icon" src="/assets/tabbar/chevron-right.png" aria-hidden="true" /></button>
  </view>
  <button hover-class="press-feedback" hidden="{{hideChrome}}" class="nt-stats" bindtap="openSheet" data-sheet="statistics" disabled="{{busy}}">
    <block wx:if="{{summary.count}}"><text>{{summary.solved}}/{{summary.count}}</text><text>{{copy.mean}} {{summary.mean}}</text><text>{{copy.best}} {{summary.best}}</text><text>mo3 {{summary.mo3}}</text><text>ao5 {{summary.ao5}}</text><text>ao12 {{summary.ao12}}</text></block>
    <text wx:else>{{copy.statistics}}</text>
  </button>
  <text wx:if="{{rankLine}}" hidden="{{hideChrome}}" class="nt-rank" aria-label="{{copy.rankHint}}">{{rankLine}}</text>
  <view wx:if="{{sheet}}" id="nt-backdrop" class="nt-backdrop" bindtap="closeSheet">
    <view class="nt-sheet">
      <view class="nt-sheet-header"><text>{{sheet === 'wca' ? copy.wca : sheet === 'settings' ? copy.settings : sheet === 'manual' ? copy.manualEntry : sheet === 'scrambles' ? copy.manualScrambles : sheet === 'create' ? copy.newSession : sheet === 'rename' ? copy.rename : sheet === 'comment' ? copy.comment : sheet === 'restore' ? copy.restore : sheet === 'import' ? copy.import : sheet === 'statistics' ? copy.statistics : sheet === 'detail' ? copy.detail : copy.results}}</text><button hover-class="press-feedback" class="nt-control" bindtap="closeSheet">{{copy.close}}</button></view>
      <scroll-view scroll-y="{{true}}" class="nt-sheet-content">
      <block wx:if="{{sheet === 'settings'}}">
        <picker range="{{settingsCategories}}" value="{{settingsCategoryIndex}}" bindchange="selectSettingsCategory"><view class="nt-category">{{settingsCategories[settingsCategoryIndex]}}</view></picker>
        <block wx:if="{{settingsCategory === 'timer'}}">
        <view class="nt-setting"><text>{{copy.inspectionSetting}}</text><picker range="{{inspectionOptions}}" value="{{inspectionIndex}}" data-setting="inspection" bindchange="changeSetting"><view class="nt-control">{{inspectionOptions[inspectionIndex]}}</view></picker></view>
        <view class="nt-setting"><text>{{copy.holdSetting}}</text><picker range="{{holdOptions}}" value="{{holdIndex}}" data-setting="hold" bindchange="changeSetting"><view class="nt-control">{{holdOptions[holdIndex]}}</view></picker></view>
        </block>
        <block wx:if="{{settingsCategory === 'appearance'}}">
        <view class="nt-setting"><text>{{copy.tapSetting}}</text><picker range="{{copy.tapOptions}}" value="{{tapIndex}}" data-setting="tap" bindchange="changeSetting"><view class="nt-control">{{copy.tapOptions[tapIndex]}}</view></picker></view>
        </block>
        <block wx:for="{{settingRows}}" wx:key="key"><view wx:if="{{item.category === settingsCategory}}" class="nt-setting"><text>{{item.label}}</text><switch wx:if="{{item.boolean}}" checked="{{item.checked}}" disabled="{{busy}}" aria-label="{{item.label}}" data-setting="{{item.key}}" bindchange="toggleSetting" /><picker wx:else range="{{item.labels}}" value="{{item.index}}" data-setting="{{item.key}}" bindchange="changeSetting"><view class="nt-control">{{item.value}}</view></picker></view></block>
        <block wx:if="{{settingsCategory === 'appearance'}}">
        <view class="nt-setting"><text>{{copy.rankScopes}}</text><view class="nt-actions"><button hover-class="press-feedback" wx:for="{{rankScopes}}" wx:key="scope" class="nt-control" data-scope="{{item.scope}}" bindtap="toggleRankScope">{{item.scope}}{{item.selected ? ' ✓' : ''}}</button></view></view>
        <view class="nt-setting"><text>{{copy.rankCountry}}</text><picker range="{{rankCountries}}" value="{{rankCountryIndex}}" bindchange="changeRankCountry"><view class="nt-control">{{rankCountries[rankCountryIndex]}}</view></picker></view>
        </block>
        <block wx:if="{{settingsCategory === 'data'}}">
        <view class="nt-setting"><text>{{copy.session}}</text><picker range="{{sessions}}" range-key="name" value="{{sessionIndex}}" bindchange="selectSession"><view class="nt-control">{{sessions[sessionIndex].name}}</view></picker></view>
        <view class="nt-actions"><button hover-class="press-feedback" class="nt-control" bindtap="sessionAction" data-action="create">{{copy.newSession}}</button><button hover-class="press-feedback" class="nt-control" bindtap="sessionAction" data-action="rename">{{copy.rename}}</button><button hover-class="press-feedback" class="nt-control" bindtap="sessionAction" data-action="clear">{{copy.clearSession}}</button><button hover-class="press-feedback" class="nt-control" bindtap="sessionAction" data-action="delete" disabled="{{sessions.length < 2}}">{{copy.deleteSession}}</button></view>
        <button hover-class="press-feedback" class="nt-control" bindtap="openSheet" data-sheet="manual">{{copy.manualEntry}}</button>
        <view class="nt-actions"><button hover-class="press-feedback" class="nt-control" bindtap="exportBackup">{{copy.backup}}</button><button hover-class="press-feedback" class="nt-control" bindtap="openSheet" data-sheet="restore">{{copy.restore}}</button><button hover-class="press-feedback" class="nt-control" bindtap="openSheet" data-sheet="import">{{copy.import}}</button></view>
        <view class="nt-actions"><button hover-class="press-feedback" class="nt-control" bindtap="cloudBackup" data-action="upload" disabled="{{cloudBusy}}">{{copy.cloudUpload}}</button><button hover-class="press-feedback" class="nt-control" bindtap="cloudBackup" data-action="download" disabled="{{cloudBusy}}">{{copy.cloudDownload}}</button></view>
        </block>
        <block wx:if="{{settingsCategory === 'scramble'}}">
        <view class="nt-setting"><button hover-class="press-feedback" class="nt-control" bindtap="randomScrambles">{{copy.random}}{{source === 'random' ? ' ✓' : ''}}</button><button hover-class="press-feedback" class="nt-control" bindtap="openSheet" data-sheet="scrambles">{{copy.manualScrambles}}{{source === 'manual' ? ' ✓' : ''}}</button></view>
        <button hover-class="press-feedback" class="nt-control" bindtap="openSheet" data-sheet="wca">{{copy.wca}}{{source === 'wca' ? ' ✓' : ''}}</button>
        </block>
        <block wx:if="{{settingsCategory === 'smart-cube'}}">
        <button hover-class="press-feedback" class="nt-control" bindtap="connectCube">{{cubeConnected ? copy.disconnect : copy.bluetooth}}</button>
        <button hover-class="press-feedback" wx:if="{{canResetCube}}" disabled="{{calibrating}}" class="nt-control" bindtap="calibrateCube">{{copy.calibrate}}</button>
        <button hover-class="press-feedback" class="nt-control" bindtap="connectExternalTimer">{{externalConnected ? copy.disconnect : copy.externalTimer}}</button>
        </block>
      </block>
      <block wx:elif="{{sheet === 'wca'}}">
        <picker range="{{copy.wcaModes}}" value="{{settings.wcaScrambleMode === 'comp' ? 0 : 1}}" data-setting="mode" bindchange="changeWca"><view class="nt-control">{{settings.wcaScrambleMode === 'comp' ? copy.wcaModes[0] : copy.wcaModes[1]}}</view></picker>
        <block wx:if="{{settings.wcaScrambleMode === 'comp'}}">
          <view class="nt-setting"><text>{{settings.wcaCompName || copy.all}}</text><button hover-class="press-feedback" wx:if="{{settings.wcaComp}}" class="nt-control" bindtap="clearWca" data-setting="comp">{{copy.clear}}</button></view>
          <view class="nt-setting nt-search"><input value="{{competitionQuery}}" placeholder="{{copy.competitionSearch}}" bindinput="wcaSearch" /><button hover-class="press-feedback" class="nt-control {{competitionQuery ? '' : 'nt-clear-empty'}}" disabled="{{!competitionQuery}}" bindtap="clearCompetitionSearch">{{copy.clear}}</button></view>
          <button hover-class="press-feedback" wx:for="{{competitionMatches}}" wx:key="id" class="nt-result" data-id="{{item.id}}" bindtap="pickCompetition"><text>{{item.displayName}}</text><text class="nt-hint">{{item.startDate}}</text></button>
          <view class="nt-setting"><text>{{copy.round}}</text><picker range="{{roundLabels}}" value="{{roundIndex}}" data-setting="round" bindchange="changeWca"><view class="nt-control">{{roundLabels[roundIndex]}}</view></picker></view>
          <view class="nt-setting"><text>{{copy.group}}</text><picker range="{{groupLabels}}" value="{{groupIndex}}" data-setting="group" bindchange="changeWca"><view class="nt-control">{{groupLabels[groupIndex]}}</view></picker></view>
        </block>
        <block wx:else>
          <view class="nt-setting"><text>{{copy.from}}</text><picker mode="date" value="{{settings.wcaDateFrom}}" data-setting="from" bindchange="changeWca"><view class="nt-control">{{settings.wcaDateFrom || copy.all}}</view></picker></view>
          <view class="nt-setting"><text>{{copy.to}}</text><picker mode="date" value="{{settings.wcaDateTo}}" data-setting="to" bindchange="changeWca"><view class="nt-control">{{settings.wcaDateTo || copy.all}}</view></picker></view>
          <button hover-class="press-feedback" class="nt-control" bindtap="clearWca" data-setting="dates">{{copy.clear}}</button>
        </block>
        <text wx:if="{{formError}}" class="nt-error">{{formError}}</text>
        <button hover-class="press-feedback" class="nt-control" bindtap="wcaScrambles">{{copy.wca}}</button>
      </block>
      <block wx:elif="{{sheet === 'history'}}">
        <view class="nt-setting nt-search"><input value="{{historyQuery}}" placeholder="{{copy.search}}" bindinput="searchHistory" /><button hover-class="press-feedback" class="nt-control {{historyQuery ? '' : 'nt-clear-empty'}}" disabled="{{!historyQuery}}" bindtap="clearHistorySearch">{{copy.clear}}</button></view>
        <view class="nt-actions"><button hover-class="press-feedback" class="nt-control" bindtap="exportResults" disabled="{{!summary.count}}">{{copy.export}}</button><button hover-class="press-feedback" class="nt-control" bindtap="exportResults" data-format="cstimer" disabled="{{!summary.count}}">csTimer JSON</button><button hover-class="press-feedback" class="nt-control" bindtap="exportResults" data-format="speedstacks" disabled="{{!summary.count}}">Speedstacks</button><button hover-class="press-feedback" class="nt-control" bindtap="openSheet" data-sheet="manual">{{copy.manualEntry}}</button></view>
          <text wx:if="{{!summary.count}}" class="nt-hint">{{copy.empty}}</text>
          <text wx:elif="{{!summary.filteredCount}}" class="nt-hint">{{copy.noMatches}}</text>
          <button hover-class="press-feedback" wx:for="{{summary.rows}}" wx:key="id" class="nt-result" data-id="{{item.id}}" bindtap="editResult"><view class="nt-result-title"><text>{{summary.filteredCount - index}}</text><text>{{item.result}}{{item.penalty === '+2' ? ' (+2)' : ''}}</text></view><text class="nt-result-scramble">{{item.scramble}}</text><text wx:if="{{item.comment}}" class="nt-hint">{{item.comment}}</text></button>
        <button hover-class="press-feedback" wx:if="{{summary.rows.length < summary.filteredCount}}" class="nt-control" bindtap="loadMoreHistory">{{copy.more}}</button>
      </block>
      <block wx:elif="{{sheet === 'statistics'}}">
        <picker range="{{copy.statsRanges}}" value="{{statsRangeIndex}}" bindchange="selectStatsRange"><view class="nt-category">{{copy.statsRanges[statsRangeIndex]}}</view></picker>
        <text wx:if="{{!statistics.count}}" class="nt-hint">{{copy.empty}}</text>
        <block wx:else>
          <view class="nt-setting"><text>{{copy.count}}</text><text>{{statistics.solved}}/{{statistics.count}}</text></view>
          <view class="nt-setting"><text>{{copy.mean}}</text><text>{{statistics.mean}}</text></view>
          <view class="nt-setting"><text>{{copy.best}}</text><text>{{statistics.best}}</text></view>
          <view class="nt-setting"><text>{{copy.worst}}</text><text>{{statistics.worst}}</text></view>
          <view class="nt-setting"><text>{{copy.deviation}}</text><text>{{statistics.sd}}</text></view>
          <view class="nt-stat-row nt-hint"><text></text><text>{{copy.current}}</text><text>{{copy.best}}</text></view>
          <view wx:for="{{statistics.rows}}" wx:key="key" class="nt-stat-row"><text>{{item.key}}</text><text>{{item.current}}</text><text>{{item.best}}</text></view>
          <text class="nt-category">{{copy.distribution}}</text>
          <view wx:if="{{statistics.distribution.length}}" class="nt-histogram">
            <view wx:for="{{statistics.distribution}}" wx:key="index" class="nt-histogram-column" aria-label="{{item.label}}"><view wx:if="{{item.count}}" class="nt-histogram-bar" style="height: {{item.height}}%"><text>{{item.count}}</text></view></view>
          </view>
          <view wx:if="{{statistics.distribution.length}}" class="nt-chart-axis nt-hint"><text>{{statistics.distributionMin}}</text><text>{{statistics.distributionMax}}</text></view>
          <text wx:else class="nt-hint">{{copy.distributionEmpty}}</text>
        </block>
      </block>
      <block wx:elif="{{sheet === 'detail'}}">
        <text class="nt-detail-time" selectable="{{true}}">{{detail.result}}</text><text class="nt-hint">{{detail.date}}</text>
        <view class="nt-setting"><text>{{copy.event}}</text><text>{{detail.eventName}}</text></view>
        <view class="nt-setting"><text>{{copy.rawTime}}</text><text>{{detail.rawTime}}</text></view>
        <view class="nt-setting"><text>{{copy.penalty}}</text><picker range="{{penaltyLabels}}" value="{{penaltyIndex}}" bindchange="changeDetailPenalty"><view class="nt-control">{{penaltyLabels[penaltyIndex]}}</view></picker></view>
        <view wx:if="{{detail.inspection}}" class="nt-setting"><text>{{copy.inspectionTime}}</text><text>{{detail.inspection}}</text></view>
        <view wx:if="{{detail.deviceName}}" class="nt-setting"><text>{{copy.device}}</text><text>{{detail.deviceName}}</text></view>
        <view wx:if="{{detail.source}}" class="nt-setting"><text>{{copy.source}}</text><text>{{detail.source}}</text></view>
        <text class="nt-result-scramble" selectable="{{true}}">{{detail.scramble}}</text><text wx:if="{{detail.comment}}" class="nt-comment" selectable="{{true}}">{{detail.comment}}</text>
        <view wx:if="{{detailPreview}}" class="nt-previews"><view class="nt-preview"><image mode="aspectFit" src="{{detailPreview}}" binderror="detailImageError" aria-label="{{copy.preview}}" /></view></view>
        <text wx:if="{{detailPreviewError}}" class="nt-error">{{detailPreviewError}}</text>
        <block wx:if="{{detail.stages.length}}">
          <text class="nt-category">{{copy.stageSplits}}</text>
          <view class="nt-stat-row nt-hint"><text></text><text>{{copy.duration}}</text><text>{{copy.cumulative}}</text></view>
          <view wx:for="{{detail.stages}}" wx:key="id" class="nt-stat-row"><text>{{item.label}}</text><text>{{item.duration}}</text><text>{{item.cumulative}}</text></view>
        </block>
        <block wx:if="{{detail.memo}}">
          <view class="nt-setting"><text>{{copy.memo}}</text><text>{{detail.memo}}</text></view>
          <view class="nt-setting"><text>{{copy.execution}}</text><text>{{detail.execution}}</text></view>
        </block>
        <view class="nt-actions"><button hover-class="press-feedback" wx:for="{{resultActions}}" wx:key="id" class="nt-control" bindtap="resultAction" data-action="{{item.id}}">{{item.title}}</button></view>
        <picker wx:if="{{moveTargets.length}}" range="{{moveTargets}}" range-key="name" bindchange="moveResult"><view class="nt-control">{{copy.moveSession}}</view></picker>
      </block>
      <block wx:else>
        <textarea class="nt-draft" value="{{draft}}" bindinput="draftInput" maxlength="-1" placeholder="{{sheet === 'scrambles' ? copy.queuePlaceholder : sheet === 'manual' ? copy.manualPlaceholder : copy.session}}" />
        <text wx:if="{{formError}}" class="nt-error">{{formError}}</text>
        <view class="nt-actions"><button hover-class="press-feedback" class="nt-control" bindtap="clearDraft">{{copy.clear}}</button><button hover-class="press-feedback" class="nt-control" bindtap="saveDraft">{{copy.save}}</button></view>
      </block>
      </scroll-view>
    </view>
  </view>
</view>
