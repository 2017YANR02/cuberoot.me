page {
  --cr-light-bg: #fafafa;
  --cr-light-surface: #ffffff;
  --cr-light-text: #171717;
  --cr-light-muted: #737373;
  --cr-light-faint: #a3a3a3;
  --cr-light-line: #e5e5e5;
  --cr-light-accent: #a94f31;
  --cr-light-accent-soft: #f4e7e1;
  --cr-light-ready: #2f7d4a;
  --cr-light-danger: #b33a3a;
  --cr-dark-bg: #111111;
  --cr-dark-surface: #191919;
  --cr-dark-text: #f5f5f5;
  --cr-dark-muted: #a3a3a3;
  --cr-dark-faint: #737373;
  --cr-dark-line: #303030;
  --cr-dark-accent: #d47a58;
  --cr-dark-accent-soft: #35241e;
  --cr-dark-ready: #67b580;
  --cr-dark-danger: #e47777;
  --cr-bg: var(--cr-light-bg);
  --cr-surface: var(--cr-light-surface);
  --cr-text: var(--cr-light-text);
  --cr-muted: var(--cr-light-muted);
  --cr-faint: var(--cr-light-faint);
  --cr-line: var(--cr-light-line);
  --cr-accent: var(--cr-light-accent);
  --cr-accent-soft: var(--cr-light-accent-soft);
  --cr-ready: var(--cr-light-ready);
  --cr-danger: var(--cr-light-danger);
  background: var(--cr-bg);
  color: var(--cr-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 30rpx;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

@media (prefers-color-scheme: dark) {
  page {
    --cr-bg: var(--cr-dark-bg);
    --cr-surface: var(--cr-dark-surface);
    --cr-text: var(--cr-dark-text);
    --cr-muted: var(--cr-dark-muted);
    --cr-faint: var(--cr-dark-faint);
    --cr-line: var(--cr-dark-line);
    --cr-accent: var(--cr-dark-accent);
    --cr-accent-soft: var(--cr-dark-accent-soft);
    --cr-ready: var(--cr-dark-ready);
    --cr-danger: var(--cr-dark-danger);
  }
}

.native-tab-surface { min-height: 100vh; background: var(--cr-bg); color: var(--cr-text); }

button {
  background: transparent;
  border-radius: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
  margin: 0;
  padding: 0;
}

button::after {
  border: 0;
}

.press-feedback {
  opacity: 0.62;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 36rpx calc(48rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: var(--cr-accent);
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 0.08em;
}

.page-title {
  display: block;
  font-size: 52rpx;
  font-weight: 720;
  letter-spacing: -0.035em;
  line-height: 1.15;
  margin-top: 12rpx;
}

.page-intro {
  color: var(--cr-muted);
  display: block;
  line-height: 1.65;
  margin-top: 20rpx;
  overflow-wrap: anywhere;
}

.primary-button {
  align-items: center;
  background: var(--cr-text);
  border-radius: 999rpx;
  color: var(--cr-bg);
  display: flex;
  font-weight: 650;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 36rpx;
}

.primary-button[disabled] {
  opacity: 0.45;
}

.text-button {
  align-items: center;
  color: var(--cr-accent);
  display: inline-flex;
  font-size: 26rpx;
  font-weight: 620;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 8rpx;
}

.status-text {
  color: var(--cr-muted);
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  margin-top: 24rpx;
  overflow-wrap: anywhere;
}

.status-text--error {
  color: var(--cr-danger);
}

.web-status {
  padding-top: 96rpx;
}

.web-login-page {
  padding-top: 112rpx;
}

.web-login-button {
  margin-top: 56rpx;
  width: 100%;
}

.web-login-logo {
  border-radius: 12rpx;
  flex: none;
  height: 48rpx;
  margin-right: 16rpx;
  width: 48rpx;
}

.web-status-spinner {
  animation: web-status-spin 0.9s linear infinite;
  border: 5rpx solid var(--cr-line);
  border-radius: 50%;
  border-top-color: var(--cr-accent);
  box-sizing: border-box;
  height: 54rpx;
  margin-bottom: 28rpx;
  width: 54rpx;
}

@keyframes web-status-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .web-status-spinner {
    animation: none;
  }
}

.retry-button {
  margin-top: 28rpx;
}

/* Match SiteBackground's fixed landscape and token-based readability overlay. */
.native-scenery {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.native-scenery-image {
  position: absolute;
  inset: 0;
  background-image: var(--cr-scene-image, none);
  background-size: cover;
  background-position: var(--cr-scene-position, 50%) top;
  filter: var(--cr-scene-filter, none);
}

.native-scenery::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom,
    color-mix(in srgb, var(--cr-bg) 72%, transparent),
    color-mix(in srgb, var(--cr-bg) 16%, transparent) 18%,
    color-mix(in srgb, var(--cr-bg) 48%, transparent) 42%,
    color-mix(in srgb, var(--cr-bg) 48%, transparent) 100%);
}

.page { position: relative; z-index: 1; }
