page {
  --cr-bg: #fafafa;
  --cr-surface: #ffffff;
  --cr-text: #171717;
  --cr-muted: #737373;
  --cr-faint: #a3a3a3;
  --cr-line: #e5e5e5;
  --cr-accent: #a94f31;
  --cr-accent-soft: #f4e7e1;
  --cr-ready: #2f7d4a;
  --cr-danger: #b33a3a;
  background: var(--cr-bg);
  color: var(--cr-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 30rpx;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

@media (prefers-color-scheme: dark) {
  page {
    --cr-bg: #111111;
    --cr-surface: #191919;
    --cr-text: #f5f5f5;
    --cr-muted: #a3a3a3;
    --cr-faint: #737373;
    --cr-line: #303030;
    --cr-accent: #d47a58;
    --cr-accent-soft: #35241e;
    --cr-ready: #67b580;
    --cr-danger: #e47777;
  }
}

button {
  background: transparent;
  border-radius: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
  margin: 0;
  padding: 0;
}

button::after {
  border: 0;
}

.press-feedback {
  opacity: 0.62;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 36rpx calc(48rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: var(--cr-accent);
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 0.08em;
}

.page-title {
  display: block;
  font-size: 52rpx;
  font-weight: 720;
  letter-spacing: -0.035em;
  line-height: 1.15;
  margin-top: 12rpx;
}

.page-intro {
  color: var(--cr-muted);
  display: block;
  line-height: 1.65;
  margin-top: 20rpx;
  overflow-wrap: anywhere;
}

.primary-button {
  align-items: center;
  background: var(--cr-text);
  border-radius: 999rpx;
  color: var(--cr-bg);
  display: flex;
  font-weight: 650;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 36rpx;
}

.primary-button[disabled] {
  opacity: 0.45;
}

.text-button {
  align-items: center;
  color: var(--cr-accent);
  display: inline-flex;
  font-size: 26rpx;
  font-weight: 620;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 8rpx;
}

.status-text {
  color: var(--cr-muted);
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  margin-top: 24rpx;
  overflow-wrap: anywhere;
}

.status-text--error {
  color: var(--cr-danger);
}

.web-status {
  padding-top: 96rpx;
}

.web-status-spinner {
  animation: web-status-spin 0.9s linear infinite;
  border: 5rpx solid var(--cr-line);
  border-radius: 50%;
  border-top-color: var(--cr-accent);
  box-sizing: border-box;
  height: 54rpx;
  margin-bottom: 28rpx;
  width: 54rpx;
}

@keyframes web-status-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .web-status-spinner {
    animation: none;
  }
}

.retry-button {
  margin-top: 28rpx;
}
