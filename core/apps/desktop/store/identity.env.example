# Copy to .local-data/windows-store/identity.env at the repository root.
# Copy all three identity values EXACTLY from Partner Center Product identity.
# Quote values containing spaces or commas. Do not use the company name as a guessed Publisher CN.
WINDOWS_STORE_IDENTITY_NAME=
WINDOWS_STORE_PUBLISHER=
WINDOWS_STORE_PUBLISHER_DISPLAY_NAME=
# Choose a version greater than every previous submission: Major.Minor.Build.0.
WINDOWS_STORE_VERSION=
