# Copy to .env.android-push.local (ignored). Never put server credentials here.
# Existing shell variables take precedence. Empty groups mean disabled.
ANDROID_PUSH_REQUIRED=false
# Optional required vendor list: oppo,vivo,xiaomi,meizu,honor
ANDROID_PUSH_VENDORS=
GETUI_APP_ID=
GETUI_OPPO_APP_KEY=
GETUI_OPPO_APP_SECRET=
GETUI_VIVO_APP_ID=
GETUI_VIVO_APP_KEY=
GETUI_XIAOMI_APP_ID=
GETUI_XIAOMI_APP_KEY=
GETUI_MEIZU_APP_ID=
GETUI_MEIZU_APP_KEY=
GETUI_HONOR_APP_ID=
# Debug belongs to a separate provider app/package; never reuse release IDs.
GETUI_DEBUG_APP_ID=
GETUI_DEBUG_OPPO_APP_KEY=
GETUI_DEBUG_OPPO_APP_SECRET=
GETUI_DEBUG_VIVO_APP_ID=
GETUI_DEBUG_VIVO_APP_KEY=
GETUI_DEBUG_XIAOMI_APP_ID=
GETUI_DEBUG_XIAOMI_APP_KEY=
GETUI_DEBUG_MEIZU_APP_ID=
GETUI_DEBUG_MEIZU_APP_KEY=
GETUI_DEBUG_HONOR_APP_ID=
