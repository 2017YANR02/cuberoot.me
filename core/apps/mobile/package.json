{
  "name": "@cuberoot/mobile",
  "version": "0.1.0",
  "private": true,
  "cuberoot": {
    "kind": "app"
  },
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/build-cubing-worker.mjs apps/mobile/public/cubing-chunks && vite --host 127.0.0.1",
    "build": "node ../../scripts/build-cubing-worker.mjs apps/mobile/public/cubing-chunks && vite build",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "assets:android": "node scripts/gen-android-assets.mjs",
    "assets:ios": "node scripts/gen-ios-assets.mjs",
    "cap:add:android": "cap add android",
    "cap:sync": "pnpm cap:sync:android",
    "cap:sync:android": "pnpm build && cap sync android",
    "cap:sync:ios": "pnpm build && cap sync ios",
    "android:open": "cap open android",
    "android:run": "pnpm cap:sync:android && cap run android",
    "ios:doctor": "node ../../scripts/mobile-ios-toolchain.mjs doctor",
    "ios:build": "pnpm cap:sync:ios && node ../../scripts/mobile-ios-toolchain.mjs build",
    "ios:open": "cap open ios",
    "ios:run": "pnpm ios:doctor && pnpm cap:sync:ios && cap run ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/network": "8.0.1",
    "@cuberoot/app-ui": "workspace:*",
    "@cuberoot/event-icon": "workspace:*",
    "@cuberoot/puzzle-solvers": "workspace:*",
    "@cuberoot/shared": "workspace:*",
    "@cuberoot/timer-ui": "workspace:*",
    "@cuberoot/visualcube": "workspace:*",
    "lucide-react": "1.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "7.0.0-dev.20260517.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5",
    "vite": "8.0.1",
    "vitest": "^4.1.6"
  }
}
