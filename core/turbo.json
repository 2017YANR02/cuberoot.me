{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev:build": {
      "dependsOn": ["^dev:build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "dev:serve": {
      "dependsOn": ["^dev:build"],
      "cache": false,
      "persistent": true
    },
    "dev:serve:safe": {
      "dependsOn": ["^dev:build"],
      "cache": false,
      "persistent": true
    },
    "build:ci": {
      "dependsOn": ["^build:ci"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/../.node-version",
        "$TURBO_ROOT$/packages/stack-kernel/pkg/**"
      ],
      "outputs": ["dist/**", "*.tsbuildinfo"],
      "env": ["NODE_ENV"]
    },
    "@cuberoot/client#test:ci": {
      "cache": false,
      "passThroughEnv": ["CHECK_CITY_TRANSLATION_COVERAGE"]
    }
  }
}
