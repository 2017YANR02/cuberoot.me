{
  "name": "@cuberoot/stats-build",
  "version": "0.1.0",
  "private": true,
  "cuberoot": {
    "kind": "job"
  },
  "type": "module",
  "scripts": {
    "backup:recon": "tsx src/bin/backup_recon.ts",
    "build:deps": "pnpm --filter @cuberoot/shared build",
    "compute": "tsx src/bin/compute.ts",
    "compute:all": "tsx src/bin/compute_all.ts",
    "validate-queries": "tsx src/bin/validate_queries.ts",
    "nemesizer": "tsx src/bin/nemesizer.ts",
    "gen-persons-search": "tsx src/bin/gen_persons_search.ts",
    "build:scramble-lengths": "tsx src/bin/build_scramble_lengths.ts",
    "typecheck": "tsgo --noEmit",
    "test": "pnpm run build:deps && vitest run tests"
  },
  "dependencies": {
    "@cuberoot/shared": "workspace:*",
    "mysql2": "^3.11.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260517.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.6"
  }
}
