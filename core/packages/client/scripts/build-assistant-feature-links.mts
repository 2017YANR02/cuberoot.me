// Compile navigation labels from the same registries that render the views.
// The API can ship independently of Next, including on a cold start.
import { writeFileSync } from 'node:fs';
import { basename } from 'node:path';
import { WCA_STAT_PAGE_IDS } from '@cuberoot/shared/wca-stat-catalog';
import { LBL_STEPS } from '../app/[lang]/tutorial/lbl/content';
import { F2L_NAV_CHAPTERS } from '../app/[lang]/tutorial/f2l/data/chapters';
import { REG_ARTICLES } from '../app/[lang]/regulation/_data/articles';
import { fetchWcaStatIndex, type StatEntry } from '../lib/wca-stat-index';
import { PLATFORM_ROUTES } from '../lib/platform-routes';
import { ALL_PUZZLE_TYPE_OPTIONS } from '../app/[lang]/sim/puzzleOptions';
import { TOC } from '../app/[lang]/math/group/_data/toc';
import { STACK_TOOLS_META } from '../app/[lang]/dev/stack/_lib/stack_meta';
import { LLM_TOOLS_META } from '../app/[lang]/dev/llm/_lib/llm_meta';
import { RECOGNITION_TRAINING_SETS } from '@cuberoot/shared/timer';
import { solverDestinations } from './build-assistant-index';

export function assistantFeatureLinks(statistics: readonly Pick<StatEntry, 'id' | 'titleZh' | 'titleEn'>[]): Array<readonly [string, string, string]> {
  const links: Array<readonly [string, string, string]> = [];
  for (const puzzle of ALL_PUZZLE_TYPE_OPTIONS) {
    const id = puzzle.value === 'nxn' ? '3' : puzzle.value;
    links.push(['/sim?puzzle=' + encodeURIComponent(id), puzzle.labelZh + '模拟器', puzzle.labelEn + ' simulator']);
  }
  for (const section of TOC) links.push(['/math/group/' + section.id, section.zh, section.en]);
  for (const tool of STACK_TOOLS_META) links.push(['/dev/stack/' + tool.slug, tool.name, tool.name]);
  for (const tool of LLM_TOOLS_META) links.push(['/dev/llm/' + tool.slug, tool.name, tool.name]);
  for (const [set, title] of Object.entries(RECOGNITION_TRAINING_SETS)) {
    if (set === 'sq1-shape') continue; // The exported /recognize/[algSetId] wrapper has six sets.
    links.push(['/recognize/' + set, title.zh, title.en]);
  }
  const solvers = solverDestinations();
  const englishSolvers = new Map(solvers.filter(s => s.lang === 'en').map(s => [s.href, s.title]));
  for (const s of solvers.filter(s => s.lang === 'zh')) {
    links.push([s.href, s.title.replace(' — ', ''), englishSolvers.get(s.href)!.replace(' — ', ' ')]);
  }
  for (const {pattern, title, access, canonicalHref} of PLATFORM_ROUTES) {
    if (!pattern || pattern.includes(':')) continue;
    if (canonicalHref) {
      if (pattern.startsWith('shop/') && canonicalHref === '/' + pattern) {
        links.push([canonicalHref, title.zh, title.en]);
      }
      continue;
    }
    const admin = access === 'admin';
    links.push(['/platform/' + pattern, (admin ? '平台后台' : '') + title.zh, (admin ? 'Platform admin ' : '') + title.en]);
  }
  for (const {id, title} of F2L_NAV_CHAPTERS) {
    links.push(['/tutorial/f2l?step=' + id, 'F2L教程' + title.zh, 'F2L lesson ' + title.en]);
  }
  for (const [index, {title}] of LBL_STEPS.entries()) {
    links.push(['/tutorial/lbl?step=lesson-' + (index + 1), '层先法' + title.zh, 'LBL lesson ' + title.en]);
  }
  for (const {slug, href, title} of REG_ARTICLES) {
    links.push([href ?? '/regulation/' + slug, title.zh + '规则', title.en + ' regulations']);
  }
  for (const id of WCA_STAT_PAGE_IDS) {
    const entry = statistics.find(stat => stat.id === id);
    if (!entry?.titleZh || !entry.titleEn) throw new Error('Missing published statistic title for ' + id);
    links.push(['/wca/' + id, entry.titleZh, entry.titleEn]);
  }
  return links;
}

if (basename(process.argv[1] ?? '') === 'build-assistant-feature-links.mts') {
  const index = await fetchWcaStatIndex(AbortSignal.timeout(20000));
  const rows = assistantFeatureLinks(index.categories.flatMap(category => category.stats)).map(link => '  ' + JSON.stringify(link) + ',');
  const source = ['// Generated by client/scripts/build-assistant-feature-links.mts.',
    'export const ASSISTANT_FEATURE_LINKS: ReadonlyArray<readonly [string, string, string]> = [',
    ...rows, '];', ''].join('\n');
  writeFileSync(new URL('../../shared/src/site_assistant_feature_links.ts', import.meta.url), source);
}
