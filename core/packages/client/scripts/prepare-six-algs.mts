/** Review six-layer source data scraped with the existing SpeedCubeDB importer.
 * node --import tsx scripts/prepare-six-algs.mts <raw-directory> <output-directory>
 * Writes review artifacts only; never connects to a database.
 */
import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import { resolve } from 'node:path';
import assert from 'node:assert/strict';
import { Alg } from 'cubing/alg';
import { CubeData, parseAlgorithm } from '@cuberoot/visualcube';
import type { AlgFile, AlgCase, AlgEntry } from '@cuberoot/shared';

const [rawDir, outputDir] = process.argv.slice(2);
assert(rawDir && outputDir, 'Expected raw-directory and output-directory');
mkdirSync(outputDir, { recursive: true });
const colors = 'yogwrb'; // SpeedCubeDB source colour frame, not a UI override.
function state(alg: string) {
  const cube = new CubeData(6);
  for (const turn of parseAlgorithm(alg)) cube.turn(turn);
  return Object.values(cube.faces).map(face => face.map(n => colors[Math.floor((n - 1) / 36)]).join(''));
}
const isCenter = (i: number) => i >= 6 && i < 30 && i % 6 !== 0 && i % 6 !== 5;
const reviewed: AlgFile[] = [];
const audit: unknown[] = [];
for (const set of ['l2e', 'l2c']) {
  const raw = JSON.parse(readFileSync(resolve(rawDir, `alg_6x6_${set}.json`), 'utf8')) as AlgFile;
  assert.equal(raw.puzzle, '6x6');
  assert.equal(raw.source, `https://speedcubedb.com/a/6x6/6x6${set.toUpperCase()}`);
  assert.equal(new Date(raw.scrapedAt).toISOString(), raw.scrapedAt);
  assert.equal(raw.cases.length, set === 'l2c' ? 33 : 3);
  const cases: AlgCase[] = [];
  const knownStates = new Map<string, AlgCase>();
  for (const source of raw.cases) {
    const first = source.algs[0][0].alg;
    const setup = new Alg(first).invert().toString();
    const start = state(setup);
    assert.equal(source.sticker.kind, 'face');
    if (source.sticker.kind !== 'face') throw Error('Expected source face diagram');
    for (const [key, face] of Object.entries({ us: 0, ur: 1, uf: 2, ul: 4, ub: 5 })) {
      const expected = source.sticker[key as 'us'];
      assert.equal(expected.length, 36);
      [...expected].forEach((color, i) => {
        if (color !== 'l') assert.equal(start[face][i], color, `${source.name}: source diagram ${key}/${i}`);
      });
    }
    const key = start.map(face => [...face].filter((_, i) => set !== 'l2c' || isCenter(i)).join('')).join('/');
    const existing = knownStates.get(key);
    if (existing) {
      assert.deepEqual(source.algs.map(group => group.map(a => a.alg)), existing.algs.map(group => group.map(a => a.alg)));
      audit.push({ sourceName: source.name, mergedInto: existing.name, reason: 'Identical case state and algorithm' });
      continue;
    }
    const algs: AlgEntry[] = [];
    for (const entry of source.algs[0]) {
      const end = state(`${setup} ${entry.alg}`);
      end.forEach((face, f) => [...face].forEach((color, i) => {
        if (set !== 'l2c' || isCenter(i)) assert.equal(color, colors[f], `${source.name}/${entry.altId}: goal face ${f}/${i}`);
      }));
      // L2C ignores the outer U layer; discard an alternative differing only by a final U.
      const displayKey = entry.alg.replace(/(?:\s+U(?:2)?'?)+$/, '');
      if (set === 'l2c' && algs.some(a => a.alg.replace(/(?:\s+U(?:2)?'?)+$/, '') === displayKey)) {
        audit.push({ sourceName: source.name, altId: entry.altId, reason: 'Redundant finishing U alternative' });
        continue;
      }
      algs.push({ ...entry, source: 'speedcubedb' });
    }
    const item: AlgCase = { ...source, name: `${set.toUpperCase()} ${cases.length + 1}`, setup, algs: [algs] };
    cases.push(item);
    knownStates.set(key, item);
    audit.push({ name: item.name, sourceName: source.name, altIds: algs.map(a => a.altId) });
  }
  assert.equal(cases.length, set === 'l2c' ? 32 : 3);
  reviewed.push({ ...raw, cases });
}
assert.equal(reviewed.flatMap(s => s.cases).flatMap(c => c.algs.flat()).length, 40);
writeFileSync(resolve(outputDir, 'alg-6x6.json'), JSON.stringify(reviewed, null, 2) + '\n');
writeFileSync(resolve(outputDir, 'alg-6x6-audit.json'), JSON.stringify(audit, null, 2) + '\n');
const sql = ['-- Reviewed six-layer L2C/L2E. Generated by packages/client/scripts/prepare-six-algs.mts.',
  '-- Source figures were independently matched against simulated setups; see docs/alg-6x6-intake.md.',
  '-- Insert-only: preserve existing administrator edits on reapplication.'];
for (const file of reviewed) {
  sql.push(`INSERT INTO alg_sets (puzzle, set_slug, source, scraped_at) VALUES ('6x6', '${file.set}', '${file.source}', '${file.scrapedAt}') ON CONFLICT (puzzle, set_slug) DO NOTHING;`);
  const payload = file.cases.map((c, position) => ({ ...c, position }));
  sql.push(`WITH payload AS (SELECT $six_algs$${JSON.stringify(payload, null, 2)}$six_algs$::jsonb AS body),\nitems AS (SELECT value AS item FROM payload, jsonb_array_elements(body))\nINSERT INTO alg_cases (puzzle, set_slug, position, name, subgroup, setup, sticker, algs)\nSELECT '6x6', '${file.set}', (item->>'position')::integer, item->>'name', item->>'subgroup', item->>'setup', item->'sticker', item->'algs'\nFROM items WHERE NOT EXISTS (SELECT 1 FROM alg_cases WHERE puzzle = '6x6' AND set_slug = '${file.set}' AND name = item->>'name');`);
}
writeFileSync(resolve(outputDir, '0316_alg_6x6.sql'), sql.join('\n\n') + '\n');
console.log('Reviewed 32 L2C + 3 L2E cases, 40 algorithms; source diagrams and colour goals matched.');
