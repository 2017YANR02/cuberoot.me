<view class="page account-page">
  <text class="eyebrow">ACCOUNT</text>
  <text class="page-title">我的</text>

  <block wx:if="{{storageUnavailable && !loggedIn}}">
    <text class="page-intro account-intro">设备存储暂时不可用，当前无法确认登录状态。请重新读取后再继续。</text>
  </block>

  <block wx:elif="{{loggedIn}}">
    <view class="identity">
      <text class="identity-mark" aria-hidden="true">{{initial}}</text>
      <view class="identity-copy">
        <text class="identity-name">{{displayName}}</text>
        <text class="identity-wca" wx:if="{{wcaId}}">{{wcaId}}</text>
        <text class="identity-wca" wx:else>尚未绑定 WCA ID</text>
      </view>
    </view>

    <view class="account-sync">
      <view class="account-sync-heading">
        <text class="account-sync-title">跨端账号</text>
        <view
          class="account-sync-state account-sync-state--{{syncState}}"
          aria-role="status"
          aria-live="polite"
          aria-atomic="true"
          aria-busy="{{syncState === 'checking'}}"
        >
          <view class="account-sync-dot" aria-hidden="true"></view>
          <text>{{syncLabel}}</text>
        </view>
      </view>
      <text class="account-sync-copy">打开 CubeRoot 网站时，会用当前小程序账号安全登录。</text>
    </view>

    <button
      class="account-link"
      hover-class="press-feedback"
      bindtap="openAccount"
      aria-label="管理账号与登录方式，绑定 WCA 账号，查看其他登录方式"
    >
      <view class="account-link-copy">
        <text class="account-link-title">管理账号与登录方式</text>
        <text class="account-link-description">绑定 WCA 账号，查看其他登录方式</text>
      </view>
      <text class="account-link-arrow" aria-hidden="true">›</text>
    </button>

    <button class="text-button logout-button" hover-class="press-feedback" bindtap="logout">退出登录</button>
  </block>

  <block wx:else>
    <text class="page-intro account-intro">登录后使用与网站相同的 CubeRoot 账号。已在网站通过微信登录过时，会自动识别为同一账号。</text>
    <button
      class="primary-button login-button"
      hover-class="press-feedback"
      disabled="{{busy}}"
      bindtap="login"
      aria-busy="{{busy}}"
      aria-label="{{busy ? '微信登录处理中' : '微信登录'}}"
    >
      {{busy ? '登录中…' : '微信登录'}}
    </button>
    <text class="union-note">不会读取你的微信昵称或手机号。无法取得 UnionID 时会停止登录，避免创建重复账号。</text>
  </block>

  <text
    class="status-text {{statusError ? 'status-text--error' : ''}}"
    wx:if="{{status}}"
    aria-role="status"
    aria-live="polite"
    aria-atomic="true"
  >{{status}}</text>
  <text
    class="status-text status-text--error {{status ? 'account-action-status--stacked' : ''}}"
    wx:if="{{actionStatus}}"
    aria-role="status"
    aria-live="polite"
    aria-atomic="true"
  >{{actionStatus}}</text>
  <button
    class="text-button sync-retry-button"
    hover-class="press-feedback"
    wx:if="{{syncState === 'error'}}"
    bindtap="retrySync"
  >重新确认</button>
  <button class="text-button privacy-button" hover-class="press-feedback" bindtap="openPrivacy">隐私说明</button>
</view>
