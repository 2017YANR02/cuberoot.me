<view class="page tools-page">
  <text class="eyebrow">CUBEROOT</text>
  <text class="page-title">发现</text>
  <text class="page-intro">常用功能逐步原生化，其他内容先从网站打开。</text>

  <view class="tool-list">
    <button class="tool-row" data-key="alg" bindtap="openTool">
      <view>
        <text class="tool-name">公式库</text>
        <text class="tool-description">OLL、PLL、ZBLL 等公式查询与训练</text>
      </view>
      <text class="tool-arrow">›</text>
    </button>
    <button class="tool-row" data-key="competitions" bindtap="openTool">
      <view>
        <text class="tool-name">WCA 比赛</text>
        <text class="tool-description">查比赛、赛程与成绩</text>
      </view>
      <text class="tool-arrow">›</text>
    </button>
    <button class="tool-row" data-key="wiki" bindtap="openTool">
      <view>
        <text class="tool-name">魔方百科</text>
        <text class="tool-description">教程、术语与方法资料</text>
      </view>
      <text class="tool-arrow">›</text>
    </button>
    <button class="tool-row" data-key="courses" bindtap="openTool">
      <view>
        <text class="tool-name">课程</text>
        <text class="tool-description">系统学习与试学内容</text>
      </view>
      <text class="tool-arrow">›</text>
    </button>
  </view>
</view>
