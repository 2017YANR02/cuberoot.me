<view class="page tools-page">
  <text class="eyebrow">CUBEROOT</text>
  <text class="page-title">魔方工具</text>
  <text class="page-intro">直接使用 CubeRoot 已有功能，与网站保持同一套内容和更新。</text>

  <view class="tool-list">
    <button
      class="tool-row"
      wx:for="{{tools}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="openTool"
      hover-class="tool-row--pressed"
    >
      <view class="tool-copy">
        <text class="tool-name">{{item.title}}</text>
        <text class="tool-description">{{item.description}}</text>
      </view>
      <text class="tool-arrow">›</text>
    </button>
  </view>
</view>
