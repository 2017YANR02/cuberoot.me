{
  "name": "@cuberoot/event-icon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "cuberoot": {
    "kind": "library",
    "externalRuntime": {
      "react": "react-dom"
    },
    "runtime": {
      ".": "react-dom",
      "./event": "react-dom",
      "./maps": "runtime-neutral",
      "./svg/event/*.svg": "asset",
      "./svg/unofficial/*.svg": "asset",
      "./svg/puzzle/*.svg": "asset"
    }
  },
  "exports": {
    ".": "./src/index.tsx",
    "./event": "./src/event.tsx",
    "./maps": "./src/maps.ts",
    "./svg/event/*.svg": "./svg/event/*.svg",
    "./svg/unofficial/*.svg": "./svg/unofficial/*.svg",
    "./svg/puzzle/*.svg": "./svg/puzzle/*.svg"
  },
  "sideEffects": true,
  "scripts": {
    "generate": "node gen-svg-map.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
