{
  "name": "@cuberoot/vendor-sr-puzzlegen",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "cuberoot": {
    "kind": "library",
    "runtime": {
      ".": "browser",
      "./*": "mixed"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "~5.7.0"
  }
}
