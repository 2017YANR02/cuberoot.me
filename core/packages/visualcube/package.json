{
  "name": "@cuberoot/visualcube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "cuberoot": {
    "kind": "library",
    "runtime": {
      ".": "mixed",
      "./render": "runtime-neutral",
      "./svg": "mixed"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/preset.d.ts",
      "default": "./src/preset.ts"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "cuberoot-miniprogram": "./src/render.ts",
      "default": "./dist/render.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "dev:build": "pnpm run build",
    "build": "tsc -b && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "typecheck": "tsc -b",
    "build:ci": "pnpm run build"
  },
  "dependencies": {
    "@cuberoot/shared": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "~5.7.0"
  }
}
