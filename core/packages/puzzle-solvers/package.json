{
  "name": "@cuberoot/puzzle-solvers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "cuberoot": {
    "kind": "library",
    "runtime": {
      "./clock": "runtime-neutral",
      "./sq2": "runtime-neutral"
    }
  },
  "sideEffects": false,
  "exports": {
    "./clock": {
      "types": "./src/clock.ts",
      "node": "./dist/clock.js",
      "default": "./src/clock.ts"
    },
    "./sq2": {
      "types": "./src/sq2.ts",
      "node": "./dist/sq2.js",
      "default": "./src/sq2.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
