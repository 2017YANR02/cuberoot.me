{
  "name": "@cuberoot/app-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "cuberoot": {
    "kind": "library",
    "externalRuntime": {
      "lucide-react": "react-dom",
      "react": "react-dom",
      "@emoji-mart/data": "runtime-neutral",
      "@2017yanr02/continuous-corners": "react-dom"
    },
    "runtime": {
      ".": "react-dom",
      "./app.css": "asset",
      "./chat": "react-dom",
      "./chat.css": "asset",
      "./watch-cube": "runtime-neutral",
      "./watch-cube-scene": "mixed",
      "./watch-replay": "mixed"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./app.css": "./src/app.css",
    "./chat": "./src/chat/index.ts",
    "./chat.css": "./src/chat/chat.css",
    "./watch-cube": "./src/watch-cube.ts",
    "./watch-cube-scene": "./src/watch-cube-scene.ts",
    "./watch-replay": "./src/watch-replay.ts"
  },
  "sideEffects": true,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cuberoot/puzzle-solvers": "workspace:*",
    "@cuberoot/shared": "workspace:*",
    "@cuberoot/timer-ui": "workspace:*",
    "@emoji-mart/data": "1.2.1",
    "@2017yanr02/continuous-corners": "file:../../vendor/continuous-corners-0.3.1.tgz"
  },
  "peerDependencies": {
    "lucide-react": "1.8.0",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cubing": "^0.63.3",
    "fake-indexeddb": "^6.2.5",
    "lucide-react": "1.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
