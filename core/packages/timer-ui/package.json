{
  "name": "@cuberoot/timer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "cuberoot": {
    "kind": "library",
    "externalRuntime": {
      "flag-icons": "react-dom",
      "lucide-react": "react-dom",
      "react": "react-dom",
      "react-dom": "react-dom",
      "uqr": "react-dom"
    },
    "runtime": {
      ".": "react-dom",
      "./compact-select": "react-dom",
      "./compact-select.css": "react-dom",
      "./country-flag": "react-dom",
      "./country-flag.css": "react-dom",
      "./gesture-wheel.css": "react-dom",
      "./room-qr-modal": "react-dom",
      "./room-qr-modal.css": "react-dom",
      "./scramble-strip.css": "react-dom"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./compact-select": "./src/CompactSelect.tsx",
    "./compact-select.css": "./src/compact-select.css",
    "./country-flag": "./src/CountryFlag.tsx",
    "./country-flag.css": "./src/country-flag.css",
    "./gesture-wheel.css": "./src/gesture-wheel.css",
    "./room-qr-modal": "./src/RoomQrModal.tsx",
    "./room-qr-modal.css": "./src/room-qr-modal.css",
    "./scramble-strip.css": "./src/scramble-strip.css"
  },
  "sideEffects": true,
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cuberoot/event-icon": "workspace:*",
    "@cuberoot/puzzle-solvers": "workspace:*",
    "@cuberoot/shared": "workspace:*",
    "flag-icons": "^7.5.0",
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "lucide-react": "1.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "1.8.0",
    "react-dom": "19.2.4",
    "typescript": "^5"
  }
}
