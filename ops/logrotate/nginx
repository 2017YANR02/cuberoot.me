# Mira owns mira.fans logs in its separate policy; never overlap that rule.
/www/wwwlogs/*cuberoot.me*.log
/www/wwwlogs/127.0.0.1*.log
/www/wwwlogs/access.log
/www/wwwlogs/nginx_error.log
/www/wwwlogs/tcp-access.log
/www/wwwlogs/tcp-error.log {
    daily
    rotate 7
    maxage 7
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www www
    sharedscripts
    postrotate
        [ -f /www/server/nginx/logs/nginx.pid ] && kill -USR1 $(cat /www/server/nginx/logs/nginx.pid)
    endscript
}

# PM2 keeps these file descriptors open. copytruncate avoids restarting the API.
# maxsize is evaluated when the host's logrotate job runs, not a hard disk quota.
/root/.pm2/logs/core-api-out.log
/root/.pm2/logs/core-api-error.log {
    daily
    rotate 7
    maxage 7
    maxsize 100M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
