[Unit]
Description=Persist CubeRoot incident IP bans for 30 days
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /var/lib/cuberoot-vercel-bans/run.lock /root/.nvm/versions/node/v24.14.0/bin/node --experimental-strip-types /opt/cuberoot-vercel-bans/relay.ts
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cuberoot-vercel-bans
