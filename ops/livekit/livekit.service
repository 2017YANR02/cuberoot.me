[Unit]
Description=LiveKit SFU (video calls for /timer battle rooms)
After=network.target

[Service]
Type=simple
# API key/secret 从这里注入(LIVEKIT_KEYS="<key>: <secret>"),该文件不进仓库,
# 权限设 600。放 env 而不是写进 livekit.yaml,是为了让配置文件可以安全提交。
EnvironmentFile=/etc/livekit/livekit.env
ExecStart=/usr/local/bin/livekit-server --config /etc/livekit/livekit.yaml
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
# SFU 每个参与者要占若干 socket,默认 1024 在多房间时会撞上限。
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
