[Unit]
Description=CubeRoot traffic guard (self-hosted entry)
After=nginx.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/cuberoot/traffic-guard.env
ExecStart=/root/.nvm/versions/node/v24.14.0/bin/node --experimental-strip-types /usr/local/lib/cuberoot/traffic-guard.ts --apply
TimeoutStartSec=45
