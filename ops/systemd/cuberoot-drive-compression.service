[Unit]
Description=CubeRoot Drive video compression
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/root/core-api
ExecStart=/usr/bin/env node --env-file=/root/core-api/.env /root/core-api/dist/drive-video.mjs
Environment=NODE_ENV=production
Environment=OMP_NUM_THREADS=4
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=20
Nice=15
CPUQuota=400%
MemoryMax=4G
# SVT's helper threads share this limit with Node; CPU use stays capped above.
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/core-api/.drive-storage
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
