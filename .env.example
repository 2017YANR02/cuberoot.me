# 管理后台密码,生产必改
ADMIN_PASSWORD=admin123

# HMAC 签名密钥,用于 admin / user cookie 签名,生产必设强随机
SESSION_SECRET=change-me

# 站点对外 URL,影响 sitemap / OG / 邀请链接
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# SQLite 文件路径,docker 内默认 /data/data.db
# DB_PATH=./data.db

# Stripe 测试模式 (https://dashboard.stripe.com/test/apikeys)
# 留空则禁用 Stripe 通道,只保留 mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 微信支付 V3 (P2 - 留空禁用)
WECHAT_MCHID=
WECHAT_APIV3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_SERIAL_NO=
WECHAT_APPID=

# 支付宝 (P2 - 留空禁用)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 短信通道 (留空 / 无效则 console fallback,仅打 server log)
# 可选值: console / aliyun / tencent
SMS_PROVIDER=

# 阿里云短信
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=

# 腾讯云短信
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_SDK_APP_ID=
SMS_TENCENT_SIGN_NAME=
SMS_TENCENT_TEMPLATE_ID=
SMS_TENCENT_REGION=ap-guangzhou

# 文件存储 (留空走 local: 写到 public/uploads/)
# 可选值: local / r2 / s3 / oss / cos
STORAGE_PROVIDER=

# Cloudflare R2
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_BUCKET=
STORAGE_R2_PUBLIC_BASE=

# AWS S3 / S3-compatible
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_PUBLIC_BASE=

# 阿里云 OSS
STORAGE_OSS_ACCESS_KEY_ID=
STORAGE_OSS_ACCESS_KEY_SECRET=
STORAGE_OSS_BUCKET=
STORAGE_OSS_REGION=
STORAGE_OSS_PUBLIC_BASE=

# 腾讯云 COS
STORAGE_COS_SECRET_ID=
STORAGE_COS_SECRET_KEY=
STORAGE_COS_BUCKET=
STORAGE_COS_REGION=
STORAGE_COS_PUBLIC_BASE=
