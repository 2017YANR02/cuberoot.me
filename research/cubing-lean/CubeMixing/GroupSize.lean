module

public import CubeMixing.OrderWitnesses
public import Mathlib.Data.List.Nodup
public import Mathlib.SetTheory.Cardinal.Finite

/-! Lower bounds on the group generated by the six physical quarter turns.
A row gives words that fix all previously chosen stickers and send one
more sticker to mutually distinct locations. The product of the row sizes
counts distinct elements, without assuming completeness of the chain. -/

@[expose] public section

namespace CubeMixing.OrderCheck

abbrev Witness := {c : Nat // Certified c}
abbrev Rows := List (Sticker × List Witness)

def checkRows (image : Witness → Sticker → Sticker) (fixed : List Sticker) : Rows → Bool
  | [] => true
  | (b,ids)::rs =>
    decide (ids.map (fun j => image j b)).Nodup &&
    ids.all (fun j => fixed.all (fun a => image j a == a)) &&
    checkRows image (b::fixed) rs

private def Choices : Rows → Type
  | [] => Unit
  | (_,ids)::rs => Fin ids.length × Choices rs

private def compose (get : Witness → faceGroup) : (rs : Rows) → Choices rs → faceGroup
  | [], _ => 1
  | (_,ids)::rs, (i,t) => get (ids.get i) * compose get rs t

private theorem choices_card (rs : Rows) :
    Nat.card (Choices rs) = (rs.map (fun r => r.2.length)).prod := by
  induction rs with
  | nil => simp [Choices]
  | cons row rs ih =>
    rcases row with ⟨b,ids⟩
    simp [Choices,Nat.card_prod,ih]

private theorem row_properties (get : Witness → faceGroup) (image : Witness → Sticker → Sticker)
    (correct : ∀ j x, ((get j).val) x = image j x) (fixed : List Sticker)
    (rs : Rows) (ok : checkRows image fixed rs = true) :
    Function.Injective (compose get rs) ∧
      ∀ (x : Choices rs) a, a ∈ fixed → (compose get rs x).val a = a := by
  induction rs generalizing fixed with
  | nil =>
    constructor
    · rintro ⟨⟩ ⟨⟩ _; rfl
    · intro x a ha; rfl
  | cons row rs ih =>
    rcases row with ⟨b,ids⟩
    simp only [checkRows,Bool.and_eq_true,decide_eq_true_eq,List.all_eq_true,beq_iff_eq] at ok
    obtain ⟨⟨distinct,fix⟩,rest⟩ := ok
    obtain ⟨inj,still⟩ := ih (b::fixed) rest
    have atBase (i : Fin ids.length) (u : Choices rs) :
        (compose get ((b,ids)::rs) (i,u)).val b = image (ids.get i) b := by
      change (get (ids.get i)).val ((compose get rs u).val b) = _
      rw [still u b (by simp),correct]
    constructor
    · rintro ⟨i,u⟩ ⟨j,v⟩ he
      have same := congrArg (fun g : faceGroup => g.val b) he
      change (compose get ((b,ids)::rs) (i,u)).val b =
        (compose get ((b,ids)::rs) (j,v)).val b at same
      rw [atBase,atBase] at same
      have idx : i = j := by
        apply Fin.ext
        let i' : Fin (ids.map (fun u => image u b)).length := ⟨i, by simp⟩
        let j' : Fin (ids.map (fun u => image u b)).length := ⟨j, by simp⟩
        have e : i' = j' := (List.nodup_iff_injective_getElem.mp distinct) (a₁ := i') (a₂ := j')
          (by simpa [i',j'] using same)
        exact (congrArg (fun z : Fin (ids.map (fun u => image u b)).length => z.val) e)
      subst j
      exact Prod.ext rfl (inj (mul_left_cancel he))
    · rintro ⟨i,t⟩ a ha
      change (get (ids.get i)).val ((compose get rs t).val a) = a
      rw [still t a (by simp [ha]),correct]
      exact fix _ (List.get_mem ..) a ha

theorem bound_of_checked (get : Witness → faceGroup) (image : Witness → Sticker → Sticker)
    (correct : ∀ j x, (get j).val x = image j x) (rows : Rows)
    (ok : checkRows image [] rows = true) :
    (rows.map (fun r => r.2.length)).prod ≤ Nat.card faceGroup := by
  rw [← choices_card]
  exact Nat.card_le_card_of_injective _ (row_properties get image correct [] rows ok).1

open OrderWitnesses

set_option maxRecDepth 10000 in
set_option maxHeartbeats 3000000 in
private theorem rows_ok : checkRows (fun j => digit j.val) [] rowWitnesses = true := by decide +kernel

private theorem certificate_size :
    (rowWitnesses.map (fun r => r.2.length)).prod = 43252003274489856000 := by decide +kernel

/-- The subgroup generated by actual face turns has at least this many
elements. Each factor in the product is certified inside the subgroup. -/
theorem faceGroup_card_lower : 43252003274489856000 ≤ Nat.card faceGroup := by
  rw [← certificate_size]
  exact bound_of_checked (fun j => j.property.choose) (fun j => digit j.val)
    (fun j => j.property.choose_spec) rowWitnesses rows_ok

end CubeMixing.OrderCheck
