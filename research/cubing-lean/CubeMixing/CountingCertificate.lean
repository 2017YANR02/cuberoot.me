    #[725505917042688, 72265315786752, 6572540583936, 541809682432, 40080457728, 2623817728, 149055488, 7129600, 273920, 7680, 128],
    #[14993278820352, 1224478236672, 89634682880, 5799208960, 325089280, 15316992, 578048, 15872, 256],
    #[200252940288, 12803497984, 708216832, 32868352, 1218560, 32768, 512],
    #[1541140480, 70451200, 2566144, 67584, 1024],
    #[5398528, 139264, 2048],
    #[4096]]]
def pathCount (t a b : Nat) : Nat :=
  if a + 2*b ≤ t then
    let row := certificate[t]?.getD #[]
    let values := row[b]?.getD #[]
    values[a]?.getD 0
  else 0

def singleSum (t a b : Nat) : Nat :=
  pathCount t a b + 2 * pathCount t (a+1) b +
    3 * pathCount t a (b+1) + 12 * pathCount t (a+2) b

def doubleSum (t a b : Nat) : Nat :=
  2 * pathCount t (a+1) b + 4 * pathCount t a (b+1) +
    12 * pathCount t (a+1) (b+1)

private theorem empty_table :
    ∀ t : Fin 24, pathCount (t.val+1) 0 0 = 18 * pathCount t.val 1 0 := by
  decide +kernel

private theorem single_table :
    ∀ (t : Fin 24) (a b : Fin 25),
      pathCount (t.val+1) (a.val+1) b.val = singleSum t.val a.val b.val := by
  decide +kernel

private theorem double_table :
    ∀ (t : Fin 24) (a b : Fin 25),
      pathCount (t.val+1) a.val (b.val+1) = doubleSum t.val a.val b.val := by
  decide +kernel

theorem pathCount_initial (a b : Nat) :
    pathCount 0 a b = if a = 0 ∧ b = 0 then 1 else 0 := by
  by_cases h : a = 0 ∧ b = 0
  · obtain ⟨rfl, rfl⟩ := h
    decide +kernel
  · simp [pathCount, show ¬a + 2 * b ≤ 0 by omega, h]

theorem pathCount_empty (t : Nat) (ht : t < 24) :
    pathCount (t+1) 0 0 = 18 * pathCount t 1 0 := empty_table ⟨t, ht⟩

theorem pathCount_single (t a b : Nat) (ht : t < 24) :
    pathCount (t+1) (a+1) b = singleSum t a b := by
  by_cases h : a < 25 ∧ b < 25
  · exact single_table ⟨t, ht⟩ ⟨a,h.1⟩ ⟨b,h.2⟩
  · simp [singleSum, pathCount, show ¬(a + 1 + 2 * b ≤ t + 1) by omega,
      show ¬(a + 2*b ≤ t) by omega, show ¬(a+1 + 2*b ≤ t) by omega,
      show ¬(a + 2*(b+1) ≤ t) by omega, show ¬(a+2 + 2*b ≤ t) by omega]

theorem pathCount_double (t a b : Nat) (ht : t < 24) :
    pathCount (t+1) a (b+1) = doubleSum t a b := by
  by_cases h : a < 25 ∧ b < 25
  · exact double_table ⟨t, ht⟩ ⟨a,h.1⟩ ⟨b,h.2⟩
  · simp [doubleSum, pathCount, show ¬(a + 2 * (b+1) ≤ t + 1) by omega,
      show ¬(a+1 + 2*b ≤ t) by omega, show ¬(a + 2*(b+1) ≤ t) by omega,
      show ¬(a+1 + 2*(b+1) ≤ t) by omega]

end CubeMixing
